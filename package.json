    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "node-html-parser": "^9.0.4",
