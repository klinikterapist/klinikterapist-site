---
/**
 * "Eğitimler ve Sertifikalar" (owner's review 2026-10-22): two counters (theory and practice hours, the sum of every card,
 * rounded down with a "+"), the owner's short note, then the groups (Lisans, Yüksek lisans, Sertifika…). A card with lines
 * opens like an FAQ box (native <details>, no JavaScript) to list its courses and their hours.
 */
import type { About, Lang } from '../lib/settings';
import { educationTotals, formatNumber } from '../lib/education';
import Icon from './Icon.astro';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  education: NonNullable<About['education']>;
  /** 'summary': the counters and the note only; 'groups': the cards only. */
  part?: 'all' | 'summary' | 'groups';
}
const { lang, education, part = 'all' } = Astro.props;

const num = (n: number) => formatNumber(n, lang);
const { theory, practice } = educationTotals(education);
const hours = (key: 'hoursTheory' | 'hoursPractice', n?: number) => (n ? t(lang, key).replace('{n}', num(n)) : '');
const intro = education.intro[lang].trim();
---

<div class="ledger">
  {
    part !== 'groups' && (
      <div class="counters">
        <div class="counter counter--theory">
          <small>{t(lang, 'theoryTraining')}</small>
          <b>
            {num(theory)}+ <span>{t(lang, 'hoursUnit')}</span>
          </b>
          <p>{t(lang, 'theoryTrainingHint')}</p>
        </div>
        <div class="counter counter--practice">
          <small>{t(lang, 'practiceTraining')}</small>
          <b>
            {num(practice)}+ <span>{t(lang, 'hoursUnit')}</span>
          </b>
          <p>{t(lang, 'practiceTrainingHint')}</p>
        </div>
      </div>
    )
  }

  {part !== 'groups' && intro && <p class="intro">{intro}</p>}

  {
    part !== 'summary' && education.groups.map((g) => (
      <section class:list={['group', `group--${g.kind}`]}>
        <h3 class="group-title">
          <span class="swatch" aria-hidden="true" />
          {g.title[lang]}
        </h3>
        {g.items.map((item) => {
          const head = (
            <>
              <span class="row">
                <b class="name">{item.title[lang]}</b>
                {item.badge[lang] && <span class="badge">{item.badge[lang]}</span>}
              </span>
              {item.meta[lang] && <span class="meta">{item.meta[lang]}</span>}
              {item.text[lang] && <span class="text">{item.text[lang]}</span>}
            </>
          );
          return item.lines.length > 0 ? (
            <details class="card card--open">
              <summary>
                <span class="head">{head}</span>
                <span class="chv" aria-hidden="true">
                  <Icon name="chevron" size={18} />
                </span>
              </summary>
              <div class="lines">
                {item.note[lang] && <p class="note">{item.note[lang]}</p>}
                {item.lines.map((l) =>
                  l.heading ? (
                    <p class="line-heading">{l.heading[lang]}</p>
                  ) : (
                    <p class="line">
                      <span>{l.title?.[lang]}</span>
                      <span class="line-hours">
                        {l.theory ? <span class="th">{hours('hoursTheory', l.theory)}</span> : null}
                        {l.practice ? <span class="pr">{hours('hoursPractice', l.practice)}</span> : null}
                      </span>
                    </p>
                  ),
                )}
              </div>
            </details>
          ) : (
            <div class="card">
              <span class="head">{head}</span>
            </div>
          );
        })}
      </section>
    ))
  }
</div>

<style>
  .counters {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .counter {
    padding: var(--space-4);
    border-radius: var(--radius-md);
  }

  .counter--theory {
    background: var(--tone-lacivert-bg);
    color: var(--tone-lacivert);
  }

  .counter--practice {
    background: var(--tone-adacayi-bg);
    color: var(--tone-adacayi);
  }

  .counter small {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .counter b {
    display: block;
    margin: 2px 0;
    font-family: var(--font-serif);
    font-size: clamp(1.75rem, 1.4rem + 1.4vw, 2.25rem);
    font-weight: 600;
    line-height: 1.1;
  }

  .counter b span {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .counter p {
    margin: 0;
    font-size: var(--text-xs);
    line-height: 1.4;
  }

  .intro {
    margin: 0 0 var(--space-6);
    padding: 2px 0 2px var(--space-4);
    border-left: 3px solid var(--sun-disc);
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .group {
    margin-bottom: var(--space-6);
  }

  .group:last-child {
    margin-bottom: 0;
  }

  .group-title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-3);
    padding-bottom: 6px;
    border-bottom: 2px solid var(--line);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    background: var(--tone-lacivert);
  }

  .group--certificate .swatch {
    background: var(--sun-disc);
  }

  .group--supervision .swatch,
  .group--practice .swatch {
    background: var(--tone-adacayi);
  }

  .group--workshop .swatch {
    background: var(--tone-deniz);
  }

  .group--congress .swatch {
    background: var(--tone-kiremit);
  }

  .card {
    display: block;
    margin-bottom: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface) 35%, transparent);
  }

  .card:last-child {
    margin-bottom: 0;
  }

  .card > .head,
  summary {
    padding: 12px 16px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .name {
    font-weight: 700;
  }

  .badge {
    flex: none;
    font-family: var(--font-serif);
    font-weight: 600;
    white-space: nowrap;
  }

  .meta {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .text {
    margin-top: 2px;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  /* The opening card: tap anywhere, like the FAQ boxes; the round chevron turns when open. */
  .card--open {
    transition:
      background 0.2s,
      border-color 0.2s;
  }

  summary {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    border-radius: var(--radius-md);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .chv {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--link);
    transform: rotate(90deg);
    transition:
      transform 0.25s,
      background 0.2s;
  }

  .card--open:hover {
    border-color: color-mix(in srgb, var(--text) 25%, transparent);
  }

  .card--open:hover .chv {
    background: var(--tone-lacivert-bg);
  }

  .card--open[open] {
    border-color: transparent;
    background: var(--surface);
  }

  .card--open[open] .chv {
    background: var(--bg);
    transform: rotate(-90deg);
  }

  .lines {
    padding: 0 16px 14px;
  }

  .note {
    margin: 0 0 6px;
    color: var(--muted);
    font-size: var(--text-xs);
    font-style: italic;
  }

  .line-heading {
    margin: 12px 0 2px;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .line {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin: 0;
    padding: 6px 0;
    border-top: 1px solid var(--line);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .line-hours {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex: none;
    font-size: var(--text-xs);
    white-space: nowrap;
  }

  .th {
    color: var(--tone-lacivert);
  }

  .pr {
    color: var(--tone-adacayi);
  }

  /* Phones: the ledger sits inside an accordion, so the counters and the note get smaller. */
  @media (max-width: 767px) {
    .counters {
      gap: var(--space-2);
    }

    .counter {
      padding: 12px;
    }

    .counter small {
      font-size: 0.625rem;
      letter-spacing: 0.03em;
    }

    .counter b {
      font-size: 1.625rem;
    }

    .counter b span {
      font-size: var(--text-xs);
    }

    .intro {
      margin-bottom: var(--space-5);
      padding-left: var(--space-3);
      font-size: 1rem;
    }

    .group-title {
      font-size: 1.125rem;
    }

    .card > .head,
    summary {
      padding: 10px 12px;
    }

    summary {
      gap: var(--space-2);
    }

    .lines {
      padding: 0 12px 12px;
    }

    .row {
      flex-wrap: wrap;
      gap: 0 var(--space-2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card--open,
    .chv {
      transition: none;
    }
  }
</style>
