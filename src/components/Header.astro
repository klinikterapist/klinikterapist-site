---
/**
 * Desktop site header (spec §5.7): sun with name and title, the main menu, the three-way theme
 * switch, the language switch and "Randevu Al". Phones (< 768 px) use the TopBar instead, so this
 * header is hidden there and there is no menu button.
 */
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';
import SunMark from './brand/SunMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  alternatePaths: { tr: string; en: string };
}
const { lang, alternatePaths } = Astro.props;
const profile = getProfile();
const home = pathFor('home', lang);
const blog = pathFor('blog', lang);

const NAV: [string, UiKey][] = [
  [pathFor('about', lang), 'navAbout'],
  [blog, 'navBlog'],
  [pathFor('resources', lang), 'navResources'],
  [pathFor('faq', lang), 'navFaq'],
  [pathFor('contact', lang), 'navContact'],
];
const current = Astro.url.pathname;
const items = NAV.map(([href, label]) => {
  // `page` only on the exact page; inside the blog (posts, categories) Blog is marked as the current section.
  const ariaCurrent: 'page' | 'true' | undefined = current === href ? 'page' : href === blog && current.startsWith(href) ? 'true' : undefined;
  return { href, label: t(lang, label), ariaCurrent };
});
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <SunMark size={40} />
      <span class="brand-text">
        <span class="brand-name">{profile.name}</span>
        <span class="brand-title">{profile.title[lang]}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t(lang, 'mainNav')}>
      <ul>
        {items.map((i) => <li><a href={i.href} aria-current={i.ariaCurrent}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <ThemeToggle lang={lang} variant="segmented" />
      <LangSwitch lang={lang} alternatePaths={alternatePaths} />
      <a class="btn book" href={pathFor('appointment', lang)}>{t(lang, 'bookSession')}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    display: none;
    position: relative;
    z-index: 10;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }

  @media (min-width: 768px) {
    .site-header {
      display: block;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-5);
    min-height: 72px;
    padding-block: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.1;
  }

  .brand-title {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-2);
    color: var(--muted);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--link);
  }

  .nav a[aria-current] {
    color: var(--link);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* Icons only in the bar; the words stay as the buttons' accessible names. */
  .tools :global(.theme-segmented button) {
    padding: 0 10px;
  }

  .tools :global(.theme-segmented button span) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .book {
    padding-inline: 18px;
  }

  /* Tablets: the menu takes its own row under the brand and tools. */
  @media (max-width: 1099px) {
    .nav {
      order: 3;
      width: 100%;
    }
  }

  @media (min-width: 1100px) {
    .nav {
      margin-left: auto;
    }

    .tools {
      margin-left: 0;
    }
  }
</style>
