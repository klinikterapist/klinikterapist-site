---
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import { pathFor, type PageKey } from '../i18n/routes';
import { t, type UiKey } from '../i18n/ui';
import Leaf from './Leaf.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  alternatePaths: { tr: string; en: string };
}
const { lang, alternatePaths } = Astro.props;
const profile = getProfile();
const home = pathFor('home', lang);

const NAV: [PageKey, UiKey][] = [
  ['about', 'navAbout'],
  ['blog', 'navBlog'],
  ['resources', 'navResources'],
  ['contact', 'navContact'],
];
const current = Astro.url.pathname;
const items = NAV.map(([key, label]) => {
  const href = pathFor(key, lang);
  return { href, label: t(lang, label), active: current === href || (key === 'blog' && current.startsWith(href)) };
});
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <Leaf size={28} class="brand-leaf" />
      <span class="brand-text">
        <span class="brand-name">{profile.name}</span>
        <span class="brand-title">{profile.title[lang]}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t(lang, 'mainNav')}>
      <ul class="nav-inline">
        {items.map((i) => <li><a href={i.href} aria-current={i.active ? 'page' : undefined}>{i.label}</a></li>)}
      </ul>
      <details class="nav-menu">
        <summary aria-label={t(lang, 'menu')}>
          <svg class="icon-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="icon-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </summary>
        <ul class="nav-panel">
          <li><a href={home} aria-current={current === home ? 'page' : undefined}>{t(lang, 'navHome')}</a></li>
          {items.map((i) => <li><a href={i.href} aria-current={i.active ? 'page' : undefined}>{i.label}</a></li>)}
        </ul>
      </details>
    </nav>

    <div class="actions">
      <LangSwitch lang={lang} alternatePaths={alternatePaths} />
      <a class="btn book" href={pathFor('appointment', lang)}>{t(lang, 'bookSession')}</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    background: var(--cream);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 72px;
    padding-block: var(--space-3);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }

  .brand :global(.brand-leaf) {
    flex: none;
    color: var(--forest);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.15;
  }

  .brand-title {
    margin-top: 2px;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    order: 2;
  }

  .book {
    padding-inline: var(--space-4);
    font-size: 0.875rem;
  }

  .nav {
    order: 3;
  }

  /* Phones and tablets: disclosure menu (works without JavaScript). */
  .nav-inline {
    display: none;
  }

  .nav-menu summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .nav-menu summary::-webkit-details-marker {
    display: none;
  }

  .nav-menu summary:hover {
    background: var(--sage-soft);
  }

  .nav-menu .icon-close,
  .nav-menu[open] .icon-open {
    display: none;
  }

  .nav-menu[open] .icon-close {
    display: block;
  }

  .nav-panel {
    position: absolute;
    top: 100%;
    left: var(--gutter);
    right: var(--gutter);
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
  }

  .nav-panel a {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    color: var(--ink);
    font-size: var(--text-base);
    text-decoration: none;
  }

  .nav-panel a:hover,
  .nav-panel a[aria-current='page'] {
    background: var(--sage-soft);
    color: var(--forest);
  }

  /* Very narrow phones: the name may wrap to two lines, the actions never do. */
  @media (max-width: 380px) {
    .brand-name {
      font-size: 0.9375rem;
    }

    .brand-title {
      letter-spacing: 0.14em;
    }

    .book {
      padding-inline: var(--space-3);
    }
  }

  /* Desktop: inline navigation, no menu button. */
  @media (min-width: 1024px) {
    .bar {
      gap: var(--space-4);
      min-height: 88px;
    }

    .brand-text {
      margin-left: var(--space-1);
    }

    .brand-name {
      font-size: 1.25rem;
    }

    .nav {
      order: 1;
    }

    .nav-menu {
      display: none;
    }

    .nav-inline {
      display: flex;
      gap: var(--space-1);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .nav-inline a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding: 0 var(--space-3);
      border-radius: var(--radius-pill);
      color: var(--ink);
      font-size: var(--text-sm);
      font-weight: 500;
      text-decoration: none;
    }

    .nav-inline a:hover {
      color: var(--forest);
      background: var(--sage-soft);
    }

    .nav-inline a[aria-current='page'] {
      color: var(--forest);
      text-decoration: underline;
      text-decoration-thickness: 2px;
      text-underline-offset: 0.45em;
    }
  }
</style>
