---
/**
 * Desktop site header (spec §5.7): sun with name and title, the main menu, the three-way theme
 * switch, the language switch and "Randevu Al". Phones (< 768 px) use the TopBar instead, so this
 * header is hidden there and there is no menu button.
 */
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { bookHref, bookingClosed } from '../lib/booking-intake';
import { t, type UiKey } from '../i18n/ui';
import SunMark from './brand/SunMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';

interface Props {
  lang: Lang;
  alternatePaths: { tr: string; en: string };
}
const { lang, alternatePaths } = Astro.props;
const profile = getProfile();
const home = pathFor('home', lang);
const blog = pathFor('blog', lang);

const NAV: [string, UiKey][] = [
  [pathFor('about', lang), 'navAbout'],
  [blog, 'navBlog'],
  [pathFor('resources', lang), 'navResources'],
  [pathFor('faq', lang), 'navFaq'],
  [pathFor('contact', lang), 'navContact'],
];
const current = Astro.url.pathname;
const items = NAV.map(([href, label]) => {
  // `page` only on the exact page; inside the blog (posts, categories) Blog is marked as the current section.
  const ariaCurrent: 'page' | 'true' | undefined = current === href ? 'page' : href === blog && current.startsWith(href) ? 'true' : undefined;
  return { href, label: t(lang, label), ariaCurrent };
});
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={home}>
      <SunMark size={40} />
      <span class="brand-text">
        <span class="brand-name">{profile.name}</span>
        <span class="brand-title">{profile.title[lang]}</span>
      </span>
    </a>

    <nav class="nav" aria-label={t(lang, 'mainNav')}>
      <ul>
        {items.map((i) => <li><a href={i.href} aria-current={i.ariaCurrent}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div class="tools">
      <ThemeToggle lang={lang} variant="segmented" />
      <LangSwitch lang={lang} alternatePaths={alternatePaths} />
      {
        bookingClosed(lang) ? (
          <a class="book is-closed" href={bookHref(lang)} aria-label={`${t(lang, 'bookSession')}: ${t(lang, 'bookingClosed')}`} title={t(lang, 'bookingClosed')}>
            {t(lang, 'bookSession')}
          </a>
        ) : (
          <a class="btn book" href={bookHref(lang)}>{t(lang, 'bookSession')}</a>
        )
      }
    </div>
  </div>
</header>

<style>
  /* Owner's choice C (2026-10-23): one floating row. Brand, menu and tools sit in a rounded strip that
     stays at the top while the page scrolls, with the page faintly showing through behind it. */
  .site-header {
    display: none;
    position: sticky;
    top: 0;
    z-index: 10;
    padding-block: var(--space-3);
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .site-header {
      display: block;
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    min-height: 64px;
    padding: 8px 10px 8px 18px;
    border: 1px solid var(--line);
    border-radius: 22px;
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.04), 0 6px 20px rgb(0 0 0 / 0.07);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    pointer-events: auto;
  }

  /* The strip keeps the page's column: the container's gutter becomes the space around it. */
  .site-header > .bar {
    width: calc(100% - 2 * var(--gutter));
    max-width: var(--max-wide);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.1;
  }

  /* "KLİNİK PSİKOLOG": small capitals again (owner's review 2026-10-19; the page language makes the İ). */
  .brand-title {
    margin-top: 3px;
    color: var(--muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .nav {
    --nav-pad: 14px;
  }

  @media (max-width: 1299px) {
    .nav {
      --nav-pad: 10px;
    }
  }

  .nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--nav-pad, 14px);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* The sun-yellow line under a name: on hover, and under the page you are on. */
  .nav a::after {
    content: '';
    position: absolute;
    right: var(--nav-pad, 14px);
    bottom: 6px;
    left: var(--nav-pad, 14px);
    height: 2px;
    border-radius: 2px;
    background: var(--sun-disc);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .nav a:hover {
    color: var(--text);
  }

  .nav a:hover::after,
  .nav a[aria-current]::after {
    transform: scaleX(1);
  }

  .nav a[aria-current] {
    color: var(--text);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav a::after {
      transition: none;
    }
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  /* Icons only in the bar; the words stay as the buttons' accessible names. */
  .tools :global(.theme-segmented button) {
    padding: 0 10px;
  }

  .tools :global(.theme-segmented button span) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  .book {
    padding-inline: 18px;
  }

  /* Booking closed in this language (Ayarlar › Önemli Ayarlar): muted, still a link to the page that says so. */
  .book.is-closed {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    border: 1.5px dashed color-mix(in srgb, var(--muted) 60%, transparent);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  /* Tablets: the menu takes its own row under the brand and tools. */
  @media (max-width: 1199px) {
    .nav {
      order: 3;
      width: 100%;
    }
  }

  @media (min-width: 1200px) {
    .nav {
      margin-inline: auto;
    }

    /* Brand, menu and tools share one row; on narrower desktops the names sit a little closer. */
    .nav ul {
      gap: 0;
    }

    .tools {
      margin-left: 0;
    }
  }
</style>
