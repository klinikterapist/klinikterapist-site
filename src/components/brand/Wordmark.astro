---
/**
 * The klinikterapist wordmark, traced from the owner's logo file
 * (`node scripts/brand-icons.mjs --wordmark`). One colour: it takes the text colour.
 */
interface Props {
  /** Height in px; the width follows the logo's proportions. */
  height?: number;
  /** Beside text that already names the site: hidden from screen readers instead of labelled. */
  decorative?: boolean;
}
