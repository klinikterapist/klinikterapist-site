---
/**
 * The post's Kaynakça / References (spec §5.8): only the cited references, APA-sorted, inside an
 * accordion that starts closed on every screen (owner's review 2026-10-18); a native <details>, so it
 * opens without JavaScript too. Nothing when none is cited.
 */
import type { Reference } from '../lib/apa';
import { citedIds, referenceItemsHtml } from '../lib/citations';
import type { Lang } from '../lib/schemas';
import { t, tCount } from '../i18n/ui';
import Accordion from './ui/Accordion.astro';

interface Props {
  references: Reference[];
  body: string;
  lang: Lang;
}
const { references, body, lang } = Astro.props;
const items = referenceItemsHtml(references, citedIds(body), lang);
const count = tCount(lang, 'referencesOne', 'referencesMany', items.length);
---

{
  items.length > 0 && (
    <section class="references" aria-label={t(lang, 'references')}>
      <Accordion class="refs" icon="list" title={t(lang, 'references')} subtitle={count}>
        <ol class="references-list" set:html={items.join('')} />
      </Accordion>
    </section>
  )
}
