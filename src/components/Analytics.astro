---
/**
 * Google Analytics 4 behind a cookie notice (owner's review 2026-10-19, item 4). Nothing renders
 * while seo.json has no `gaId`. With one, Google's script loads only after the visitor presses
 * "Kabul ediyorum"; "Reddediyorum" keeps the site cookie-free. The choice is kept in this browser
 * (`kt.consent`) and can be changed from any `[data-cookie-prefs]` button (the footer link).
 * Skipped for bots and for the owner's own browser (`kt.noTrack`, set by the panel).
 */
import type { Lang } from '../lib/settings';
import { getSeo } from '../lib/settings';
import { pathFor } from '../i18n/routes';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const { gaId } = getSeo();
const T = {
  tr: {
    text: 'Sitenin nasıl kullanıldığını anlayıp geliştirebilmem için, izin verirseniz Google Analytics çerezleri kullanılır. Reddederseniz hiçbir çerez yerleştirilmez.',
    more: 'Ayrıntılar',
    accept: 'Kabul ediyorum',
    reject: 'Reddediyorum',
    label: 'Çerez tercihi',
  },
  en: {
    text: 'If you allow it, Google Analytics cookies help me understand how the site is used and improve it. If you decline, no cookies are set.',
    more: 'Details',
    accept: 'Accept',
    reject: 'Decline',
    label: 'Cookie choice',
  },
}[lang];
---

{
  gaId && (
    <>
      <div class="consent-bar" data-consent-bar role="dialog" aria-label={T.label} hidden>
        <p>
          {T.text} <a href={pathFor('privacyPolicy', lang)}>{T.more}</a>
        </p>
        <div class="consent-actions">
          <button type="button" class="c-reject" data-consent="denied">{T.reject}</button>
          <button type="button" class="c-accept" data-consent="granted">{T.accept}</button>
        </div>
      </div>
      <script is:inline define:vars={{ id: gaId }}>
        (function () {
          var KEY = 'kt.consent';
          var bar = document.querySelector('[data-consent-bar]');
          var get = function () { try { return localStorage.getItem(KEY); } catch (e) { return null; } };
          var set = function (v) { try { localStorage.setItem(KEY, v); } catch (e) {} };
          var skip = false;
          try { skip = navigator.webdriver || /bot|crawl|spider|preview|lighthouse/i.test(navigator.userAgent) || localStorage.getItem('kt.noTrack') === '1'; } catch (e) {}
          var loaded = false;
          function load() {
            if (loaded || skip) return;
            loaded = true;
            window.dataLayer = window.dataLayer || [];
            window.gtag = function () { window.dataLayer.push(arguments); };
            window.gtag('js', new Date());
            // The e-mail check code of an acknowledgement link (?dogrula=…, booking-submit.ts) is not
            // part of the address Google gets.
            var page = new URL(location.href);
            page.searchParams.delete('dogrula');
            page.hash = '';
            window.gtag('config', id, { page_location: page.href });
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=' + encodeURIComponent(id);
            document.head.appendChild(s);
          }
          // Removes Google's _ga cookies after a "decline" that follows an earlier "accept".
          function clear() {
            document.cookie.split(';').forEach(function (c) {
              var name = c.split('=')[0].trim();
              if (/^_ga/.test(name)) {
                var host = location.hostname.replace(/^www\./, '');
                ['', '; domain=' + host, '; domain=.' + host].forEach(function (d) {
                  document.cookie = name + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + d;
                });
              }
            });
          }
          var choice = get();
          if (choice === 'granted') load();
          else if (!choice && !skip && bar) bar.hidden = false;
          document.addEventListener('click', function (e) {
            var t = e.target.closest && e.target.closest('[data-consent], [data-cookie-prefs]');
            if (!t) return;
            if (t.hasAttribute('data-cookie-prefs')) {
              e.preventDefault();
              if (bar) bar.hidden = false;
              return;
            }
            var v = t.getAttribute('data-consent');
            var was = get();
            set(v);
            if (bar) bar.hidden = true;
            if (v === 'granted') load();
            else {
              clear();
              // Google's script cannot be unloaded: a reload leaves the page without it.
              if (was === 'granted' && loaded) location.reload();
            }
          });
        })();
      </script>
    </>
  )
}

<style>
  .consent-bar {
    position: fixed;
    right: 16px;
    bottom: 16px;
    left: 16px;
    z-index: 50;
    display: grid;
    gap: 12px;
    max-width: 30rem;
    margin-inline: auto;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    color: var(--text);
    box-shadow: 0 10px 30px color-mix(in srgb, #000 25%, transparent);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .consent-bar[hidden] {
    display: none;
  }

  .consent-bar p {
    margin: 0;
  }

  .consent-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  /* Both choices equally easy: same size, same weight. */
  .consent-actions button {
    min-height: 46px;
    border-radius: 14px;
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .c-reject {
    border: 1.5px solid var(--btn-bg);
    background: transparent;
    color: var(--text);
  }

  .c-accept {
    border: 1.5px solid var(--btn-bg);
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  @media (min-width: 768px) {
    .consent-bar {
      right: 24px;
      bottom: 24px;
      left: auto;
      margin: 0;
    }
  }
</style>
