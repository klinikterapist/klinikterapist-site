---
/**
 * A post in a list. Two looks:
 * - `card` (desktop grids): cover (or a sun-gradient placeholder), topic, title, description, date and reading time;
 * - `row` (phone lists): a ListItem with a small cover, the topic above the title, reading time below;
 * - `wide` (blog and popular pages on desktop; owner's Dribbble pick, SITE-GUNCELLEMESI karar 11): a
 *   horizontal card, the cover on the left inside the card's rounded edge (nested corners), the topic
 *   as a tone chip on the cover, title and description on the right, date · reading time · reads below.
 * The read count shows only when there is data and at least 50 reads (readsLabel).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../lib/settings';
import { getCategories } from '../lib/settings';
import type { PostEntry } from '../lib/posts';
import { postPath } from '../i18n/routes';
import { t } from '../i18n/ui';
import { formatDate, isoDay } from '../lib/date';
import { readCount, readsLabel } from '../lib/read-counts';
import { postThumb } from '../lib/post-image';
import { categoryTone } from '../lib/tones';
import ListItem from './ui/ListItem.astro';
import Icon from './Icon.astro';

interface Props {
  post: PostEntry;
  lang: Lang;
  variant?: 'card' | 'row' | 'wide';
  /** Heading level of the title inside the surrounding section (card only). */
  level?: 2 | 3;
  eager?: boolean;
}
const { post, lang, variant = 'card', level = 3, eager = false } = Astro.props;
const { data } = post;
const href = postPath(data.slug, lang);
const categories = getCategories();
const categoryLabel = categories.find((c) => c.id === data.category)?.label[lang].trim() ?? '';
const tone = categoryTone(data.category, categories.map((c) => c.id));
const cover = data.cover as ImageMetadata | undefined;
const date = data.publishedAt;
const minutes = `${post.readingMinutes} ${t(lang, 'minRead')}`;
const reads = readsLabel(readCount(post.key), lang);
const thumb = variant === 'row' ? await postThumb(cover) : undefined;
const Heading = level === 2 ? 'h2' : 'h3';
---

{
  variant === 'row' ? (
    <ListItem class="post-row" title={data.title} subtitle={minutes} href={href} thumb={thumb} icon="article">
      {(categoryLabel || reads) && (
        <span slot="meta" class="row-meta">
          {categoryLabel && <span class="post-cat">{categoryLabel}</span>}
          {categoryLabel && reads && <span aria-hidden="true"> · </span>}
          {reads && (
            <span class="reads">
              <Icon name="eye" size={13} />
              {reads}
            </span>
          )}
        </span>
      )}
    </ListItem>
  ) : variant === 'wide' ? (
    <article class="post-card wide">
      <div class="wide-media">
        {cover ? (
          <Image
            src={cover}
            alt={data.coverAlt ?? ''}
            widths={[320, 480, 640]}
            sizes="(min-width: 1024px) 240px, 280px"
            loading={eager ? 'eager' : 'lazy'}
            class="wide-cover"
          />
        ) : (
          <div class="wide-cover placeholder" aria-hidden="true" />
        )}
        {categoryLabel && (
          <span class="tag chip" style={`--chip-fg: var(--tone-${tone}); --chip-bg: var(--tone-${tone}-bg)`} data-tone={tone}>
            {categoryLabel}
          </span>
        )}
      </div>
      <div class="wide-body">
        <Heading class="card-title">
          <a href={href}>{data.title}</a>
        </Heading>
        {data.description.trim() && <p class="desc">{data.description}</p>}
        <p class="meta">
          <time datetime={isoDay(date)}>{formatDate(date, lang)}</time>
          <span aria-hidden="true">·</span>
          <span>{minutes}</span>
          {reads && (
            <>
              <span aria-hidden="true">·</span>
              <span class="reads">
                <Icon name="eye" size={14} />
                {reads}
              </span>
            </>
          )}
        </p>
      </div>
    </article>
  ) : (
    <article class="post-card">
      {cover ? (
        <Image
          src={cover}
          alt={data.coverAlt ?? ''}
          widths={[360, 560, 720]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class="cover"
        />
      ) : (
        <div class="cover placeholder" aria-hidden="true" />
      )}
      {categoryLabel && <span class="tag">{categoryLabel}</span>}
      <Heading class="card-title">
        <a href={href}>{data.title}</a>
      </Heading>
      {data.description.trim() && <p class="desc">{data.description}</p>}
      <p class="meta">
        <time datetime={isoDay(date)}>{formatDate(date, lang)}</time>
        <span aria-hidden="true">·</span>
        <span>{minutes}</span>
        {reads && (
          <>
            <span aria-hidden="true">·</span>
            <span class="reads">
              <Icon name="eye" size={14} />
              {reads}
            </span>
          </>
        )}
      </p>
    </article>
  )
}

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px;
    border-radius: 16px;
    background: var(--surface);
  }

  .post-card :global(.cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    margin-bottom: 6px;
    border-radius: 12px;
    object-fit: cover;
  }

  .placeholder {
    background: linear-gradient(135deg, var(--sun-halo), var(--sun-disc));
  }

  .tag,
  .post-cat {
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .card-title {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .card-title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 16px;
  }

  .card-title a:hover {
    color: var(--link);
  }

  .post-card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .desc {
    display: -webkit-box;
    margin: 0 0 var(--space-2);
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: auto 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .reads {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }
  /* The horizontal card: 10 px inset, so the cover's 12 px corners sit inside the card's 22 px ones. */
  .post-card.wide {
    flex-direction: row;
    align-items: stretch;
    gap: 18px;
    padding: 10px;
    border-radius: 22px;
  }

  .wide-media {
    position: relative;
    flex: none;
    width: 42%;
    max-width: 260px;
  }

  .wide-media :global(.wide-cover) {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 170px;
    border-radius: 12px;
    object-fit: cover;
  }

  .wide-body {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 6px;
    padding: 8px 10px 6px 0;
  }

  .chip {
    position: absolute;
    top: 10px;
    left: 10px;
    max-width: calc(100% - 20px);
    overflow: hidden;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    color: var(--chip-fg);
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .post-card.wide .card-title a::after {
    border-radius: 22px;
  }

  .post-card.wide .desc {
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }
</style>
