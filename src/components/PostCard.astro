---
/** Blog post card: cover (or sage placeholder), category chip, title, description, date, reading time. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../lib/settings';
import { getCategories } from '../lib/settings';
import type { PostEntry } from '../lib/posts';
import { postPath } from '../i18n/routes';
import { t } from '../i18n/ui';
import Leaf from './Leaf.astro';
import Icon from './Icon.astro';

interface Props {
  post: PostEntry;
  lang: Lang;
  /** Heading level of the title inside the surrounding section. */
  level?: 2 | 3;
  eager?: boolean;
}
const { post, lang, level = 3, eager = false } = Astro.props;
const { data } = post;
const href = postPath(data.slug, lang);
const category = getCategories().find((c) => c.id === data.category);
const cover = data.cover as ImageMetadata | undefined;
const date = data.publishedAt;
const dateText = new Intl.DateTimeFormat(lang === 'tr' ? 'tr-TR' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(date);
const Heading = level === 2 ? 'h2' : 'h3';
---

<article class="post-card card">
  <div class="media">
    {
      cover ? (
        <Image
          src={cover}
          alt={data.coverAlt ?? ''}
          widths={[360, 560, 720]}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          loading={eager ? 'eager' : 'lazy'}
          class="cover"
        />
      ) : (
        <div class="cover placeholder" aria-hidden="true">
          <Leaf size={56} />
        </div>
      )
    }
    {category && <span class="chip">{category.label[lang]}</span>}
  </div>
  <div class="body">
    <Heading class="card-title"><a href={href}>{data.title}</a></Heading>
    <p class="desc">{data.description}</p>
    <p class="meta">
      <time datetime={date.toISOString().slice(0, 10)}>{dateText}</time>
      <span aria-hidden="true">·</span>
      <span class="read"><Icon name="clock" size={14} />{post.readingMinutes} {t(lang, 'minRead')}</span>
    </p>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: border-color 0.15s ease;
  }

  .post-card:hover {
    border-color: var(--sage);
  }

  .media {
    position: relative;
  }

  .media :global(.cover) {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--sage-soft) 0%, #cdd8c8 100%);
    color: var(--forest);
  }

  .chip {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--forest);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: var(--space-4);
  }

  .card-title {
    margin: 0 0 var(--space-2);
    font-size: 1.1875rem;
    line-height: 1.3;
  }

  .card-title a {
    color: var(--ink);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-title a:hover {
    color: var(--forest);
  }

  .post-card:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .card-title a:focus-visible {
    outline: none;
  }

  .desc {
    display: -webkit-box;
    margin: 0 0 var(--space-3);
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: auto 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .read {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
</style>
