---
/**
 * Dev-server only (HomeView renders it under `import.meta.env.DEV`): a small switch at the bottom of
 * the home page to compare the ways of saying "free" on the intro call button (owner's review
 * 2026-10-19): the current corner tag, F (handwritten note) and J (small card). The choice sets
 * `data-free` on <html> and is remembered in this browser only.
 */
const options = [
  ['', 'Şimdiki'],
  ['f', 'F: El yazısı'],
  ['j', 'J: Kart'],
];
---

<div class="free-preview" role="group" aria-label="Ücretsiz etiketi önizlemesi">
  <span>Etiket:</span>
  {options.map(([value, label]) => <button type="button" data-free-pick={value}>{label}</button>)}
</div>

<script is:inline>
  (function () {
    var KEY = 'kt.freeStyle';
    var set = function (v) {
      if (v) document.documentElement.setAttribute('data-free', v);
      else document.documentElement.removeAttribute('data-free');
      document.querySelectorAll('[data-free-pick]').forEach(function (b) {
        b.setAttribute('aria-pressed', String(b.getAttribute('data-free-pick') === v));
      });
      try { localStorage.setItem(KEY, v); } catch (e) {}
    };
    var start = '';
    try { start = localStorage.getItem(KEY) || ''; } catch (e) {}
    set(start);
    document.querySelectorAll('[data-free-pick]').forEach(function (b) {
      b.addEventListener('click', function () { set(b.getAttribute('data-free-pick')); });
    });
  })();
</script>

<style>
  .free-preview {
    position: fixed;
    left: 50%;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 8px 6px 14px;
    border: 1px dashed var(--sun-disc);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--shadow-soft);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: 600;
    transform: translateX(-50%);
    white-space: nowrap;
  }

  .free-preview button {
    min-height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }

  .free-preview button[aria-pressed='true'] {
    border-color: var(--btn-bg);
    background: var(--btn-bg);
    color: var(--btn-text);
  }
</style>
