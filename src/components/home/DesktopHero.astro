---
/**
 * Desktop home intro (spec §5.7; owner's reviews 2026-10-18 and 2026-10-19): on the left the portrait
 * inside the site column, softly rounded on every corner, with the whole brand sun at its
 * bottom-right corner. On the right a personal welcome: a large handwritten "Hoş geldiniz", then the
 * greeting "Merhaba 👋 / Ben Klinik Psikolog Osman Güneş Özkurt." as the page's h1 in the serif and the
 * text colour, the tagline under it, intro, "Randevu Al" beside "Ön Görüşme" (with its "Ücretsiz" tag) and the wordmark in
 * the logo's own black/white. Without a photo the big sun with a soft halo stands in the same place.
 */
import type { Lang } from '../../lib/settings';
import { EMPTY_IMAGE, portraitImage } from '../../lib/portrait-image';
import { pathFor } from '../../i18n/routes';
import { bookingLive } from '../../lib/booking-entry';
import { bookHref, bookingClosed } from '../../lib/booking-intake';
import { t } from '../../i18n/ui';
import Icon from '../Icon.astro';
import SunMark from '../brand/SunMark.astro';
import Wordmark from '../brand/Wordmark.astro';
// "Hoş geldiniz" in a notebook handwriting (owner's choice E, 2026-10-19); only this hero loads it.
import '@fontsource/kalam/latin-700.css';
import '@fontsource/kalam/latin-ext-700.css';

interface Props {
  lang: Lang;
  photo?: string | null;
  alt: string;
  heading: string;
  intro: string;
  /** The greeting: the profile's title in `lang` (may be empty) and name. */
  title: string;
  name: string;
}
const { lang, photo, alt, heading, intro, title, name } = Astro.props;
const who = [title, name].filter(Boolean).join(' ');
// The photo box is at most 30rem (480 px) wide, about 40vw on smaller desktops; 2x screens take the
// 800 or 1080 px variant.
const img = photo ? await portraitImage(photo, [560, 800, 1080]) : null;
const sizes = '(max-width: 1199px) 40vw, 480px';
// Phones never show this hero: the <source> only matches from 768 px, and below that the <img>
// falls back to an empty inline GIF, so a phone fetches nothing while desktops load it eagerly.
---

<section class:list={['desktop-hero', img ? 'desktop-hero--photo' : 'desktop-hero--none']}>
  <div class="inner container">
    <div class="text">
      <p class="welcome">{t(lang, 'heroWelcome')}</p>
      <h1 class="greeting">
        <span class="hi">{t(lang, 'heroHi')} <span class="wave" aria-hidden="true">👋</span></span>
        <span class="me">{t(lang, 'heroMe').replace('{who}', who)}</span>
      </h1>
      {heading && <p class="tagline">{heading}</p>}
      {intro && <p class="lead">{intro}</p>}
      <div class="actions">
        {
          bookingClosed(lang) ? (
            <a class="big book is-closed" href={bookHref(lang)}>
              <Icon name="booking" size={20} />
              {t(lang, 'bookSession')}
              <span class="closed-badge">{t(lang, 'bookingClosed')}</span>
            </a>
          ) : (
            <a class="btn big book" href={bookHref(lang)}>
              <Icon name="booking" size={20} />
              {t(lang, 'bookSession')}
            </a>
          )
        }
        {
          /* With the booking start page live, the intro call is offered there (Faz 3). */
          !bookingLive() && (
            <a class="pre" href={pathFor('preConsult', lang)}>
              <span class="pre-ic"><Icon name="talk" size={20} /></span>
              <span class="pre-lines">
                <small class="pre-sub">{t(lang, 'preConsultSub')}</small>
                <span class="pre-name">{t(lang, 'preConsult')}</span>
              </span>
            </a>
          )
        }
      </div>
      <span class="hero-wordmark">
        <Wordmark height={56} decorative />
      </span>
    </div>

    {
      img ? (
        <div class="art art--photo">
          <picture>
            <source media="(min-width: 768px)" srcset={img.srcset ?? img.src} sizes={img.srcset ? sizes : undefined} />
            <img class="photo" src={EMPTY_IMAGE} width={img.width} height={img.height} alt={alt} loading="eager" decoding="async" />
          </picture>
          <span class="sun">
            <SunMark size={150} />
          </span>
        </div>
      ) : (
        <div class="art art--none">
          <span class="glow" aria-hidden="true" />
          <SunMark size={300} />
        </div>
      )
    }
  </div>
</section>

<style>
  .desktop-hero--photo {
    /* Room under the photo for the part of the sun that hangs below it. */
    padding-bottom: var(--space-7);
  }

  .inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    /* Wider than the sun's overhang into it (0.4 × its width), so the text is never covered. */
    gap: clamp(4rem, 6vw, 6rem);
  }

  .desktop-hero--photo .inner {
    min-height: clamp(30rem, 40vw, 44rem);
  }

  .text {
    align-self: center;
    padding-block: var(--space-8) var(--space-7);
  }

  /* The photo first, the text beside it. */
  .art {
    order: -1;
  }

  /*
   * Owner's choice E (2026-10-19): "Hoş geldiniz" is the largest line, in a slightly tilted notebook
   * handwriting; "Merhaba 👋" a little smaller; "Ben Klinik Psikolog …" on its own line under it.
   */
  .welcome {
    margin: 0;
    /* The site's white (cream at night, ink by day), owner's review 2026-10-19. */
    color: var(--text);
    font-family: 'Kalam', 'Segoe Print', 'Bradley Hand', cursive;
    font-size: clamp(3.4rem, 2rem + 3.6vw, 5.6rem);
    font-weight: 700;
    line-height: 1.05;
    transform: rotate(-2deg);
    transform-origin: left center;
  }

  .greeting {
    display: grid;
    gap: var(--space-1);
    margin: var(--space-4) 0 var(--space-4);
    color: var(--text);
    font-weight: 400;
    text-wrap: balance;
  }

  .hi {
    font-size: clamp(2rem, 1.3rem + 1.4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.15;
  }

  .me {
    font-size: clamp(1.5rem, 1.1rem + 0.9vw, 1.9rem);
    line-height: 1.25;
  }

  .wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: wave 2.4s ease-in-out 1s 2;
  }

  @keyframes wave {
    0%, 60%, 100% { transform: rotate(0); }
    10%, 30% { transform: rotate(14deg); }
    20% { transform: rotate(-8deg); }
    40% { transform: rotate(-4deg); }
    50% { transform: rotate(10deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }

  .tagline {
    margin: 0 0 var(--space-3);
    color: var(--link);
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1rem + 0.8vw, 1.75rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.3;
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .big {
    min-height: 52px;
    padding-inline: var(--space-5);
    font-size: var(--text-base);
  }

  /* Booking closed in this language (bookingClosed): muted, with a "Randevu alımına kapalı" badge;
     still a link, to the booking page that says so and offers "Haber et". */
  .is-closed {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    border: 1.5px dashed color-mix(in srgb, var(--muted) 60%, transparent);
    border-radius: var(--radius-pill);
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }

  .closed-badge {
    padding: 2px 10px;
    border-radius: var(--radius-pill);
    background: var(--tone-kiremit-bg);
    color: var(--tone-kiremit);
    font-size: 0.75rem;
    font-weight: 700;
  }

  /*
   * "Ön Görüşme" as a small card (owner's choice J, 2026-10-19): an icon tile, then "Ücretsiz ·
   * Online" in small text over the name. A different shape from the yellow "Randevu Al".
   */
  .pre {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 62px;
    padding: 8px 22px 8px 10px;
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
    font-weight: 700;
    text-decoration: none;
  }

  .pre:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .pre-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 13px;
    background: var(--surface-2);
    color: var(--link);
  }

  .pre:hover .pre-ic {
    background: var(--surface);
  }

  .pre-lines {
    display: grid;
    line-height: 1.2;
    text-align: left;
  }

  .pre-sub {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }

  .book :global(.icon),
  .pre :global(.icon) {
    transition: transform 0.25s ease;
  }

  .book:hover :global(.icon),
  .pre:hover :global(.icon) {
    transform: rotate(-8deg) scale(1.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .book:hover :global(.icon),
    .pre:hover :global(.icon) {
      transform: none;
    }
  }

  /* The klinikterapist wordmark under the buttons, in the logo's own black/white (the text colour). */
  .hero-wordmark {
    display: block;
    margin-top: var(--space-7);
    color: var(--text);
    line-height: 0;
  }

  .hero-wordmark :global(.wordmark) {
    width: auto;
    height: clamp(44px, 4vw, 56px);
  }

  .art {
    position: relative;
  }

  /* Inside the site column: the photo starts on the header's left edge, rounded on every corner. */
  .art--photo {
    --sun: clamp(110px, 10vw, 150px);
    align-self: center;
    justify-self: start;
    width: min(100%, 30rem);
    aspect-ratio: 4 / 5;
    margin-block: var(--space-7) 0;
  }

  .art--photo picture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: clamp(1.25rem, 2vw, 2rem);
    box-shadow: var(--shadow-soft);
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--surface);
    object-fit: cover;
    object-position: center 20%;
  }

  /* Flat, never rotated and never cut off: the whole sun sits on the photo's bottom-right corner. */
  .sun {
    position: absolute;
    right: calc(-0.3 * var(--sun));
    bottom: calc(-0.3 * var(--sun));
    display: block;
    width: var(--sun);
    height: var(--sun);
  }

  .sun :global(.sun-mark) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art--none {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    padding-block: var(--space-8) var(--space-7);
  }

  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sun-halo) 35%, transparent) 0%, transparent 65%);
  }

  .art--none :global(.sun-mark) {
    position: relative;
    width: min(300px, 100%);
    height: auto;
  }
</style>
