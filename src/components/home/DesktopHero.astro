---
/**
 * Desktop home intro (spec §5.7): eyebrow, the tagline as the page's h1, intro, "Randevu Al" and
 * "İlk görüşme nasıl geçer?", the membership and response-time line; on the right the portrait in
 * the chosen style, or the big sun with a soft halo when there is no photo.
 */
import type { Lang } from '../../lib/settings';
import { portraitImage, type PortraitStyle } from '../../lib/portrait-image';
import { faqPath, pathFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import Icon from '../Icon.astro';
import SunMark from '../brand/SunMark.astro';

interface Props {
  style: PortraitStyle;
  lang: Lang;
  photo?: string | null;
  alt: string;
  eyebrow: string;
  heading: string;
  intro: string;
  /** Membership organisations already filtered to non-empty names in `lang`. */
  memberships: string[];
}
const { style, lang, photo, alt, eyebrow, heading, intro, memberships } = Astro.props;
const kind: PortraitStyle = style !== 'none' && photo ? style : 'none';
// Hidden on phones; lazy so a phone never fetches it.
const img = kind === 'none' ? null : await portraitImage(photo!, kind === 'background' ? [420, 840] : [320, 640]);
const sizes = kind === 'background' ? '(max-width: 767px) 1px, 420px' : '(max-width: 767px) 1px, 320px';
const trust = [...memberships.map((org) => t(lang, 'memberOf').replace('{org}', org)), t(lang, 'responseTime')].join(' · ');
---

<section class="desktop-hero container">
  <div class="text">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{heading}</h1>
    {intro && <p class="lead">{intro}</p>}
    <div class="actions">
      <a class="btn big" href={pathFor('appointment', lang)}>
        <Icon name="calendar" size={18} />
        {t(lang, 'bookSession')}
      </a>
      <a class="ghost" href={`${faqPath(lang)}#ilk-gorusme`}>{t(lang, 'firstSession')}</a>
    </div>
    <p class="trust">
      <Icon name="shield" size={16} />
      <span>{trust}</span>
    </p>
  </div>

  <div class:list={['art', `art--${kind}`]}>
    {
      kind === 'none' || !img ? (
        <>
          <span class="glow" aria-hidden="true" />
          <SunMark size={300} />
        </>
      ) : (
        <span class="frame">
          <img src={img.src} srcset={img.srcset} sizes={img.srcset ? sizes : undefined} width={img.width} height={img.height} alt={alt} loading="lazy" decoding="async" />
          <span class="sun-badge">
            <SunMark size={kind === 'background' ? 56 : 48} />
          </span>
        </span>
      )
    }
  </div>
</section>

<style>
  .desktop-hero {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--space-5);
    align-items: center;
    padding-block: var(--space-8) var(--space-7);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.5rem, 1.5rem + 2.4vw, 3.25rem);
    line-height: 1.05;
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .big {
    min-height: 52px;
    padding-inline: var(--space-5);
    font-size: var(--text-base);
  }

  .ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .ghost:hover {
    background: var(--surface);
    color: var(--text);
  }

  .trust {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .art {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
  }

  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sun-halo) 35%, transparent) 0%, transparent 65%);
  }

  .art :global(.sun-mark) {
    position: relative;
  }

  .frame {
    position: relative;
    display: block;
  }

  .frame img {
    object-fit: cover;
    object-position: center 25%;
  }

  .art--background .frame img {
    width: min(420px, 100%);
    aspect-ratio: 4 / 5;
    border-radius: 28px;
  }

  .art--round .frame img {
    width: 320px;
    height: 320px;
    border-radius: 50%;
    box-shadow: 0 0 0 6px var(--surface);
  }

  .sun-badge {
    position: absolute;
    display: flex;
    padding: 4px;
    border-radius: 50%;
    background: var(--bg);
  }

  .art--background .sun-badge {
    left: -18px;
    bottom: 24px;
  }

  .art--round .sun-badge {
    right: 8px;
    bottom: 8px;
  }
</style>
