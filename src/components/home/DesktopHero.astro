---
/**
 * Desktop home intro (spec §5.7; owner's review 2026-10-18): on the left the portrait inside the
 * site column (its left edge on the header's), softly rounded on every corner, with the whole brand
 * sun at its bottom-right corner; on the right a warm greeting ("Merhaba, ben Klinik Psikolog Osman
 * Güneş Özkurt."), the tagline as the page's h1, intro, "Randevu Al" and "İlk görüşme nasıl geçer?",
 * and the wordmark under them. The profile's heroStyle only picks the phone header (PortraitHero);
 * every desktop with a photo gets this layout. Without a photo the big sun with a soft halo stands in
 * the same place.
 */
import type { Lang } from '../../lib/settings';
import { EMPTY_IMAGE, portraitImage } from '../../lib/portrait-image';
import { pathFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import Icon from '../Icon.astro';
import SunMark from '../brand/SunMark.astro';
import Wordmark from '../brand/Wordmark.astro';

interface Props {
  lang: Lang;
  photo?: string | null;
  alt: string;
  heading: string;
  intro: string;
  /** The greeting: the profile's title in `lang` (may be empty) and name. */
  title: string;
  name: string;
  /** The "first session" link points at the FAQ item `ilk-gorusme`; hidden when that item has no answer. */
  showFirstSession: boolean;
}
const { lang, photo, alt, heading, intro, title, name, showFirstSession } = Astro.props;
const greeting = t(lang, 'heroGreeting').replace('{who}', [title, name].filter(Boolean).join(' '));
// The photo box is at most 30rem (480 px) wide, about 40vw on smaller desktops; 2x screens take the
// 800 or 1080 px variant.
const img = photo ? await portraitImage(photo, [560, 800, 1080]) : null;
const sizes = '(max-width: 1199px) 40vw, 480px';
// Phones never show this hero: the <source> only matches from 768 px, and below that the <img>
// falls back to an empty inline GIF, so a phone fetches nothing while desktops load it eagerly.
---

<section class:list={['desktop-hero', img ? 'desktop-hero--photo' : 'desktop-hero--none']}>
  <div class="inner container">
    <div class="text">
      <p class="greeting">{greeting}</p>
      <h1>{heading}</h1>
      {intro && <p class="lead">{intro}</p>}
      <div class="actions">
        <a class="btn big" href={pathFor('appointment', lang)}>
          <Icon name="calendar" size={18} />
          {t(lang, 'bookSession')}
        </a>
        {showFirstSession && <a class="ghost" href={`${pathFor('faq', lang)}#ilk-gorusme`}>{t(lang, 'firstSession')}</a>}
      </div>
      <span class="hero-wordmark">
        <Wordmark height={40} decorative />
      </span>
    </div>

    {
      img ? (
        <div class="art art--photo">
          <picture>
            <source media="(min-width: 768px)" srcset={img.srcset ?? img.src} sizes={img.srcset ? sizes : undefined} />
            <img class="photo" src={EMPTY_IMAGE} width={img.width} height={img.height} alt={alt} loading="eager" decoding="async" />
          </picture>
          <span class="sun">
            <SunMark size={150} />
          </span>
        </div>
      ) : (
        <div class="art art--none">
          <span class="glow" aria-hidden="true" />
          <SunMark size={300} />
        </div>
      )
    }
  </div>
</section>

<style>
  .desktop-hero--photo {
    /* Room under the photo for the part of the sun that hangs below it. */
    padding-bottom: var(--space-7);
  }

  .inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    /* Wider than the sun's overhang into it (0.4 × its width), so the text is never covered. */
    gap: clamp(4rem, 6vw, 6rem);
  }

  .desktop-hero--photo .inner {
    min-height: clamp(30rem, 40vw, 44rem);
  }

  .text {
    align-self: center;
    padding-block: var(--space-8) var(--space-7);
  }

  /* The photo first, the text beside it. */
  .art {
    order: -1;
  }

  .greeting {
    margin: 0 0 var(--space-3);
    color: var(--link);
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.4;
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.5rem, 1.5rem + 2.4vw, 3.25rem);
    line-height: 1.05;
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .big {
    min-height: 52px;
    padding-inline: var(--space-5);
    font-size: var(--text-base);
  }

  .ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .ghost:hover {
    background: var(--surface);
    color: var(--text);
  }

  /* The klinikterapist wordmark under the buttons, in the theme's accent colour. */
  .hero-wordmark {
    display: block;
    margin-top: var(--space-7);
    color: var(--link);
    line-height: 0;
  }

  .hero-wordmark :global(.wordmark) {
    width: auto;
    height: clamp(32px, 3vw, 40px);
  }

  .art {
    position: relative;
  }

  /* Inside the site column: the photo starts on the header's left edge, rounded on every corner. */
  .art--photo {
    --sun: clamp(110px, 10vw, 150px);
    align-self: center;
    justify-self: start;
    width: min(100%, 30rem);
    aspect-ratio: 4 / 5;
    margin-block: var(--space-7) 0;
  }

  .art--photo picture {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: clamp(1.25rem, 2vw, 2rem);
    box-shadow: var(--shadow-soft);
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--surface);
    object-fit: cover;
    object-position: center 20%;
  }

  /* Flat, never rotated and never cut off: the whole sun sits on the photo's bottom-right corner. */
  .sun {
    position: absolute;
    right: calc(-0.3 * var(--sun));
    bottom: calc(-0.3 * var(--sun));
    display: block;
    width: var(--sun);
    height: var(--sun);
  }

  .sun :global(.sun-mark) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art--none {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    padding-block: var(--space-8) var(--space-7);
  }

  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sun-halo) 35%, transparent) 0%, transparent 65%);
  }

  .art--none :global(.sun-mark) {
    position: relative;
    width: min(300px, 100%);
    height: auto;
  }
</style>
