---
/**
 * Desktop home intro (spec §5.7): eyebrow, the tagline as the page's h1, intro, "Randevu Al" and
 * "İlk görüşme nasıl geçer?", the membership and response-time line with the wordmark under it. On the right the portrait runs
 * frameless to the window's right edge, top to bottom of the hero, with a big rounded top-left corner
 * and the brand sun rising from its bottom-left corner ("kenara taşan"). The profile's heroStyle only
 * picks the phone header (PortraitHero); every desktop with a photo gets this layout. Without a photo
 * the big sun with a soft halo stands in the same place.
 */
import type { Lang } from '../../lib/settings';
import { EMPTY_IMAGE, portraitImage } from '../../lib/portrait-image';
import { pathFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import Icon from '../Icon.astro';
import SunMark from '../brand/SunMark.astro';
import Wordmark from '../brand/Wordmark.astro';

interface Props {
  lang: Lang;
  photo?: string | null;
  alt: string;
  eyebrow: string;
  heading: string;
  intro: string;
  /** Membership organisations already filtered to non-empty names in `lang`. */
  memberships: string[];
}
const { lang, photo, alt, eyebrow, heading, intro, memberships } = Astro.props;
// The photo box is about 45vw wide (and as tall as the hero, so a square photo is cropped to it):
// ~480 px at 768, ~550 at 1280, ~720 at 1600; the 1080 px variant only for wide or 2x screens.
const img = photo ? await portraitImage(photo, [560, 800, 1080]) : null;
const sizes = '(max-width: 1279px) 560px, 45vw';
// Phones never show this hero: the <source> only matches from 768 px, and below that the <img>
// falls back to an empty inline GIF, so a phone fetches nothing while desktops load it eagerly.
const trust = [...memberships.map((org) => t(lang, 'memberOf').replace('{org}', org)), t(lang, 'responseTime')].join(' · ');
---

<section class:list={['desktop-hero', img ? 'desktop-hero--photo' : 'desktop-hero--none']}>
  <div class="inner container">
    <div class="text">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{heading}</h1>
      {intro && <p class="lead">{intro}</p>}
      <div class="actions">
        <a class="btn big" href={pathFor('appointment', lang)}>
          <Icon name="calendar" size={18} />
          {t(lang, 'bookSession')}
        </a>
        <a class="ghost" href={`${pathFor('faq', lang)}#ilk-gorusme`}>{t(lang, 'firstSession')}</a>
      </div>
      <p class="trust">
        <Icon name="shield" size={16} />
        <span>{trust}</span>
      </p>
      <span class="hero-wordmark">
        <Wordmark height={22} decorative />
      </span>
    </div>

    {
      img ? (
        <div class="art art--bleed">
          <picture>
            <source media="(min-width: 768px)" srcset={img.srcset ?? img.src} sizes={img.srcset ? sizes : undefined} />
            <img class="photo" src={EMPTY_IMAGE} width={img.width} height={img.height} alt={alt} loading="eager" decoding="async" />
          </picture>
          <span class="sun">
            <SunMark size={170} />
          </span>
        </div>
      ) : (
        <div class="art art--none">
          <span class="glow" aria-hidden="true" />
          <SunMark size={300} />
        </div>
      )
    }
  </div>
</section>

<style>
  .desktop-hero--photo {
    /* The photo bleeds to the window edge and the sun sinks below the hero: both are cut off here. */
    overflow: clip;
  }

  .inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    /* Wider than the sun's overhang into it (0.4 × its width), so the text is never covered. */
    gap: clamp(4rem, 6vw, 6rem);
  }

  .desktop-hero--photo .inner {
    min-height: clamp(30rem, 40vw, 44rem);
  }

  .text {
    align-self: center;
    padding-block: var(--space-8) var(--space-7);
  }

  .eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--link);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0 0 var(--space-4);
    font-size: clamp(2.5rem, 1.5rem + 2.4vw, 3.25rem);
    line-height: 1.05;
  }

  .lead {
    max-width: 34rem;
    margin: 0 0 var(--space-5);
    color: var(--muted);
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
  }

  .big {
    min-height: 52px;
    padding-inline: var(--space-5);
    font-size: var(--text-base);
  }

  .ghost {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 var(--space-5);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .ghost:hover {
    background: var(--surface);
    color: var(--text);
  }

  .trust {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-5) 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  /* The klinikterapist wordmark under the trust line: modest, in the theme's accent colour. */
  .hero-wordmark {
    display: block;
    margin-top: var(--space-4);
    color: var(--link);
    line-height: 0;
  }

  .hero-wordmark :global(.wordmark) {
    width: auto;
    height: 22px;
  }

  .art {
    position: relative;
  }

  /* Edge bleed: the box stretches over the hero's full height and, past the container's gutter and
     side margin, to the window's right edge (any scrollbar overshoot is clipped by the section). */
  .art--bleed {
    --sun: clamp(120px, 11vw, 170px);
    margin-right: calc(-1 * (max(0px, (100vw - var(--max-wide) - 2 * var(--gutter)) / 2) + var(--gutter)));
  }

  .art--bleed picture {
    position: absolute;
    inset: 0;
  }

  .photo {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: clamp(120px, 12vw, 180px) 0 0 0;
    background: var(--surface);
    object-fit: cover;
    object-position: center 20%;
  }

  /* Flat, never rotated: rising from the photo's bottom-left corner, partly below the hero. */
  .sun {
    position: absolute;
    left: calc(-0.4 * var(--sun));
    bottom: calc(-0.25 * var(--sun));
    display: block;
    width: var(--sun);
    height: var(--sun);
  }

  .sun :global(.sun-mark) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .art--none {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 320px;
    padding-block: var(--space-8) var(--space-7);
  }

  .glow {
    position: absolute;
    inset: -10%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sun-halo) 35%, transparent) 0%, transparent 65%);
  }

  .art--none :global(.sun-mark) {
    position: relative;
    width: min(300px, 100%);
    height: auto;
  }
</style>
