---
/**
 * "Süreç nasıl işler?" on the desktop home page (spec §5.7; owner's note 2026-10-22, choice 7B): up
 * to three steps from home.json `process` as one strip, each part with "ADIM n", its title, its text
 * and a large, faint sun-coloured number. A step with an empty title or text in this language is
 * skipped; with none left the whole section is left out.
 */
import type { Home, Lang } from '../../lib/settings';
import { t } from '../../i18n/ui';

interface Props {
  lang: Lang;
  steps: Home['process'];
}
const { lang, steps = [] } = Astro.props;
const STEP = lang === 'en' ? 'Step' : 'Adım';
const shown = steps
  .map((s) => ({ title: s.title[lang].trim(), text: s.text[lang].trim() }))
  .filter((s) => s.title && s.text);
---

{
  shown.length > 0 && (
    <section class="process-steps container" aria-labelledby="process-title">
      <h2 id="process-title">{t(lang, 'processTitle')}</h2>
      <ol class:list={['strip', `n${shown.length}`]}>
        {shown.map((s, i) => (
          <li>
            <small class="step">{`${STEP} ${i + 1}`}</small>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <span class="num" aria-hidden="true">
              {i + 1}
            </span>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .process-steps {
    padding-block: var(--space-6);
  }

  h2 {
    margin-bottom: var(--space-5);
    font-size: 1.875rem;
  }

  .strip {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface);
    list-style: none;
  }

  .strip.n2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .strip.n1 {
    grid-template-columns: minmax(0, 1fr);
  }

  li {
    position: relative;
    padding: 28px 24px 32px;
    overflow: hidden;
    border-right: 1px solid var(--line);
  }

  li:last-child {
    border-right: 0;
  }

  .step {
    position: relative;
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    position: relative;
    margin: 6px 0 8px;
    font-size: 1.25rem;
  }

  p {
    position: relative;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* The big number sits behind the text, in the corner. */
  .num {
    position: absolute;
    right: 12px;
    bottom: -22px;
    color: var(--sun-disc);
    font-family: var(--font-serif);
    font-size: 7rem;
    font-weight: 600;
    line-height: 1;
    opacity: 0.16;
    pointer-events: none;
  }
</style>
