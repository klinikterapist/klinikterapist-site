---
/**
 * "Yazıyı paylaş" (spec §5.8): the device's share sheet (`navigator.share`), else the link is copied
 * (`navigator.clipboard`) and "Bağlantı kopyalandı" is announced in a live region. The button stays
 * hidden until the script finds one of the two, so no reader ever sees a button that does nothing.
 */
import type { Lang } from '../../lib/settings';
import { t } from '../../i18n/ui';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  title: string;
  /** Absolute URL of the post. */
  url: string;
}
const { lang, title, url } = Astro.props;
---

<div class="share" data-share>
  <button class="share-btn" type="button" data-title={title} data-url={url} hidden>
    <span class="ic"><Icon name="share" size={20} /></span>
    <span class="text">
      <b class="title">{t(lang, 'sharePost')}</b>
      <small class="subtitle">{t(lang, 'shareHint')}</small>
    </span>
  </button>
  <p class="status" role="status" aria-live="polite" data-copied={t(lang, 'linkCopied')}></p>
</div>

<script>
  for (const box of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const btn = box.querySelector<HTMLButtonElement>('.share-btn');
    const status = box.querySelector<HTMLElement>('.status');
    if (!btn || !status) continue;
    const canShare = typeof navigator.share === 'function';
    const canCopy = !!navigator.clipboard?.writeText;
    if (!canShare && !canCopy) continue;
    btn.hidden = false;
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url ?? location.href;
      if (canShare) {
        try {
          await navigator.share({ title: btn.dataset.title, url });
          return;
        } catch (e) {
          // The reader closed the sheet: nothing to do. Any other failure falls back to copying.
          if ((e as Error).name === 'AbortError' || !canCopy) return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        status.textContent = status.dataset.copied ?? '';
        setTimeout(() => (status.textContent = ''), 4000);
      } catch {
        /* Copy refused (permissions): leave the page as it is. */
      }
    });
  }
</script>

<style>
  .share-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    min-height: 44px;
    padding: 14px;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
    text-align: left;
    cursor: pointer;
  }

  .share-btn[hidden] {
    display: none;
  }

  .share-btn:hover {
    background: color-mix(in srgb, var(--surface), var(--text) 5%);
  }

  .ic {
    display: flex;
    color: var(--link);
  }

  .text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
  }

  .title {
    font-weight: 600;
  }

  .subtitle {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .status {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .status:not(:empty) {
    margin-top: var(--space-2);
  }
</style>
