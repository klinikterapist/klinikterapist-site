---
/**
 * Day/night toggle. `segmented` (desktop): System / Day / Night. `chip` (mobile): one button,
 * tap switches day <-> night, long-press returns to system. Behaviour lives in lib/theme.ts.
 */
import type { Lang } from '../lib/settings';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
  variant: 'segmented' | 'chip';
}
const { lang, variant } = Astro.props;

const ICON_ATTRS = 'viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" width="18" height="18"';
const ICONS = {
  system: `<svg ${ICON_ATTRS}><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>`,
  light: `<svg ${ICON_ATTRS}><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>`,
  dark: `<svg ${ICON_ATTRS}><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>`,
};
const chipName = (mode: 'light' | 'dark' | 'system') =>
  t(lang, 'themeChipName').replace('{mode}', t(lang, mode === 'light' ? 'themeLight' : mode === 'dark' ? 'themeDark' : 'themeSystem'));
const options = [
  { value: 'system', label: t(lang, 'themeSystem') },
  { value: 'light', label: t(lang, 'themeLight') },
  { value: 'dark', label: t(lang, 'themeDark') },
] as const;
---

{
  variant === 'segmented' ? (
    <div class="theme-segmented" role="group" aria-label={t(lang, 'themeLabel')}>
      {options.map((o) => (
        <button type="button" data-theme-set={o.value} aria-pressed="false">
          <Fragment set:html={ICONS[o.value]} />
          <span>{o.label}</span>
        </button>
      ))}
    </div>
  ) : (
    <button type="button" class="theme-chip" data-theme-set="toggle" aria-label={chipName('light')} data-aria-light={chipName('light')} data-aria-dark={chipName('dark')} data-aria-system={chipName('system')}>
      <span class="l-light"><Fragment set:html={ICONS.light} /><span>{t(lang, 'themeLight')}</span></span>
      <span class="l-dark"><Fragment set:html={ICONS.dark} /><span>{t(lang, 'themeDark')}</span></span>
      <span class="l-system"><Fragment set:html={ICONS.system} /><span>{t(lang, 'themeSystem')}</span></span>
    </button>
  )
}

<script>
  import { initThemeToggles } from '../lib/theme';
  initThemeToggles();
</script>

<style>
  .theme-segmented {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: var(--surface);
  }

  .theme-segmented button,
  .theme-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-touch-callout: none;
  }

  .theme-segmented button[aria-pressed='true'] {
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  .theme-segmented button:not([aria-pressed='true']):hover {
    background: var(--surface-2);
  }

  .theme-chip {
    border: 1px solid var(--line);
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    backdrop-filter: blur(6px);
  }

  .theme-chip > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Day label by default; night label under the dark theme; "Sistem" while the long-press flash shows. */
  .theme-chip .l-dark,
  .theme-chip .l-system {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-chip .l-light {
    display: none;
  }

  :global(html[data-theme='dark']) .theme-chip .l-dark {
    display: inline-flex;
  }

  .theme-chip[data-flash='system'] .l-light,
  .theme-chip[data-flash='system'] .l-dark {
    display: none !important;
  }

  .theme-chip[data-flash='system'] .l-system {
    display: inline-flex;
  }
</style>
