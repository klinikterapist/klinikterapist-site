---
/**
 * Topic filter as real links to the category pages, so it works without JavaScript; on the all-posts
 * page the blog script filters the list in place instead (`data-cat`). Two looks:
 * - `chips` (desktop): a row of pills, "Tümü" first and "Popüler" last when there are popular posts;
 * - `list` (phone, inside the "Konular" box): one tappable line per topic.
 */
import type { Category, Lang } from '../lib/settings';
import { getCategories } from '../lib/settings';
import { categoryPath, pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
  /** The category page being shown; none on the full blog list. */
  current?: Category;
  variant?: 'chips' | 'list';
  /** Add the "Popüler" chip, which jumps to the #popular section. */
  popular?: boolean;
  class?: string;
}
const { lang, current, variant = 'chips', popular = false, class: className } = Astro.props;
const items = [
  { href: pathFor('blog', lang), label: t(lang, 'filterAll'), cat: '', active: !current },
  ...getCategories()
    .map((c) => ({ href: categoryPath(c, lang), label: c.label[lang].trim(), cat: c.id, active: current?.id === c.id }))
    .filter((c) => c.label),
];
---

<nav class:list={['category-nav', variant, className]} aria-label={t(lang, 'categories')}>
  <ul>
    {
      items.map((item) => (
        <li>
          <a
            class="chip-link"
            href={item.href}
            data-cat={item.cat}
            aria-current={item.active ? 'page' : undefined}
          >
            {item.label}
          </a>
        </li>
      ))
    }
    {
      popular && variant === 'chips' && (
        <li>
          <a class="chip-link" href="#popular" data-clear-filter>
            <Icon name="flame" size={16} />
            {t(lang, 'popularChip')}
          </a>
        </li>
      )
    }
  </ul>
</nav>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chip-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    padding: 0 var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .chip-link:hover {
    border-color: var(--link);
    color: var(--link);
  }

  .chip-link[aria-current='page'] {
    border-color: var(--btn-bg);
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  /* Phone: one line per topic inside the "Konular" box. */
  .list ul {
    flex-direction: column;
    gap: 0;
  }

  .list .chip-link {
    display: flex;
    width: 100%;
    padding: 0 var(--space-2);
    border: 0;
    border-top: 1px solid var(--line);
    border-radius: 0;
  }

  .list li:first-child .chip-link {
    border-top: 0;
  }

  .list .chip-link[aria-current='page'] {
    background: none;
    color: var(--link);
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .chip-link {
      transition: none;
    }
  }
</style>
