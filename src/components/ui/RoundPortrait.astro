---
/**
 * Round profile photo for the inner pages and the author box (spec §5.9, §5.8): the photo resized by
 * Astro's image service (portrait-image.ts), or the sun in a surface circle when there is no photo.
 */
import { portraitImage } from '../../lib/portrait-image';
import SunMark from '../brand/SunMark.astro';

interface Props {
  photo: string | null | undefined;
  alt: string;
  /** Diameter in px. */
  size: number;
  /** Above the fold: load at once. */
  eager?: boolean;
  class?: string;
}
const { photo, alt, size, eager = false, class: className } = Astro.props;
const img = photo ? await portraitImage(photo, [size, size * 2, size * 3]) : null;
---

<div class:list={['portrait', { 'portrait--sun': !img }, className]} style={`--size:${size}px`}>
  {
    img ? (
      <img
        src={img.src}
        srcset={img.srcset}
        sizes={img.srcset ? `${size}px` : undefined}
        alt={alt}
        width={size}
        height={size}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <SunMark size={Math.round(size * 0.66)} />
    )
  }
</div>

<style>
  .portrait {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: var(--size);
    height: var(--size);
    overflow: hidden;
    border-radius: 50%;
    background: var(--surface);
  }

  .portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
