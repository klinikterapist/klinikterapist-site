---
/**
 * One tappable row: icon (or thumbnail), title, soft subtitle, chevron. The `meta` slot is one small,
 * muted line above the title (a label, a category, a read count); it never wraps.
 * Without `href` it is a plain row (no link, no chevron), for facts such as a membership.
 */
import Icon from '../Icon.astro';

interface Props {
  title: string;
  href?: string;
  subtitle?: string;
  icon?: string;
  /** Image URL for a 48 px rounded thumbnail (replaces the icon). */
  thumb?: string;
  class?: string;
}
const { title, href, subtitle, icon, thumb, class: className } = Astro.props;
const external = !!href && /^https?:\/\//.test(href);
const Tag = href ? 'a' : 'div';
---

<Tag class:list={['list-item', className]} href={href} {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
  {
    thumb ? (
      <img class="thumb" src={thumb} alt="" width="48" height="48" loading="lazy" />
    ) : (
      icon && (
        <span class="ic">
          <Icon name={icon} size={20} />
        </span>
      )
    )
  }
  <span class="text">
    {Astro.slots.has('meta') && <span class="meta"><slot name="meta" /></span>}
    <b class="title">{title}</b>
    {subtitle && <small class="subtitle">{subtitle}</small>}
  </span>
  {href && <span class="chv"><Icon name="chevron" size={18} /></span>}
</Tag>

<style>
  .list-item {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 14px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .ic {
    display: flex;
    color: var(--link);
  }

  .thumb {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 10px;
    object-fit: cover;
    background: var(--surface-2);
  }

  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-wrap: anywhere;
  }

  .meta {
    overflow: hidden;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.4;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow-wrap: normal;
  }

  .title {
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  .chv {
    display: flex;
    color: var(--muted);
  }
</style>
