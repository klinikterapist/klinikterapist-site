---
/**
 * Centred head of an inner page (spec §5.9): an optional round photo or sun (`media` slot), the h1,
 * then the page's own lines (default slot): `.who-line` / `.ti` (soft line), `.tpd` (membership),
 * `.lead` (intro sentence).
 */
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<header class="page-head">
  {Astro.slots.has('media') && <div class="media"><slot name="media" /></div>}
  <h1>{title}</h1>
  <slot />
</header>

<style>
  .page-head {
    text-align: center;
  }

  .media {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }

  h1 {
    margin: 4px 0;
    font-size: 1.875rem;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.12;
  }

  .page-head :global(.who-line),
  .page-head :global(.ti) {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .page-head :global(.tpd) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .page-head :global(.lead) {
    margin: 14px 6px 4px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  @media (min-width: 768px) {
    h1 {
      font-size: var(--text-2xl);
    }

    .page-head :global(.lead) {
      font-size: var(--text-base);
    }
  }
</style>
