---
/**
 * Top row of a mobile page: the brand (the sun with the name and title, as in the desktop header;
 * owner's review 2026-10-18) or a back link on the left, day/night chip and language switch on the
 * right. The home page uses `none` (the big sun and name are there instead).
 */
import type { Lang } from '../../lib/settings';
import { pathFor } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import SunMark from '../brand/SunMark.astro';
import { getProfile } from '../../lib/settings';
import ThemeToggle from '../ThemeToggle.astro';
import LangSwitch from '../LangSwitch.astro';
import Icon from '../Icon.astro';

interface Common {
  lang: Lang;
  alternatePaths: { tr: string; en: string };
}
/** Left slot: the brand linking home, a back link (needs a target and a name), or nothing. */
type Props =
  | (Common & { left?: 'logo' | 'none'; backHref?: never; backLabel?: never })
  | (Common & { left: 'back'; backHref: string; backLabel: string });
const { lang, alternatePaths, left = 'logo', backHref, backLabel } = Astro.props;
const profile = getProfile();
const title = profile.title[lang].trim();
---

<div class="top-bar">
  {
    left === 'logo' ? (
      <a class="left logo" href={pathFor('home', lang)} aria-label={t(lang, 'homeLink')}>
        <SunMark size={30} />
        <span class="brand-text">
          <span class="brand-name">{profile.name}</span>
          {title && <span class="brand-title">{title}</span>}
        </span>
      </a>
    ) : left === 'back' ? (
      <a class="left back" href={backHref}>
        <Icon name="chevron" size={18} class="back-arrow" />
        <span>{backLabel}</span>
      </a>
    ) : (
      <span class="left"></span>
    )
  }
  <div class="right">
    <ThemeToggle lang={lang} variant="chip" />
    <LangSwitch lang={lang} alternatePaths={alternatePaths} />
  </div>
</div>

<style>
  .top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    padding: var(--space-3) 14px 0;
  }

  .left {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--text);
    text-decoration: none;
  }

  .logo {
    gap: var(--space-2);
    min-width: 0;
  }

  .logo :global(.sun-mark) {
    flex: none;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* On narrow phones the name breaks onto a second line rather than being cut off. */
  .brand-name {
    font-family: var(--font-serif);
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.15;
    text-wrap: balance;
  }

  .brand-title {
    margin-top: 2px;
    overflow: hidden;
    color: var(--muted);
    font-size: 0.6875rem;
    letter-spacing: 0.01em;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .back {
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--link);
  }

  .back :global(.back-arrow) {
    transform: scaleX(-1);
  }

  .right {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
  }
</style>
