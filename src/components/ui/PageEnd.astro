---
/**
 * End of a page: the copyright line. The year is written at build time. With `cookiePrefs` the
 * cookie choice link sits on the same line on phones (the desktop footer shows it next to the legal
 * links instead), so it never adds a row of its own.
 */
import type { Lang } from '../../lib/settings';
import { t } from '../../i18n/ui';

interface Props {
  lang: Lang;
  cookiePrefs?: boolean;
}
const { lang, cookiePrefs = false } = Astro.props;
const year = new Date().getFullYear();
---

<div class="page-end">
  <p class="copy">
    © {year} klinikterapist.com · {t(lang, 'rightsReserved')}
    {cookiePrefs && <span class="mob-prefs"> · <button type="button" data-cookie-prefs>{t(lang, 'cookiePrefs')}</button></span>}
  </p>
</div>

<style>
  .page-end {
    font-size: var(--text-xs);
    text-align: center;
    color: var(--muted);
  }

  .copy {
    margin: 0;
    padding: 14px 0 110px;
    border-top: 1px solid var(--line);
  }

  .mob-prefs button {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  @media (min-width: 768px) {
    .copy {
      padding-bottom: var(--space-5);
    }

    .mob-prefs {
      display: none;
    }
  }
</style>
