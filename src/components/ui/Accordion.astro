---
/** Native <details> box, no JavaScript. `name` makes boxes with the same name open one at a time. */
import Icon from '../Icon.astro';

interface Props {
  title: string;
  subtitle?: string;
  icon?: string;
  name?: string;
  open?: boolean;
  /** Anchor target (e.g. a resources type box). */
  id?: string;
  class?: string;
}
const { title, subtitle, icon, name, open = false, id, class: className } = Astro.props;
---

<details class:list={['acc', className]} id={id} name={name} open={open}>
  <summary>
    {
      icon && (
        <span class="ic">
          <Icon name={icon} size={20} />
        </span>
      )
    }
    <span class="text">
      <b class="title">{title}</b>
      {subtitle && <small class="subtitle">{subtitle}</small>}
    </span>
    <span class="chv" aria-hidden="true"><Icon name="chevron" size={18} /></span>
  </summary>
  <div class="body"><slot /></div>
</details>

<style>
  .acc {
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
  }

  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 14px;
    border-radius: var(--radius-md);
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .ic {
    display: flex;
    color: var(--link);
  }

  .text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
    overflow-wrap: anywhere;
  }

  .title {
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-xs);
    color: var(--muted);
  }

  /* The chevron points down when closed and up when open. */
  .chv {
    display: flex;
    color: var(--muted);
    transform: rotate(90deg);
    transition: transform 0.25s;
  }

  .acc[open] > summary .chv {
    transform: rotate(-90deg);
  }

  /* Same side padding as the summary (14 px), so the answer lines up with the question. */
  .body {
    padding: 0 14px 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .chv {
      transition: none;
    }
  }
</style>
