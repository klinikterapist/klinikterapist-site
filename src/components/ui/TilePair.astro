---
/** Two square-ish tiles side by side; a single tile spans the full width. A tile without `href` is not a link. */
import Icon from '../Icon.astro';

interface Tile {
  title: string;
  href?: string;
  subtitle?: string;
  icon?: string;
}
interface Props {
  tiles: [Tile] | [Tile, Tile];
}
const { tiles } = Astro.props;
---

<div class:list={['tile-pair', { single: tiles.length === 1 }]}>
  {
    tiles.map((tile) => {
      const Tag = tile.href ? 'a' : 'div';
      return (
        <Tag class="tile" href={tile.href}>
          {tile.icon && (
            <span class="ic">
              <Icon name={tile.icon} size={22} />
            </span>
          )}
          <b class="title">{tile.title}</b>
          {tile.subtitle && <small class="subtitle">{tile.subtitle}</small>}
        </Tag>
      );
    })
  }
</div>

<style>
  .tile-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tile-pair.single {
    grid-template-columns: 1fr;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 44px;
    padding: 15px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .ic {
    display: flex;
    color: var(--link);
  }

  .title {
    margin-top: 4px;
    font-weight: 600;
  }

  .subtitle {
    font-size: var(--text-xs);
    color: var(--muted);
  }
</style>
