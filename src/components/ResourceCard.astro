---
/** A recommended resource. `featured` renders the large card with a cover panel. */
import type { Lang, Resource } from '../lib/settings';
import { t, type UiKey } from '../i18n/ui';
import Icon from './Icon.astro';
import Leaf from './Leaf.astro';

interface Props {
  resource: Resource;
  lang: Lang;
  featured?: boolean;
  id?: string;
}
const { resource: r, lang, featured = false, id } = Astro.props;
const typeLabel = t(lang, `type_${r.type}` as UiKey);
const external = /^https?:\/\//.test(r.url);
const linkAttrs = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{
  featured ? (
    <article class="resource featured card" id={id}>
      <div class="cover-panel" aria-hidden="true">
        {r.cover ? (
          <img src={r.cover} alt="" width="160" height="214" loading="lazy" />
        ) : (
          <div class="book">
            <span class="book-title">{r.title}</span>
            <Leaf size={56} class="book-leaf" />
          </div>
        )}
      </div>
      <div class="body">
        <p class="type">
          <Icon name={r.type} size={16} />
          {typeLabel}
        </p>
        <h3 class="title">{r.title}</h3>
        {r.author && <p class="author">{r.author}</p>}
        <p class="note">{r.note[lang]}</p>
        <a class="btn" href={r.url} {...linkAttrs}>
          {t(lang, 'viewResource')}
          {external && <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>}
          <Icon name="external" size={16} />
        </a>
      </div>
    </article>
  ) : (
    <article class="resource row card" id={id}>
      <span class="thumb" aria-hidden="true">
        <Icon name={r.type} size={26} />
      </span>
      <div class="body">
        <p class="type">{typeLabel}</p>
        <h3 class="title">
          <a href={r.url} {...linkAttrs}>
            {r.title}
            {external && <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>}
          </a>
        </h3>
        {r.author && <p class="author">{r.author}</p>}
        <p class="note">{r.note[lang]}</p>
      </div>
      <Icon name="chevron" size={18} class="chev" />
    </article>
  )
}

<style>
  .resource {
    position: relative;
    scroll-margin-top: var(--space-5);
  }

  .type {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .title {
    margin: 0 0 var(--space-1);
    font-size: 1.0625rem;
    line-height: 1.3;
  }

  .author {
    margin: 0 0 var(--space-2);
    color: var(--link);
    font-family: var(--font-serif);
    font-size: var(--text-sm);
  }

  .note {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  /* Featured */
  .featured {
    display: grid;
    grid-template-columns: minmax(96px, 34%) 1fr;
    gap: var(--space-4);
    padding: var(--space-4);
  }

  .featured .body {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .featured .title {
    font-size: var(--text-lg);
  }

  .featured .note {
    margin-bottom: var(--space-4);
  }

  .cover-panel img,
  .book {
    width: 100%;
    aspect-ratio: 3 / 4;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .book {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--space-3);
    overflow: hidden;
    background: linear-gradient(150deg, var(--surface) 0%, var(--surface-2) 100%);
    box-shadow: inset 6px 0 0 var(--line), var(--shadow-soft);
  }

  .book-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--link);
    font-family: var(--font-serif);
    font-size: 0.75rem;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
  }

  .book :global(.book-leaf) {
    align-self: flex-end;
    width: 55%;
    height: auto;
    color: var(--link);
    opacity: 0.6;
  }

  .featured .btn {
    align-self: flex-start;
    white-space: normal;
  }

  /* Row */
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    transition: border-color 0.15s ease;
  }

  .row:hover {
    border-color: var(--link);
  }

  .thumb {
    display: grid;
    flex: none;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    color: var(--link);
  }

  .row .body {
    flex: 1;
    min-width: 0;
  }

  .row .title a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole row is clickable through the title link. */
  .row .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .row .title a:hover {
    color: var(--link);
  }

  .row:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  .row .title a:focus-visible {
    outline: none;
  }

  .row :global(.chev) {
    flex: none;
    color: var(--muted);
  }

  @media (max-width: 420px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .cover-panel {
      max-width: 140px;
    }
  }
</style>
