---
import type { About, Lang } from '../lib/settings';

interface Props {
  lang: Lang;
  items: About['timeline'];
}
const { lang, items } = Astro.props;
---

<ol class="timeline">
  {
    items.map((item) => (
      <li class="item">
        <span class="dot" aria-hidden="true" />
        <div class="body">
          <h3 class="title">{item.title[lang]}</h3>
          <p class="detail">{item.detail[lang]}</p>
        </div>
        <p class="period">{item.period}</p>
      </li>
    ))
  }
</ol>

<style>
  .timeline {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0 var(--space-4);
    padding: 0 0 var(--space-5) var(--space-6);
  }

  .item::before {
    content: '';
    position: absolute;
    top: 0.6rem;
    bottom: -0.6rem;
    left: 5px;
    width: 1px;
    background: var(--line);
  }

  .item:last-child::before {
    display: none;
  }

  .dot {
    position: absolute;
    top: 0.45rem;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--forest);
    box-shadow: 0 0 0 4px var(--cream);
  }

  .title {
    margin: 0;
    font-family: var(--font-sans);
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: 0;
  }

  .detail,
  .period {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .period {
    padding-top: 0.15rem;
    white-space: nowrap;
  }

  @media (max-width: 480px) {
    .item {
      grid-template-columns: 1fr;
    }

    .period {
      grid-row: 1;
      padding: 0;
      font-size: var(--text-xs);
    }
  }
</style>
