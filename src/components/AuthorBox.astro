---
/**
 * Author box at the end of a post (spec §5.8): centred; the photo (optimised) or the sun, the name,
 * "title · membership" (the membership only when one is set), the short intro and "Randevu Al".
 */
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import RoundPortrait from './ui/RoundPortrait.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = getProfile();
// One line: the explicit short intro; the full intro when none is set.
const intro = (profile.shortIntro?.[lang].trim() || profile.intro[lang]).trim();
const org = profile.memberships?.map((m) => m.org[lang].trim()).find(Boolean);
const role = [profile.title[lang].trim(), org ? t(lang, 'memberOf').replace('{org}', org) : ''].filter(Boolean).join(' · ');
---

<aside class="author-box" aria-labelledby="author-name">
  <RoundPortrait photo={profile.photo} alt={profile.photoAlt[lang]} size={72} />
  <p class="name" id="author-name">{profile.name}</p>
  {role && <p class="role">{role}</p>}
  {intro && <p class="intro">{intro}</p>}
  <a class="cta" href={pathFor('appointment', lang)}>
    <Icon name="calendar" size={18} />
    {t(lang, 'bookSession')}
  </a>
</aside>

<style>
  .author-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 18px;
    border-radius: 16px;
    background: var(--surface);
    text-align: center;
  }

  .author-box p {
    margin: 0;
  }

  .name {
    margin-top: 6px !important;
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    font-weight: 500;
    font-variation-settings: 'SOFT' 100;
  }

  .role {
    color: var(--muted);
    font-size: 0.78125rem;
  }

  .intro {
    margin: 6px 0 10px !important;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .cta {
    display: flex;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 13px;
    border-radius: var(--radius-md);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-weight: 600;
    text-decoration: none;
  }

  .cta:hover {
    background: var(--btn-bg-hover);
    color: var(--btn-text);
  }
</style>
