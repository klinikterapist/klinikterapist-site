---
/** Author card under a post: photo (or sage placeholder), name, title, one-line intro, link to the about page. */
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Leaf from './Leaf.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = getProfile();
// One line: the explicit short intro; the full intro when none is set.
const intro = profile.shortIntro?.[lang] ?? profile.intro[lang];
---

<aside class="author-box card" aria-labelledby="author-name">
  {
    profile.photo ? (
      <img class="avatar" src={profile.photo} alt={profile.photoAlt[lang]} width="88" height="88" loading="lazy" decoding="async" />
    ) : (
      <div class="avatar placeholder" role="img" aria-label={profile.photoAlt[lang]}>
        <Leaf size={40} />
      </div>
    )
  }
  <div class="info">
    <p class="eyebrow">{t(lang, 'aboutAuthor')}</p>
    <p class="name" id="author-name">{profile.name}</p>
    <p class="title">{profile.title[lang]}</p>
    <p class="intro">{intro}</p>
    <a class="more" href={pathFor('about', lang)}>
      {t(lang, 'moreAboutMe')}
      <Icon name="arrow" size={16} />
    </a>
  </div>
</aside>

<style>
  .author-box {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-4) var(--space-5);
    padding: var(--space-5);
  }

  .avatar {
    flex: none;
    width: 88px;
    height: 88px;
    border-radius: 46% 54% 52% 48% / 55% 48% 52% 45%;
    object-fit: cover;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background: linear-gradient(160deg, var(--surface-2) 0%, var(--surface) 100%);
    color: var(--link);
  }

  .info {
    flex: 1 1 14rem;
    min-width: 0;
  }

  .info p {
    margin: 0;
  }

  .eyebrow {
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .name {
    margin-top: var(--space-1) !important;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .title {
    color: var(--link);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .intro {
    margin-top: var(--space-2) !important;
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }
</style>
