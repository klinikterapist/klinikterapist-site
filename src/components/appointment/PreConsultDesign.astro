    secure: 'Bilgileriniz yalnızca bu görüşme için kullanılır.',
  },
  en: {
    preview: 'Design preview: the request form is not live yet; the days and times shown are examples.',
    steps: ['About you', 'Day and time', 'Your details', 'Confirm'],
    s1: 'About you',
