    mail: 'E-posta',
    phone: 'Telefon',
    age: 'Yaş aralığınız',
    agePick: 'Seçin',
    ages: ['18 yaşından küçük (veli ya da vasi onayıyla)', '18–24', '25–34', '35–44', '45–54', '55 ve üzeri'],
    consentA: 'Aydınlatma metnini',
    consentB: ' okudum.',
    s4: 'Özet ve onay',
    s4Hint: 'Bilgilerinizi kontrol edin; talebiniz bana e-postayla ulaşır, size dönüş yaparım.',
    summary: 'Ön görüşme özeti',
