---
/**
 * The free intro call request design (owner's review 2026-10-19, item 3): the same step-by-step form
 * as the booking design (wizard.ts), for the intro call only. Steps: what brings you (who it is for,
 * the topics, earlier support, a short note), a weekend day and time (intro calls are on Saturdays
 * and Sundays only, 25–30 minutes), your details (name, e-mail, phone and age range are required),
 * confirm. The calendar shows the free times of booking.json and the last button sends the request
 * (booking-submit.ts, `booking.request`). Picked topics are health-related, so an explicit consent box
 * is required (wording waits for the owner's approval). Shown on the dev server (or with
 * `BOOKING_DESIGN=1`) only (PreConsultView).
 */
import type { Lang } from '../../lib/settings';
import { getBooking, getProfile } from '../../lib/settings';
import { ADMIN_CONFIG, MOCK_API_URL } from '../../admin/config';
import { AGE_RANGES, INTRO_FOR, INTRO_TOPICS, SESSION_TYPES, TYPE_BADGES, typeState } from '../../lib/booking-form';
import { pathFor } from '../../i18n/routes';
import Icon from '../Icon.astro';
import RoundPortrait from '../ui/RoundPortrait.astro';
import WaitlistForm from './WaitlistForm.astro';
import PhoneField from './PhoneField.astro';
import DoneCard from './DoneCard.astro';
import { COUNTRIES } from '../../lib/phone';
import { FORM_TEXT } from './form-text';
import './wizard.css';

interface Props {
  lang: Lang;
  email: string;
}
const { lang, email } = Astro.props;
const profile = getProfile();
const role = profile.title[lang].trim();
const endpoint = ADMIN_CONFIG.apiUrl && ADMIN_CONFIG.apiUrl !== MOCK_API_URL ? ADMIN_CONFIG.apiUrl : undefined;
const booking = getBooking();
const config = JSON.stringify(booking);

const T = {
  tr: {
    preview: 'Önizleme: bu form yalnızca önizlemede görünür. Panel adresi tanımlıysa talep gerçekten gönderilir.',
    healthConsent: 'Seçtiğim konuların ve yazdığım notun, ön görüşmeyi hazırlamak amacıyla Klinik Psikolog Osman Güneş Özkurt’a e-postayla iletilmesine açık rıza veriyorum.',
    sending: 'Gönderiliyor…',
    invalid: 'Bazı bilgiler eksik ya da hatalı. Lütfen önceki adımlara dönüp kontrol edin.',
    taken: 'Seçtiğiniz saat artık uygun değil. Lütfen takvimden başka bir saat seçin.',
    failed: 'Talep gönderilemedi. Lütfen biraz sonra tekrar deneyin ya da e-posta ile yazın.',
    steps: ['Sizi tanıyalım', 'Gün ve saat', 'Bilgileriniz', 'Onay'],
    s1: 'Sizi tanıyalım',
    s1Hint: 'Birkaç kısa soru. Ayrıntıları görüşmede konuşacağız; burada yalnızca genel bir fikir edinmek istiyorum.',
    forWhom: 'Görüşme kimin için?',
    me: 'Kendim için',
    meText: 'Bireysel terapiyi düşünüyorum.',
    couple: 'Eş veya partnerimle birlikte',
    coupleText: 'Aile ve çift terapisini düşünüyoruz.',
    access: 'Kendim için, uygun ücretle',
    accessText: 'Öğrenciyim ya da ekonomik durumum şu an elverişli değil; erişilebilir terapiyi düşünüyorum.',
    group: 'Bir gruba katılmak istiyorum',
    groupText: 'Benzer konularla gelen küçük bir grupla birlikte çalışmayı düşünüyorum.',
    face: 'Yüz yüze görüşmek istiyorum',
    faceText: 'Şu an yalnızca online görüşme yapıyorum.',
    faceOnText: 'Yüz yüze terapiyi düşünüyorum.',
    groupOnText: 'Grup terapisini düşünüyorum.',
    reasons: 'Terapide üzerinde çalışmak istediğiniz konular neler?',
    reasonsHint: 'Birden fazla seçebilirsiniz. Emin değilseniz son seçeneği işaretlemeniz yeterli.',
    before: 'Daha önce psikolojik destek aldınız mı?',
    yes: 'Evet',
    no: 'Hayır',
    note: 'Kısaca eklemek istediğiniz bir şey var mı? (isteğe bağlı)',
    noteHint: 'Bir iki cümle yeterli; sağlığınızla ilgili ayrıntıları görüşmede konuşuruz.',
    s2: 'Gün ve saat seçin',
    s2Hint: 'Ön görüşmeler yalnızca cumartesi ve pazar günleri yapılır ve 25–30 dakika sürer.',
    tz: 'Saatler Türkiye saatiyle (GMT+3) gösterilir.',
    prev: 'Önceki ay',
    next: 'Sonraki ay',
    week: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'],
    pickDay: 'Takvimden bir gün seçin.',
    s3: 'Bilgileriniz',
    s3Hint: 'Yıldızlı alanlar zorunludur. Görüşme bağlantısını e-postayla gönderirim.',
    name: 'Ad soyad',
    mail: 'E-posta',
    phone: 'Telefon',
    age: 'Yaş aralığınız',
    agePick: 'Seçin',
    country: 'Nerede yaşıyorsunuz?',
    consentA: 'Aydınlatma metnini',
    consentB: ' okudum.',
    s4: 'Özet ve onay',
    s4Hint: 'Bilgilerinizi kontrol edin; talebiniz bana e-postayla ulaşır, size dönüş yaparım.',
    summary: 'Ön görüşme özeti',
    type: 'Görüşme',
    intro: 'Ücretsiz ön görüşme',
    introMeta: '25–30 dakika · Online',
    forLabel: 'Kimin için',
    topicLabel: 'Konu',
    when: 'Tarih',
    time: 'Saat',
    you: 'İletişim',
    place: 'Yer',
    placeValue: 'Online (bağlantı e-postayla gönderilir)',
    price: 'Ücret',
    free: 'Ücretsiz',
    back: 'Geri',
    cont: 'Devam',
    edit: 'Bilgileri düzenle',
    submit: 'Ön görüşme talebini gönder',
    soonMail: 'Talep formu çok yakında açılıyor. Şimdilik e-posta ile yazabilirsiniz:',
    noObligation: 'Ön görüşmeden sonra devam etme zorunluluğunuz yoktur.',
    secure: 'Bilgileriniz yalnızca bu görüşme için kullanılır.',
  },
  en: {
    preview: 'Preview: this form shows in the preview only. With the panel address set, the request is really sent.',
    healthConsent: 'I give my explicit consent for the topics I chose and my note to be sent by e-mail to Clinical Psychologist Osman Güneş Özkurt to prepare the intro call.',
    sending: 'Sending…',
    invalid: 'Some details are missing or wrong. Please go back and check the earlier steps.',
    taken: 'The time you chose is no longer free. Please pick another time in the calendar.',
    failed: 'The request could not be sent. Please try again a little later or write by e-mail.',
    steps: ['About you', 'Day and time', 'Your details', 'Confirm'],
    s1: 'About you',
    s1Hint: 'A few short questions. We will talk about the details in the call; here I only want a general picture.',
    forWhom: 'Who is the call for?',
    me: 'For myself',
    meText: 'I am thinking of individual therapy.',
    couple: 'With my spouse or partner',
    coupleText: 'We are thinking of family and couples therapy.',
    access: 'For myself, at a reduced fee',
    accessText: 'I am a student or money is tight for me right now; I am thinking of accessible therapy.',
    group: 'I would like to join a group',
    groupText: 'I am thinking of working together with a small group who come with similar topics.',
    face: 'I would like to meet face to face',
    faceText: 'For now I only work online.',
    faceOnText: 'I am thinking of face-to-face therapy.',
    groupOnText: 'I am thinking of group therapy.',
    reasons: 'What would you like to work on in therapy?',
    reasonsHint: 'You can choose more than one. If you are not sure, the last option is enough.',
    before: 'Have you had psychological support before?',
    yes: 'Yes',
    no: 'No',
    note: 'Anything short you would like to add? (optional)',
    noteHint: 'A sentence or two is enough; we will talk about health details in the call.',
    s2: 'Choose a day and time',
    s2Hint: 'Intro calls are held on Saturdays and Sundays only and last 25–30 minutes.',
    tz: 'Times are shown in Turkey time (GMT+3).',
    prev: 'Previous month',
    next: 'Next month',
    week: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    pickDay: 'Pick a day in the calendar.',
    s3: 'Your details',
    s3Hint: 'Fields with a star are required. I send the call link by e-mail.',
    name: 'Full name',
    mail: 'E-mail',
    phone: 'Phone',
    age: 'Your age range',
    agePick: 'Choose',
    country: 'Where do you live?',
    consentA: 'I have read the ',
    consentB: 'privacy notice.',
    s4: 'Summary and confirm',
    s4Hint: 'Check your details; your request reaches me by e-mail and I get back to you.',
    summary: 'Intro call summary',
    type: 'Session',
    intro: 'Free intro call',
    introMeta: '25–30 minutes · Online',
    forLabel: 'For',
    topicLabel: 'Topic',
    when: 'Date',
    time: 'Time',
    you: 'Contact',
    place: 'Where',
    placeValue: 'Online (link sent by e-mail)',
    price: 'Fee',
    free: 'Free',
    back: 'Back',
    cont: 'Continue',
    edit: 'Edit details',
    submit: 'Send intro call request',
    soonMail: 'The request form opens very soon. For now, you can write by e-mail:',
    noObligation: 'You are under no obligation to continue after the intro call.',
    secure: 'Your details are used only for this call.',
  },
}[lang];
const notice = pathFor('privacyNotice', lang);
const F = FORM_TEXT[lang];
const messages = JSON.stringify({ sending: T.sending, invalid: T.invalid, taken: T.taken, failed: T.failed, mismatch: F.mismatch, emailDomain: F.emailDomain });

// "Görüşme kimin için?": one choice per session type that has an intro call, offered while that type
// is (Ayarlar › Randevu Ayarları, owner's reviews 2026-10-23). A closed one stays, faded, with
// "Kontenjan Doldu" or "Şu an uygun değil", unless the owner chose to hide it.
const FOR_TEXT: Record<(typeof INTRO_FOR)[number]['id'], { label: string; text: string; onText?: string }> = {
  individual: { label: T.me, text: T.meText },
  couple: { label: T.couple, text: T.coupleText },
  accessible: { label: T.access, text: T.accessText },
  group: { label: T.group, text: T.groupText, onText: T.groupOnText },
  face: { label: T.face, text: T.faceText, onText: T.faceOnText },
};
const forWhom = INTRO_FOR.map((f) => {
  const state = typeState(booking, f.id);
  const on = state === 'on';
  const look = FOR_TEXT[f.id];
  const quota = SESSION_TYPES.some((t) => t.id === f.id && t.quota);
  return { id: f.id, on, state, quota, label: look.label, text: on ? (look.onText ?? look.text) : look.text };
}).filter((x) => x.state !== 'hidden');
const firstOn = forWhom.findIndex((x) => x.on);
---

<div class="wz preconsult" data-preconsult data-preview={import.meta.env.DEV ? "1" : undefined} data-lang={lang} data-kind="intro" data-config={config} data-endpoint={endpoint} data-messages={messages}>
  <WaitlistForm lang={lang} kind="intro" email={email} />
  {
    /* Dev server only: the live site shows the form without the note. */
    import.meta.env.DEV && (
      <p class="preview-note" role="note" data-hide-on-done>
        <Icon name="alert" size={16} />
        {T.preview}
      </p>
    )
  }

  <ol class="stepper" data-hide-on-done>
    {
      T.steps.map((s, i) => (
        <li data-step-dot={i + 1} class:list={[{ 'is-current': i === 0 }]}>
          <button type="button" tabindex="-1">
            <span class="dot">{i + 1}</span>
            <span class="step-label">{s}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="wz-grid">
    <div class="wz-main">
      <section class="card" data-step="1" data-need="group:topics" aria-labelledby="pc-s1">
        <h2 id="pc-s1">{T.s1}</h2>
        <p class="card-hint">{T.s1Hint}</p>

        <p class="q" id="pc-for">{T.forWhom} <span class="req" aria-hidden="true">*</span></p>
        <div class="types" role="radiogroup" aria-labelledby="pc-for">
          {
            forWhom.map((x, i) => (
              <label class:list={['type', { 'is-off': !x.on }]}>
                {x.on ? <input type="radio" name="forWhom" value={x.id} data-sum-src="for" data-label={x.label} checked={i === firstOn} /> : <input type="radio" name="forWhom" value={x.id} disabled />}
                <span class="type-body">
                  <span class="type-top">
                    <b>{x.label}</b>
                    {!x.on && <span class:list={['badge', x.state === 'full' ? 'badge-full' : 'badge-soon']}>{TYPE_BADGES[x.state === 'full' ? 'full' : 'off'][lang]}</span>}
                    {x.on && x.quota && <span class="badge badge-quota">{TYPE_BADGES.quota[lang]}</span>}
                  </span>
                  <span class="type-text">{x.text}</span>
                </span>
              </label>
            ))
          }
        </div>

        <p class="q" id="pc-topics">{T.reasons} <span class="req" aria-hidden="true">*</span></p>
        <p class="card-hint">{T.reasonsHint}</p>
        <div class="chips" role="group" aria-labelledby="pc-topics">
          {
            INTRO_TOPICS[lang].map((topic, i) => (
              <label class="chip">
                <input type="checkbox" name="topics" value={i} data-sum-src="topic" data-label={topic} />
                <span>{topic}</span>
              </label>
            ))
          }
        </div>

        <p class="q" id="pc-before">{T.before}</p>
        <div class="chips" role="radiogroup" aria-labelledby="pc-before">
          <label class="chip"><input type="radio" name="before" value="yes" /><span>{T.yes}</span></label>
          <label class="chip"><input type="radio" name="before" value="no" /><span>{T.no}</span></label>
        </div>

        <label class="field note">
          <span>{T.note}</span>
          <textarea name="note" rows="3" maxlength="500"></textarea>
          <small>{T.noteHint}</small>
        </label>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="2" data-need="slot" aria-labelledby="pc-s2" hidden>
        <h2 id="pc-s2">{T.s2}</h2>
        <p class="card-hint weekend"><Icon name="calendar" size={16} />{T.s2Hint}</p>
        <div class="when">
          <div class="calendar">
            <div class="cal-head">
              <button type="button" class="cal-nav" data-cal-prev aria-label={T.prev}>
                <Icon name="chevron" size={18} class="flip" />
              </button>
              <b data-cal-title aria-live="polite"></b>
              <button type="button" class="cal-nav" data-cal-next aria-label={T.next}>
                <Icon name="chevron" size={18} />
              </button>
            </div>
            <div class="cal-week" aria-hidden="true">{T.week.map((d) => <span>{d}</span>)}</div>
            <div class="cal-days" data-cal-days></div>
            <ul class="cal-note" data-cal-note hidden></ul>
          </div>
          <div class="slots">
            <p class="slots-title" data-slots-title>{T.pickDay}</p>
            <div class="slot-list" data-slots role="radiogroup" aria-labelledby="pc-s2"></div>
            <p class="tz"><Icon name="globe" size={14} />{T.tz}</p>
          </div>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="3" aria-labelledby="pc-s3" hidden>
        <h2 id="pc-s3">{T.s3}</h2>
        <p class="card-hint">{T.s3Hint}</p>
        <div class="fields">
          <label class="field">
            <span>{T.name} <span class="req" aria-hidden="true">*</span></span>
            <input type="text" name="name" autocomplete="name" required maxlength="100" data-sum-src="name" />
          </label>
          <label class="field">
            <span>{T.age} <span class="req" aria-hidden="true">*</span></span>
            <select name="age" required>
              <option value="">{T.agePick}</option>
              {AGE_RANGES[lang].map((a, i) => <option value={i}>{a}</option>)}
            </select>
          </label>
          <label class="field">
            <span>{T.country} <span class="req" aria-hidden="true">*</span></span>
            <select name="country" required data-country>
              <option value="">{T.agePick}</option>
              {COUNTRIES.map((c) => <option value={c.id}>{c[lang]}</option>)}
            </select>
          </label>
          <label class="field">
            <span>{T.mail} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" data-sum-src="contact" data-email />
            <small class="email-hint" data-email-hint hidden></small>
          </label>
          <label class="field">
            <span>{F.mail2} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email2" autocomplete="off" inputmode="email" required maxlength="254" data-email-again />
            <small class="email-hint is-error" data-email-mismatch hidden></small>
          </label>
          <PhoneField lang={lang} name="phone" label={T.phone} sum="contact" />
          <label class="hp" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="hp_field" tabindex="-1" autocomplete="off" />
          </label>
          <label class="consent field-wide">
            <input type="checkbox" name="healthConsent" value="1" required />
            <span>{T.healthConsent} <span class="req" aria-hidden="true"> *</span></span>
          </label>
          <label class="consent field-wide">
            <input type="checkbox" name="consent" value="1" required />
            <span>
              {lang === 'tr' ? <><a href={notice}>{T.consentA}</a>{T.consentB}</> : <>{T.consentA}<a href={notice}>{T.consentB}</a></>}
              <span class="req" aria-hidden="true"> *</span>
            </span>
          </label>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="4" aria-labelledby="pc-s4" data-hide-on-done hidden>
        <h2 id="pc-s4">{T.s4}</h2>
        <p class="card-hint">{T.s4Hint}</p>
        <div class="summary-card">
          <div class="who">
            <RoundPortrait photo={profile.photo} alt="" size={52} />
            <span>
              <b>{profile.name}</b>
              {role && <small>{role}</small>}
            </span>
          </div>
          <dl>
            <div><dt><Icon name="talk" size={16} />{T.type}</dt><dd>{T.intro}<small>{T.introMeta}</small></dd></div>
            <div><dt><Icon name="users" size={16} />{T.forLabel}</dt><dd data-sum="for"></dd></div>
            <div><dt><Icon name="tag" size={16} />{T.topicLabel}</dt><dd data-sum="topic"></dd></div>
            <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
            <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
            <div><dt><Icon name="user" size={16} />{T.name}</dt><dd data-sum="name"></dd></div>
            <div><dt><Icon name="mail" size={16} />{T.you}</dt><dd data-sum="contact"></dd></div>
            <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
            <div class="total"><dt>{T.price}</dt><dd>{T.free}</dd></div>
          </dl>
          <button type="button" class="submit" disabled aria-describedby="pc-soon" data-submit>
            <Icon name="send" size={18} />
            {T.submit}
          </button>
          <p class="step-error" data-submit-error role="alert" tabindex="-1" hidden></p>
          <p class="soon" id="pc-soon" data-soon>{T.soonMail} <a href={`mailto:${email}`}>{email}</a></p>
          <button type="button" class="edit-link" data-goto="1">{T.edit}</button>
          <ul class="assure">
            <li><Icon name="heart" size={15} />{T.noObligation}</li>
            <li><Icon name="shield" size={15} />{T.secure}</li>
          </ul>
        </div>
      </section>

      <DoneCard lang={lang} kind="intro" id="pc-done" />

      <div class="wz-nav" data-nav>
        <button type="button" class="wz-back" data-back hidden><Icon name="arrow" size={18} />{T.back}</button>
        <button type="button" class="wz-next" data-next><span data-next-label>{T.cont}</span><Icon name="arrow" size={18} /></button>
      </div>
    </div>

    <aside class="summary" aria-labelledby="pc-sum">
      <div class="summary-card">
        <div class="who">
          <RoundPortrait photo={profile.photo} alt="" size={52} />
          <span>
            <b>{profile.name}</b>
            {role && <small>{role}</small>}
          </span>
        </div>
        <h2 id="pc-sum">{T.summary}</h2>
        <dl>
          <div><dt><Icon name="talk" size={16} />{T.type}</dt><dd>{T.intro}<small>{T.introMeta}</small></dd></div>
          <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
          <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
          <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
          <div class="total"><dt>{T.price}</dt><dd>{T.free}</dd></div>
        </dl>
        <ul class="assure">
          <li><Icon name="heart" size={15} />{T.noObligation}</li>
          <li><Icon name="shield" size={15} />{T.secure}</li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<script>
  import { mountBookingForm } from './booking-submit';

  for (const root of document.querySelectorAll<HTMLElement>('[data-preconsult]')) mountBookingForm(root);
</script>

<style>
  .note {
    margin-top: var(--space-5);
  }

  .weekend {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 12px;
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--sun-halo) 16%, transparent);
    color: var(--text);
  }

  .weekend :global(svg) {
    flex: none;
  }
</style>
