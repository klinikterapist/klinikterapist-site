---
/**
 * The booking page design (owner's review 2026-10-19, item 12): how "Randevu Al" will look once the
 * booking system exists. Four steps (session type, date and time, your details, confirm) beside a
 * summary card. Only the look: the available days and times are made up in the browser, and the
 * last button sends nothing. Shown on the dev server (or with `BOOKING_DESIGN=1`) only
 * (AppointmentView); the live site keeps the e-mail page until the booking backend is built.
 */
import type { Lang } from '../../lib/settings';
import { getProfile } from '../../lib/settings';
import { pathFor } from '../../i18n/routes';
import Icon from '../Icon.astro';
import RoundPortrait from '../ui/RoundPortrait.astro';

interface Props {
  lang: Lang;
  email: string;
}
const { lang, email } = Astro.props;
const profile = getProfile();
const role = profile.title[lang].trim();

const T = {
  tr: {
    lead: 'Önce 25 dakikalık ücretsiz bir ön görüşmeyle tanışalım. Size uygun günü ve saati seçin; onay e-postası gelsin.',
    preview: 'Tasarım önizlemesi: randevu sistemi henüz çalışmıyor, gösterilen gün ve saatler örnektir.',
    steps: ['Görüşme', 'Tarih ve saat', 'Bilgileriniz', 'Onay'],
    s1: 'Görüşme türünü seçin',
    intro: 'Ücretsiz ön görüşme',
    introMeta: '25 dakika · Online',
    introText: 'Tanışma ve ön değerlendirme: sizi neyin getirdiğini dinlerim, çalışma biçimimi anlatırım, birlikte karar veririz.',
    introBadge: 'İlk adım',
    free: 'Ücretsiz',
    therapy: 'Bireysel terapi seansı',
    therapyMeta: '50 dakika · Online',
    therapyText: 'Ön görüşmeden sonra devam eden danışanlar için düzenli seans.',
    therapyPrice: 'Ücret ön görüşmede',
    s2: 'Gün ve saat seçin',
    tz: 'Saatler Türkiye saatiyle (GMT+3) gösterilir.',
    prev: 'Önceki ay',
    next: 'Sonraki ay',
    week: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'],
    pickDay: 'Takvimden bir gün seçin.',
    noSlots: 'Bu gün için boş saat yok.',
    slotsFor: 'için boş saatler',
    s3: 'Bilgileriniz',
    name: 'Ad soyad',
    mail: 'E-posta',
    phone: 'Telefon (isteğe bağlı)',
    note: 'Sizi neyin getirdiğini kısaca yazabilirsiniz (isteğe bağlı)',
    noteHint: 'Sağlık durumunuza ilişkin ayrıntıları burada paylaşmayın; bunları görüşmede konuşuruz.',
    consentA: 'Aydınlatma metnini',
    consentB: ' okudum.',
    s4: 'Özet ve onay',
    summary: 'Randevu özeti',
    type: 'Görüşme',
    when: 'Tarih',
    time: 'Saat',
    notChosen: 'Seçilmedi',
    place: 'Yer',
    online: 'Online (bağlantı e-postayla gönderilir)',
    price: 'Ücret',
    submit: 'Randevu talebini gönder',
    soon: 'Online randevu sistemi çok yakında açılıyor. Şimdilik e-posta ile yazabilirsiniz:',
    reminders: 'Randevudan bir gün önce hatırlatma e-postası gelir. Değişiklik ve iptal için en az 24 saat önce haber vermeniz yeterli.',
    secure: 'Bilgileriniz yalnızca randevunuz için kullanılır.',
  },
  en: {
    lead: "Let's start with a free 25-minute intro call. Pick a day and time that suit you; a confirmation e-mail follows.",
    preview: 'Design preview: the booking system is not live yet; the days and times shown are examples.',
    steps: ['Session', 'Date and time', 'Your details', 'Confirm'],
    s1: 'Choose a session type',
    intro: 'Free intro call',
    introMeta: '25 minutes · Online',
    introText: 'Getting to know each other: I listen to what brings you here, explain how I work, and we decide together.',
    introBadge: 'First step',
    free: 'Free',
    therapy: 'Individual therapy session',
    therapyMeta: '50 minutes · Online',
    therapyText: 'Regular sessions for clients who continue after the intro call.',
    therapyPrice: 'Fee discussed in the intro call',
    s2: 'Choose a day and time',
    tz: 'Times are shown in Turkey time (GMT+3).',
    prev: 'Previous month',
    next: 'Next month',
    week: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    pickDay: 'Pick a day in the calendar.',
    noSlots: 'No free times on this day.',
    slotsFor: '– free times',
    s3: 'Your details',
    name: 'Full name',
    mail: 'E-mail',
    phone: 'Phone (optional)',
    note: 'You may briefly say what brings you here (optional)',
    noteHint: 'Please do not share health details here; we will talk about them in the session.',
    consentA: 'I have read the ',
    consentB: 'privacy notice.',
    s4: 'Summary and confirm',
    summary: 'Booking summary',
    type: 'Session',
    when: 'Date',
    time: 'Time',
    notChosen: 'Not chosen',
    place: 'Where',
    online: 'Online (link sent by e-mail)',
    price: 'Fee',
    submit: 'Send booking request',
    soon: 'The online booking system opens very soon. For now, you can write by e-mail:',
    reminders: 'A reminder e-mail arrives a day before. To change or cancel, letting me know 24 hours ahead is enough.',
    secure: 'Your details are used only for your appointment.',
  },
}[lang];
const notice = pathFor('privacyNotice', lang);
---

<div class="booking" data-booking data-lang={lang}>
  <p class="preview-note" role="note">
    <Icon name="alert" size={16} />
    {T.preview}
  </p>
  <p class="booking-lead">{T.lead}</p>

  <ol class="stepper" aria-label={T.steps.join(', ')}>
    {
      T.steps.map((s, i) => (
        <li data-step-dot={i + 1} class:list={[{ 'is-current': i === 0 }]}>
          <span class="dot">{i + 1}</span>
          <span class="step-label">{s}</span>
        </li>
      ))
    }
  </ol>

  <div class="booking-grid">
    <div class="booking-main">
      <section class="card" aria-labelledby="bk-s1">
        <h2 id="bk-s1"><span class="num">1</span>{T.s1}</h2>
        <div class="types" role="radiogroup" aria-labelledby="bk-s1">
          <label class="type">
            <input type="radio" name="bk-type" value="intro" data-label={T.intro} data-meta={T.introMeta} data-price={T.free} checked />
            <span class="type-body">
              <span class="type-top">
                <b>{T.intro}</b>
                <span class="badge badge-sun">{T.introBadge}</span>
              </span>
              <span class="type-meta">
                <Icon name="clock" size={15} />
                {T.introMeta}
              </span>
              <span class="type-text">{T.introText}</span>
            </span>
            <span class="type-price free">{T.free}</span>
          </label>
          <label class="type">
            <input type="radio" name="bk-type" value="therapy" data-label={T.therapy} data-meta={T.therapyMeta} data-price={T.therapyPrice} />
            <span class="type-body">
              <span class="type-top"><b>{T.therapy}</b></span>
              <span class="type-meta">
                <Icon name="clock" size={15} />
                {T.therapyMeta}
              </span>
              <span class="type-text">{T.therapyText}</span>
            </span>
            <span class="type-price">{T.therapyPrice}</span>
          </label>
        </div>
      </section>

      <section class="card" aria-labelledby="bk-s2">
        <h2 id="bk-s2"><span class="num">2</span>{T.s2}</h2>
        <div class="when">
          <div class="calendar">
            <div class="cal-head">
              <button type="button" class="cal-nav" data-cal-prev aria-label={T.prev}>
                <Icon name="chevron" size={18} class="flip" />
              </button>
              <b data-cal-title aria-live="polite"></b>
              <button type="button" class="cal-nav" data-cal-next aria-label={T.next}>
                <Icon name="chevron" size={18} />
              </button>
            </div>
            <div class="cal-week" aria-hidden="true">{T.week.map((d) => <span>{d}</span>)}</div>
            <div class="cal-days" data-cal-days role="grid"></div>
          </div>
          <div class="slots">
            <p class="slots-title" data-slots-title>{T.pickDay}</p>
            <div class="slot-list" data-slots role="radiogroup" aria-labelledby="bk-s2"></div>
            <p class="tz">
              <Icon name="globe" size={14} />
              {T.tz}
            </p>
          </div>
        </div>
      </section>

      <section class="card" aria-labelledby="bk-s3">
        <h2 id="bk-s3"><span class="num">3</span>{T.s3}</h2>
        <div class="fields">
          <label class="field">
            <span>{T.name}</span>
            <input type="text" autocomplete="name" data-field-name />
          </label>
          <label class="field">
            <span>{T.mail}</span>
            <input type="email" autocomplete="email" />
          </label>
          <label class="field">
            <span>{T.phone}</span>
            <input type="tel" autocomplete="tel" />
          </label>
          <label class="field field-wide">
            <span>{T.note}</span>
            <textarea rows="3"></textarea>
            <small>{T.noteHint}</small>
          </label>
          <label class="consent field-wide">
            <input type="checkbox" />
            <span>
              {lang === 'tr' ? <><a href={notice}>{T.consentA}</a>{T.consentB}</> : <>{T.consentA}<a href={notice}>{T.consentB}</a></>}
            </span>
          </label>
        </div>
      </section>
    </div>

    <aside class="summary" aria-labelledby="bk-sum">
      <div class="summary-card">
        <div class="who">
          <RoundPortrait photo={profile.photo} alt="" size={52} />
          <span>
            <b>{profile.name}</b>
            {role && <small>{role}</small>}
          </span>
        </div>
        <h2 id="bk-sum">{T.summary}</h2>
        <dl>
          <div>
            <dt><Icon name="chat" size={16} />{T.type}</dt>
            <dd data-sum-type>{T.intro}<small>{T.introMeta}</small></dd>
          </div>
          <div>
            <dt><Icon name="calendar" size={16} />{T.when}</dt>
            <dd data-sum-day class="muted">{T.notChosen}</dd>
          </div>
          <div>
            <dt><Icon name="clock" size={16} />{T.time}</dt>
            <dd data-sum-time class="muted">{T.notChosen}</dd>
          </div>
          <div>
            <dt><Icon name="laptop" size={16} />{T.place}</dt>
            <dd>{T.online}</dd>
          </div>
          <div class="total">
            <dt>{T.price}</dt>
            <dd data-sum-price>{T.free}</dd>
          </div>
        </dl>
        <button type="button" class="submit" disabled aria-describedby="bk-soon">
          <Icon name="send" size={18} />
          {T.submit}
        </button>
        <p class="soon" id="bk-soon">
          {T.soon} <a href={`mailto:${email}`}>{email}</a>
        </p>
        <ul class="assure">
          <li><Icon name="clock" size={15} />{T.reminders}</li>
          <li><Icon name="shield" size={15} />{T.secure}</li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<script>
  // Design preview only: made-up availability, drawn in the browser. Nothing is sent anywhere.
  for (const root of document.querySelectorAll<HTMLElement>('[data-booking]')) {
    const lang = root.dataset.lang === 'en' ? 'en' : 'tr';
    const locale = lang === 'en' ? 'en-GB' : 'tr-TR';
    const t = {
      pick: lang === 'en' ? 'Pick a day in the calendar.' : 'Takvimden bir gün seçin.',
      none: lang === 'en' ? 'No free times on this day.' : 'Bu gün için boş saat yok.',
      notChosen: lang === 'en' ? 'Not chosen' : 'Seçilmedi',
    };
    const q = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const days = q<HTMLElement>('[data-cal-days]');
    const title = q<HTMLElement>('[data-cal-title]');
    const slots = q<HTMLElement>('[data-slots]');
    const slotsTitle = q<HTMLElement>('[data-slots-title]');
    const sumDay = q<HTMLElement>('[data-sum-day]');
    const sumTime = q<HTMLElement>('[data-sum-time]');
    const sumType = q<HTMLElement>('[data-sum-type]');
    const sumPrice = q<HTMLElement>('[data-sum-price]');
    const cap = (s: string) => s.charAt(0).toLocaleUpperCase(locale) + s.slice(1);
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    let month = new Date(today.getFullYear(), today.getMonth(), 1);
    let chosen: Date | null = null;

    const dots = root.querySelectorAll<HTMLElement>('[data-step-dot]');
    const setStep = (n: number) => dots.forEach((d) => {
      const i = Number(d.dataset.stepDot);
      d.classList.toggle('is-done', i < n);
      d.classList.toggle('is-current', i === n);
    });

    // Example availability: weekdays, not today; a varying set of times per day.
    const ALL = ['10:00', '11:00', '13:30', '15:00', '16:30', '18:00', '19:30'];
    const timesFor = (d: Date) => {
      const wd = (d.getDay() + 6) % 7;
      if (wd > 4 || d <= today) return [];
      return ALL.filter((_, i) => (d.getDate() * 7 + i * 3) % 5 !== 0);
    };

    const drawSlots = () => {
      slots.replaceChildren();
      if (!chosen) {
        slotsTitle.textContent = t.pick;
        return;
      }
      const list = timesFor(chosen);
      slotsTitle.textContent = list.length
        ? cap(chosen.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }))
        : t.none;
      for (const time of list) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'slot';
        b.textContent = time;
        b.setAttribute('role', 'radio');
        b.setAttribute('aria-checked', 'false');
        b.addEventListener('click', () => {
          slots.querySelectorAll('.slot').forEach((s) => s.setAttribute('aria-checked', 'false'));
          b.setAttribute('aria-checked', 'true');
          sumTime.textContent = time;
          sumTime.classList.remove('muted');
          setStep(3);
        });
        slots.append(b);
      }
    };

    const drawMonth = () => {
      title.textContent = cap(month.toLocaleDateString(locale, { month: 'long', year: 'numeric' }));
      days.replaceChildren();
      const lead = (month.getDay() + 6) % 7;
      for (let i = 0; i < lead; i++) days.append(document.createElement('span'));
      const last = new Date(month.getFullYear(), month.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= last; n++) {
        const d = new Date(month.getFullYear(), month.getMonth(), n);
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'day';
        b.textContent = String(n);
        const free = timesFor(d).length > 0;
        b.disabled = !free;
        if (free) b.classList.add('has-slots');
        if (d.getTime() === today.getTime()) b.classList.add('is-today');
        if (chosen && d.getTime() === chosen.getTime()) b.setAttribute('aria-pressed', 'true');
        b.setAttribute('aria-label', d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' }));
        b.addEventListener('click', () => {
          chosen = d;
          days.querySelectorAll('.day').forEach((x) => x.removeAttribute('aria-pressed'));
          b.setAttribute('aria-pressed', 'true');
          sumDay.textContent = d.toLocaleDateString(locale, { weekday: 'short', day: 'numeric', month: 'long' });
          sumDay.classList.remove('muted');
          sumTime.textContent = t.notChosen;
          sumTime.classList.add('muted');
          setStep(2);
          drawSlots();
        });
        days.append(b);
      }
      const prev = q<HTMLButtonElement>('[data-cal-prev]');
      prev.disabled = month <= new Date(today.getFullYear(), today.getMonth(), 1);
    };

    q('[data-cal-prev]').addEventListener('click', () => {
      month = new Date(month.getFullYear(), month.getMonth() - 1, 1);
      drawMonth();
    });
    q('[data-cal-next]').addEventListener('click', () => {
      month = new Date(month.getFullYear(), month.getMonth() + 1, 1);
      drawMonth();
    });
    root.querySelectorAll<HTMLInputElement>('input[name="bk-type"]').forEach((r) =>
      r.addEventListener('change', () => {
        sumType.replaceChildren(r.dataset.label ?? '', Object.assign(document.createElement('small'), { textContent: r.dataset.meta ?? '' }));
        sumPrice.textContent = r.dataset.price ?? '';
        setStep(Math.max(1, root.querySelector('.slot[aria-checked="true"]') ? 3 : chosen ? 2 : 1));
      }),
    );
    root.querySelector('[data-field-name]')?.addEventListener('input', () => setStep(4));
    drawMonth();
    drawSlots();
  }
</script>

<style>
  .booking {
    display: grid;
    gap: var(--space-5);
  }

  .preview-note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin: 0;
    padding: 10px 14px;
    border: 1px dashed color-mix(in srgb, var(--sun-disc) 70%, transparent);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--sun-halo) 14%, transparent);
    color: var(--text);
    font-size: var(--text-xs);
    text-align: center;
  }

  .booking-lead {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--muted);
    text-align: center;
  }

  /* 1 — 2 — 3 — 4 */
  .stepper {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .stepper li {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    font-size: var(--text-xs);
    text-align: center;
  }

  .stepper li + li::before {
    content: '';
    position: absolute;
    top: 15px;
    right: 50%;
    width: 100%;
    height: 2px;
    background: var(--line);
    z-index: 0;
  }

  .stepper li.is-done + li::before,
  .stepper li.is-done + li.is-current::before {
    background: var(--sun-disc);
  }

  .stepper .dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 2px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    font-weight: 700;
  }

  .stepper li.is-current {
    color: var(--text);
    font-weight: 600;
  }

  .stepper li.is-current .dot {
    border-color: var(--btn-bg);
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  .stepper li.is-done .dot {
    border-color: var(--sun-disc);
    background: var(--sun-disc);
    color: #1F2E4A;
  }

  .booking-grid {
    display: grid;
    gap: var(--space-5);
  }

  .booking-main {
    display: grid;
    gap: var(--space-4);
  }

  .card {
    padding: var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .card h2 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 var(--space-4);
    font-size: var(--text-lg);
  }

  .num {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }

  /* Session types: big tappable cards, the radio hidden behind the selected outline. */
  .types {
    display: grid;
    gap: var(--space-3);
  }

  .type {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 2px solid transparent;
    border-radius: var(--radius-md);
    background: var(--bg);
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .type:hover {
    border-color: var(--line);
  }

  .type input {
    flex: none;
    width: 20px;
    height: 20px;
    margin: 2px 0 0;
    accent-color: var(--btn-bg);
  }

  .type:has(input:checked) {
    border-color: var(--btn-bg);
    box-shadow: var(--shadow-soft);
  }

  .type:has(input:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .type-body {
    display: grid;
    flex: 1;
    gap: 4px;
  }

  .type-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .type-meta {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .type-text {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.45;
  }

  .type-price {
    flex: none;
    max-width: 8rem;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    text-align: right;
  }

  .type-price.free {
    color: var(--text);
    font-size: var(--text-sm);
  }

  .badge {
    padding: 2px 8px;
    border-radius: var(--radius-pill);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .badge-sun {
    background: var(--sun-disc);
    color: #1F2E4A;
  }

  /* Calendar and the day's times. */
  .when {
    display: grid;
    gap: var(--space-5);
  }

  .cal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-3);
  }

  .cal-nav {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: var(--bg);
    color: var(--text);
    cursor: pointer;
  }

  .cal-nav:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .cal-nav :global(.flip) {
    transform: rotate(180deg);
  }

  .cal-week,
  .cal-days {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
    text-align: center;
  }

  .cal-week {
    margin-bottom: 4px;
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .cal-days :global(.day) {
    position: relative;
    aspect-ratio: 1;
    min-height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: var(--text-sm);
    opacity: 0.5;
