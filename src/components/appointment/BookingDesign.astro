---
/**
 * The booking page design (owner's reviews 2026-10-19, items 12 and 3): how "Randevu Al" will look
 * once the booking system exists. A note first sends first-time visitors to the free intro call.
 * Then four steps, one on screen at a time (session type, date and time, your details, confirm),
 * with a summary card beside them on desktop. Session types: individual (50 min) and couple (60 min)
 * therapy, both online; group therapy ("soon") and face to face ("not available") are faded and
 * cannot be chosen. Fees are sent by e-mail. The calendar shows the free times of booking.json and
 * the last button sends the request (booking-submit.ts, `booking.request`): the owner gets an e-mail,
 * nothing is stored. Shown on the dev server (or with `BOOKING_DESIGN=1`) only (AppointmentView)
 * until the owner approves the open questions in docs/superpowers/specs/2026-10-20-randevu-formlari-design.md.
 */
import type { Lang } from '../../lib/settings';
import { getBooking, getProfile } from '../../lib/settings';
import { ADMIN_CONFIG, MOCK_API_URL } from '../../admin/config';
import { pathFor } from '../../i18n/routes';
import Icon from '../Icon.astro';
import RoundPortrait from '../ui/RoundPortrait.astro';
import './wizard.css';

interface Props {
  lang: Lang;
  email: string;
}
const { lang, email } = Astro.props;
const profile = getProfile();
const role = profile.title[lang].trim();
const endpoint = ADMIN_CONFIG.apiUrl && ADMIN_CONFIG.apiUrl !== MOCK_API_URL ? ADMIN_CONFIG.apiUrl : undefined;
const config = JSON.stringify(getBooking());

const T = {
  tr: {
    preview: 'Önizleme: bu form yalnızca önizlemede görünür. Panel adresi tanımlıysa talep gerçekten gönderilir.',
    sending: 'Gönderiliyor…',
    invalid: 'Bazı bilgiler eksik ya da hatalı. Lütfen önceki adımlara dönüp kontrol edin.',
    taken: 'Seçtiğiniz saat artık uygun değil. Lütfen takvimden başka bir saat seçin.',
    failed: 'Talep gönderilemedi. Lütfen biraz sonra tekrar deneyin ya da e-posta ile yazın.',
    doneTitle: 'Talebiniz alındı',
    doneText: 'Size kısa bir alındı e-postası gönderdim. Saati onaylamak ya da başka bir saat önermek için en kısa sürede e-postayla dönüş yapacağım.',
    firstTitle: 'İlk kez mi randevu alıyorsunuz?',
    firstText: 'Terapiye başlamadan önce ücretsiz ön görüşme talep etmenizi öneririm. 25–30 dakikalık bu görüşmede tanışır, sizin için doğru adımın ne olduğuna birlikte karar veririz.',
    firstCta: 'Ücretsiz ön görüşme talep et',
    steps: ['Görüşme', 'Tarih ve saat', 'Bilgileriniz', 'Onay'],
    s1: 'Görüşme türünü seçin',
    s1Hint: 'Seanslar online yapılır. Ücretler ve ayrıntılı bilgiler e-postayla iletilir.',
    online: 'Online',
    soon: 'Yakında',
    off: 'Şu an uygun değil',
    close: 'Kapat',
    individual: 'Bireysel Terapi Seansı',
    individualMeta: '50 dakika',
    individualText: 'Kendi gündeminizle, birebir ve düzenli görüşmeler.',
    couple: 'Çift Terapisi Seansı',
    coupleMeta: '60 dakika',
    coupleText: 'Partnerinizle birlikte; iletişim, çatışmalar ve ilişkinin kendisi üzerine.',
    access: 'Erişilebilir Terapi Seansı',
    accessMeta: '50 dakika',
    accessBadge: 'Kontenjanlı',
    accessText: 'Ekonomik durumu elverişli olmayanlar ve üniversite öğrencileri için uygun ücretli bireysel seans. Kontenjan sınırlıdır.',
    accessMore: 'Ayrıntılar',
    group: 'Grup Terapisi Seansı',
    groupText: 'Benzer konularla gelen küçük bir grupla birlikte çalışma.',
    face: 'Yüz Yüze Terapi',
    faceText: 'Şu an yalnızca online görüşme yapıyorum.',
    s2: 'Gün ve saat seçin',
    s2Hint: 'Boş saati olan günler renkli görünür.',
    tz: 'Saatler Türkiye saatiyle (GMT+3) gösterilir.',
    prev: 'Önceki ay',
    next: 'Sonraki ay',
    week: ['Pzt', 'Sal', 'Çar', 'Per', 'Cum', 'Cmt', 'Paz'],
    pickDay: 'Takvimden bir gün seçin.',
    s3: 'Bilgileriniz',
    s3Hint: 'Yıldızlı alanlar zorunludur.',
    name: 'Ad soyad',
    mail: 'E-posta',
    phone: 'Telefon',
    note: 'Eklemek istediğiniz bir not (isteğe bağlı)',
    noteHint: 'Sağlık durumunuza ilişkin ayrıntıları burada paylaşmayın; bunları görüşmede konuşuruz.',
    consentA: 'Aydınlatma metnini',
    consentB: ' okudum.',
    s4: 'Özet ve onay',
    s4Hint: 'Bilgilerinizi kontrol edin; talebiniz bana e-postayla ulaşır, size dönüş yaparım.',
    summary: 'Randevu özeti',
    type: 'Görüşme',
    when: 'Tarih',
    time: 'Saat',
    you: 'İletişim',
    place: 'Yer',
    placeValue: 'Online (bağlantı e-postayla gönderilir)',
    price: 'Ücret',
    priceValue: 'E-postayla iletilir',
    back: 'Geri',
    cont: 'Devam',
    edit: 'Bilgileri düzenle',
    submit: 'Randevu talebini gönder',
    soonMail: 'Online randevu sistemi çok yakında açılıyor. Şimdilik e-posta ile yazabilirsiniz:',
    reminders: 'Randevudan bir gün önce hatırlatma e-postası gelir. Değişiklik ve iptal için en az 24 saat önce haber vermeniz yeterli.',
    secure: 'Bilgileriniz yalnızca randevunuz için kullanılır.',
  },
  en: {
    preview: 'Preview: this form shows in the preview only. With the panel address set, the request is really sent.',
    sending: 'Sending…',
    invalid: 'Some details are missing or wrong. Please go back and check the earlier steps.',
    taken: 'The time you chose is no longer free. Please pick another time in the calendar.',
    failed: 'The request could not be sent. Please try again a little later or write by e-mail.',
    doneTitle: 'Your request has been received',
    doneText: 'I have sent you a short acknowledgement by e-mail. I will reply soon to confirm the time or suggest another one.',
    firstTitle: 'Booking for the first time?',
    firstText: 'Before starting therapy, I recommend asking for a free intro call. In these 25–30 minutes we get to know each other and decide together on the right next step for you.',
    firstCta: 'Ask for a free intro call',
    steps: ['Session', 'Date and time', 'Your details', 'Confirm'],
    s1: 'Choose a session type',
    s1Hint: 'Sessions are held online. Fees and full details are sent by e-mail.',
    online: 'Online',
    soon: 'Coming soon',
    off: 'Not available now',
    close: 'Close',
    individual: 'Individual Therapy Session',
    individualMeta: '50 minutes',
    individualText: 'One-to-one, regular sessions around what you bring.',
    couple: 'Couple Therapy Session',
    coupleMeta: '60 minutes',
    coupleText: 'Together with your partner: communication, conflict and the relationship itself.',
    access: 'Accessible Therapy Session',
    accessMeta: '50 minutes',
    accessBadge: 'Limited places',
    accessText: 'A lower-fee individual session for people whose finances do not allow the regular fee, and for university students. Places are limited.',
    accessMore: 'Details',
    group: 'Group Therapy Session',
    groupText: 'Working together with a small group around similar themes.',
    face: 'Face-to-Face Therapy',
    faceText: 'For now I only work online.',
    s2: 'Choose a day and time',
    s2Hint: 'Days with free times are coloured.',
    tz: 'Times are shown in Turkey time (GMT+3).',
    prev: 'Previous month',
    next: 'Next month',
    week: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    pickDay: 'Pick a day in the calendar.',
    s3: 'Your details',
    s3Hint: 'Fields with a star are required.',
    name: 'Full name',
    mail: 'E-mail',
    phone: 'Phone',
    note: 'Anything you would like to add (optional)',
    noteHint: 'Please do not share health details here; we will talk about them in the session.',
    consentA: 'I have read the ',
    consentB: 'privacy notice.',
    s4: 'Summary and confirm',
    s4Hint: 'Check your details; your request reaches me by e-mail and I get back to you.',
    summary: 'Booking summary',
    type: 'Session',
    when: 'Date',
    time: 'Time',
    you: 'Contact',
    place: 'Where',
    placeValue: 'Online (link sent by e-mail)',
    price: 'Fee',
    priceValue: 'Sent by e-mail',
    back: 'Back',
    cont: 'Continue',
    edit: 'Edit details',
    submit: 'Send booking request',
    soonMail: 'The online booking system opens very soon. For now, you can write by e-mail:',
    reminders: 'A reminder e-mail arrives a day before. To change or cancel, letting me know 24 hours ahead is enough.',
    secure: 'Your details are used only for your appointment.',
  },
}[lang];
const notice = pathFor('privacyNotice', lang);
const messages = JSON.stringify({ sending: T.sending, invalid: T.invalid, taken: T.taken, failed: T.failed });
---

<div class="wz booking" data-booking data-lang={lang} data-kind="session" data-config={config} data-endpoint={endpoint} data-messages={messages}>
  <p class="preview-note" role="note" data-hide-on-done>
    <Icon name="alert" size={16} />
    {T.preview}
  </p>

  <div class="first-time" data-first-time data-hide-on-done>
    <a class="ft-link" href={pathFor('preConsult', lang)}>
      <span class="ft-icon"><Icon name="talk" size={26} /></span>
      <span class="ft-body">
        <b>{T.firstTitle}</b>
        <span>{T.firstText}</span>
        <span class="ft-cta">{T.firstCta} <Icon name="arrow" size={16} /></span>
      </span>
    </a>
    <button type="button" class="ft-close" data-first-time-close aria-label={T.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <ol class="stepper" data-hide-on-done>
    {
      T.steps.map((s, i) => (
        <li data-step-dot={i + 1} class:list={[{ 'is-current': i === 0 }]}>
          <button type="button" tabindex="-1">
            <span class="dot">{i + 1}</span>
            <span class="step-label">{s}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="wz-grid">
    <div class="wz-main">
      <section class="card" data-step="1" aria-labelledby="bk-s1">
        <h2 id="bk-s1">{T.s1}</h2>
        <p class="card-hint">{T.s1Hint}</p>
        <div class="types" role="radiogroup" aria-labelledby="bk-s1">
          <label class="type">
            <input type="radio" name="type" value="individual" data-sum-src="type" data-label={T.individual} data-meta={T.individualMeta} checked />
            <span class="type-body">
              <span class="type-top">
                <b>{T.individual}</b>
                <span class="badge badge-online">{T.online}</span>
              </span>
              <span class="type-meta"><Icon name="clock" size={15} />{T.individualMeta}</span>
              <span class="type-text">{T.individualText} <a class="type-more" href="#bireysel-terapi">{T.accessMore}</a></span>
            </span>
          </label>
          <label class="type">
            <input type="radio" name="bk-type" value="couple" data-sum-src="type" data-label={T.couple} data-meta={T.coupleMeta} />
            <span class="type-body">
              <span class="type-top">
                <b>{T.couple}</b>
                <span class="badge badge-online">{T.online}</span>
              </span>
              <span class="type-meta"><Icon name="clock" size={15} />{T.coupleMeta}</span>
              <span class="type-text">{T.coupleText} <a class="type-more" href="#cift-terapisi">{T.accessMore}</a></span>
            </span>
          </label>
          <label class="type">
            <input type="radio" name="bk-type" value="accessible" data-sum-src="type" data-label={T.access} data-meta={T.accessMeta} />
            <span class="type-body">
              <span class="type-top">
                <b>{T.access}</b>
                <span class="badge badge-online">{T.online}</span>
                <span class="badge badge-quota">{T.accessBadge}</span>
              </span>
              <span class="type-meta"><Icon name="clock" size={15} />{T.accessMeta}</span>
              <span class="type-text">{T.accessText} <a class="type-more" href="#erisilebilir-terapi">{T.accessMore}</a></span>
            </span>
          </label>
          <label class="type is-off">
            <input type="radio" name="bk-type" value="group" disabled />
            <span class="type-body">
              <span class="type-top">
                <b>{T.group}</b>
                <span class="badge badge-soon">{T.soon}</span>
              </span>
              <span class="type-text">{T.groupText} <a class="type-more" href="#grup-terapisi">{T.accessMore}</a></span>
            </span>
          </label>
          <label class="type is-off">
            <input type="radio" name="bk-type" value="face" disabled />
            <span class="type-body">
              <span class="type-top">
                <b>{T.face}</b>
                <span class="badge badge-soon">{T.off}</span>
              </span>
              <span class="type-text">{T.faceText} <a class="type-more" href="#yuz-yuze-terapi">{T.accessMore}</a></span>
            </span>
          </label>
        </div>
      </section>

      <section class="card" data-step="2" data-need="slot" aria-labelledby="bk-s2" hidden>
        <h2 id="bk-s2">{T.s2}</h2>
        <p class="card-hint">{T.s2Hint}</p>
        <div class="when">
          <div class="calendar">
            <div class="cal-head">
              <button type="button" class="cal-nav" data-cal-prev aria-label={T.prev}>
                <Icon name="chevron" size={18} class="flip" />
              </button>
              <b data-cal-title aria-live="polite"></b>
              <button type="button" class="cal-nav" data-cal-next aria-label={T.next}>
                <Icon name="chevron" size={18} />
              </button>
            </div>
            <div class="cal-week" aria-hidden="true">{T.week.map((d) => <span>{d}</span>)}</div>
            <div class="cal-days" data-cal-days></div>
          </div>
          <div class="slots">
            <p class="slots-title" data-slots-title>{T.pickDay}</p>
            <div class="slot-list" data-slots role="radiogroup" aria-labelledby="bk-s2"></div>
            <p class="tz"><Icon name="globe" size={14} />{T.tz}</p>
          </div>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="3" aria-labelledby="bk-s3" hidden>
        <h2 id="bk-s3">{T.s3}</h2>
        <p class="card-hint">{T.s3Hint}</p>
        <div class="fields">
          <label class="field">
            <span>{T.name} <span class="req" aria-hidden="true">*</span></span>
            <input type="text" name="name" autocomplete="name" required maxlength="100" data-sum-src="name" />
          </label>
          <label class="field">
            <span>{T.mail} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" data-sum-src="contact" />
          </label>
          <label class="field">
            <span>{T.phone} <span class="req" aria-hidden="true">*</span></span>
            <input type="tel" name="phone" autocomplete="tel" inputmode="tel" required minlength="10" maxlength="20" data-sum-src="contact" />
          </label>
          <label class="field field-wide">
            <span>{T.note}</span>
            <textarea name="note" rows="3" maxlength="500"></textarea>
            <small>{T.noteHint}</small>
          </label>
          <label class="hp" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="hp_field" tabindex="-1" autocomplete="off" />
          </label>
          <label class="consent field-wide">
            <input type="checkbox" name="consent" value="1" required />
            <span>
              {lang === 'tr' ? <><a href={notice}>{T.consentA}</a>{T.consentB}</> : <>{T.consentA}<a href={notice}>{T.consentB}</a></>}
              <span class="req" aria-hidden="true"> *</span>
            </span>
          </label>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="4" aria-labelledby="bk-s4" data-hide-on-done hidden>
        <h2 id="bk-s4">{T.s4}</h2>
        <p class="card-hint">{T.s4Hint}</p>
        <div class="summary-card">
          <div class="who">
            <RoundPortrait photo={profile.photo} alt="" size={52} />
            <span>
              <b>{profile.name}</b>
              {role && <small>{role}</small>}
            </span>
          </div>
          <dl>
            <div><dt><Icon name="chat" size={16} />{T.type}</dt><dd data-sum="type"></dd></div>
            <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
            <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
            <div><dt><Icon name="user" size={16} />{T.name}</dt><dd data-sum="name"></dd></div>
            <div><dt><Icon name="mail" size={16} />{T.you}</dt><dd data-sum="contact"></dd></div>
            <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
            <div class="total"><dt>{T.price}</dt><dd>{T.priceValue}</dd></div>
          </dl>
          <button type="button" class="submit" disabled aria-describedby="bk-soon" data-submit>
            <Icon name="send" size={18} />
            {T.submit}
          </button>
          <p class="step-error" data-submit-error role="alert" tabindex="-1" hidden></p>
          <p class="soon" id="bk-soon" data-soon>{T.soonMail} <a href={`mailto:${email}`}>{email}</a></p>
          <button type="button" class="edit-link" data-goto="3">{T.edit}</button>
          <ul class="assure">
            <li><Icon name="clock" size={15} />{T.reminders}</li>
            <li><Icon name="shield" size={15} />{T.secure}</li>
          </ul>
        </div>
      </section>

      <section class="card done" data-done tabindex="-1" aria-labelledby="bk-done" hidden>
        <h2 id="bk-done"><Icon name="send" size={22} /> {T.doneTitle}</h2>
        <p>{T.doneText}</p>
      </section>

      <div class="wz-nav" data-nav>
        <button type="button" class="wz-back" data-back hidden><Icon name="arrow" size={18} />{T.back}</button>
        <button type="button" class="wz-next" data-next><span data-next-label>{T.cont}</span><Icon name="arrow" size={18} /></button>
      </div>
    </div>

    <aside class="summary" aria-labelledby="bk-sum">
      <div class="summary-card">
        <div class="who">
          <RoundPortrait photo={profile.photo} alt="" size={52} />
          <span>
            <b>{profile.name}</b>
            {role && <small>{role}</small>}
          </span>
        </div>
        <h2 id="bk-sum">{T.summary}</h2>
        <dl>
          <div><dt><Icon name="chat" size={16} />{T.type}</dt><dd data-sum="type"></dd></div>
          <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
          <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
          <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
          <div class="total"><dt>{T.price}</dt><dd>{T.priceValue}</dd></div>
        </dl>
        <ul class="assure">
          <li><Icon name="clock" size={15} />{T.reminders}</li>
          <li><Icon name="shield" size={15} />{T.secure}</li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<script>
  import { mountBookingForm } from './booking-submit';

  // The way to the intro call can be closed; it comes back when the page is opened again.
  document.querySelectorAll<HTMLElement>('[data-first-time]').forEach((box) =>
    box.querySelector('[data-first-time-close]')?.addEventListener('click', () => box.remove()),
  );

  for (const root of document.querySelectorAll<HTMLElement>('[data-booking]')) mountBookingForm(root);
</script>

<style>
  /* "Kontenjanlı": a quiet outlined badge in the accent colour. */
  .badge-quota {
    border: 1px solid color-mix(in srgb, var(--sun-disc) 70%, transparent);
    color: var(--link);
  }

  .type-more {
    color: var(--link);
    font-weight: 600;
  }

  /* "İlk kez mi randevu alıyorsunuz?": the way to the free intro call, before the steps. */
  .first-time {
    position: relative;
    border: 1.5px solid color-mix(in srgb, var(--sun-disc) 60%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--sun-halo) 16%, transparent);
  }

  .first-time:has(.ft-link:hover) {
    background: color-mix(in srgb, var(--sun-halo) 26%, transparent);
  }

  .ft-link {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-4) calc(var(--space-5) + 36px) var(--space-4) var(--space-5);
    border-radius: inherit;
    color: var(--text);
    text-decoration: none;
  }

  .ft-link:hover {
    color: var(--text);
  }

  /* × in the top-right corner. */
  .ft-close {
    position: absolute;
    top: 8px;
    right: 8px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .ft-close:hover {
    background: color-mix(in srgb, var(--text) 10%, transparent);
    color: var(--text);
  }

  .ft-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--sun-disc);
    color: #1f2e4a;
  }

  .ft-body {
    display: grid;
    gap: 4px;
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .ft-body b {
    font-size: var(--text-base);
  }

  .ft-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--link);
    font-weight: 700;
  }

  @media (max-width: 479px) {
    .ft-link {
      padding: var(--space-4) calc(var(--space-4) + 32px) var(--space-4) var(--space-4);
    }

    .ft-icon {
      width: 40px;
      height: 40px;
    }
  }
</style>
