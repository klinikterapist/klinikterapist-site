    type: 'Görüşme',
    when: 'Tarih',
    time: 'Saat',
    you: 'İletişim',
    place: 'Yer',
    placeValue: 'Online (bağlantı e-postayla gönderilir)',
    price: 'Ücret',
    priceValue: 'E-postayla iletilir',
    back: 'Geri',
    cont: 'Devam',
    edit: 'Bilgileri düzenle',
    submit: 'Randevu talebini gönder',
    soonMail: 'Online randevu sistemi çok yakında açılıyor. Şimdilik e-posta ile yazabilirsiniz:',
    reminders: 'Seansınızdan 3 gün önce hatırlatma e-postası gelir. Seansa 24 saatten az kala yapılan iptal ve ertelemelerde seans ücretinin tamamı ödenir.',
    secure: 'Bilgileriniz yalnızca randevunuz için kullanılır.',
  },
  en: {
    preview: 'Preview: this form shows in the preview only. With the panel address set, the request is really sent.',
    sending: 'Sending…',
    invalid: 'Some details are missing or wrong. Please go back and check the earlier steps.',
    taken: 'The time you chose is no longer free. Please pick another time in the calendar.',
    failed: 'The request could not be sent. Please try again a little later or write by e-mail.',
    firstTitle: 'Booking for the first time?',
    firstText: 'Before starting therapy, I recommend asking for a free intro call. In these 25–30 minutes we get to know each other and decide together on the right next step for you.',
    firstCta: 'Ask for a free intro call',
    steps: ['Session', 'About it', 'Date and time', 'Your details', 'Confirm'],
    s1: 'Choose a session type',
    s1Hint: 'Sessions are held online. Fees and full details are sent by e-mail.',
    online: 'Online',
    faceBadge: 'In person',
    close: 'Close',
    individual: 'Individual Therapy Session',
    individualText: 'One-to-one, regular sessions around what you bring.',
    couple: 'Couples Therapy Session',
    coupleText: 'Together with your spouse or partner: communication, conflict and the relationship itself.',
    access: 'Accessible Therapy Session',
    accessText: 'A lower-fee individual session for people whose finances do not allow the regular fee, and for university students. Places are limited.',
    accessMore: 'Details',
    group: 'Group Therapy Session',
    groupText: 'Working together with a small group around similar themes.',
    face: 'Face-to-Face Therapy',
    faceText: 'For now I only work online.',
    faceOnText: 'One-to-one sessions in person.',
    supervision: 'Supervision Therapy Session',
    supervisionText: 'A session at a symbolic fee as part of training supervision. With your separate informed consent, sessions may be discussed with my supervisor.',
    minutes: 'minutes',
    info: 'About this session',
    infoHint: 'Before choosing a date, read how the session you chose works.',
    infoOnline: 'Online',
    infoFace: 'In person',
    infoRead: 'I have read this information.',
    infoAsk: 'If anything is unclear, you can write it in the note of your request or ask by e-mail.',
    s2: 'Choose a day and time',
    s2Hint: 'Days with free times are coloured.',
    tz: 'Times are shown in Turkey time (GMT+3).',
    prev: 'Previous month',
    next: 'Next month',
    week: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
    pickDay: 'Pick a day in the calendar.',
    s3: 'Your details',
    s3Hint: 'Fields with a star are required.',
    name: 'Full name',
    mail: 'E-mail',
    phone: 'Phone',
    country: 'Where do you live?',
    countryPick: 'Choose',
    note: 'Anything you would like to add (optional)',
    noteHint: 'Please do not share health details here; we will talk about them in the session.',
    consentA: 'I have read the ',
    consentB: 'privacy notice.',
    noteConsent: 'I give my explicit consent for my note to be sent by e-mail to Clinical Psychologist Osman Güneş Özkurt to prepare the session.',
    s4: 'Summary and confirm',
    s4Hint: 'Check your details; your request reaches me by e-mail and I get back to you.',
    summary: 'Booking summary',
    type: 'Session',
    when: 'Date',
    time: 'Time',
    you: 'Contact',
    place: 'Where',
    placeValue: 'Online (link sent by e-mail)',
    price: 'Fee',
    priceValue: 'Sent by e-mail',
    back: 'Back',
    cont: 'Continue',
    edit: 'Edit details',
    submit: 'Send booking request',
    soonMail: 'The online booking system opens very soon. For now, you can write by e-mail:',
    reminders: 'A reminder e-mail arrives three days before. For a session cancelled or moved less than 24 hours before it starts, the full fee is due.',
    secure: 'Your details are used only for your appointment.',
  },
}[lang];
const notice = pathFor('privacyNotice', lang);
const F = FORM_TEXT[lang];
const messages = JSON.stringify({ sending: T.sending, invalid: T.invalid, taken: T.taken, failed: T.failed, mismatch: F.mismatch, emailDomain: F.emailDomain });

// The session types from the catalogue, offered or not as set in Ayarlar › Randevu Ayarları (owner's
// reviews 2026-10-23). An offered type can be chosen (the first one is preselected); a closed one stays
// in the list, faded, with "Kontenjan Doldu" or "Şu an uygun değil", unless the owner chose to hide it.
const TYPE_TEXT: Record<SessionTypeId, { label: string; text: string; anchor?: string }> = {
  individual: { label: T.individual, text: T.individualText, anchor: 'bireysel-terapi' },
  couple: { label: T.couple, text: T.coupleText, anchor: 'cift-terapisi' },
  accessible: { label: T.access, text: T.accessText, anchor: 'erisilebilir-terapi' },
  group: { label: T.group, text: T.groupText, anchor: 'grup-terapisi' },
  face: { label: T.face, text: T.faceText, anchor: 'yuz-yuze-terapi' },
  supervision: { label: T.supervision, text: T.supervisionText, anchor: 'supervizyon' },
};
// The "Bilgilendirme" step and the names on the cards come from session-info.json (Ayarlar › Randevu
// Ayarları › Bilgilendirme, owner's review 2026-10-23); the names above stay as the fallback.
const sessionInfo = getSessionInfo();
const types = SESSION_TYPES.map((t) => {
  const state = typeState(booking, t.id);
  const on = state === 'on';
  const look = TYPE_TEXT[t.id];
  const info = sessionInfo.types[t.id];
  const label = info?.name[lang].trim() || look.label;
  return {
    id: t.id,
    on,
    state,
    quota: t.quota,
    label,
    text: on && t.id === 'face' ? T.faceOnText : look.text,
    anchor: look.anchor,
    meta: `${t.minutes} ${T.minutes}`,
    place: t.id === 'face' ? T.infoFace : T.infoOnline,
    info: textBlocks(info?.info[lang] ?? ''),
    online: t.id !== 'face',
  };
}).filter((x) => x.state !== 'hidden');
const onlineInfo = textBlocks(sessionInfo.online[lang]);
const firstOn = types.findIndex((x) => x.on);
---

<div class="wz booking" data-booking data-preview={import.meta.env.DEV ? "1" : undefined} data-lang={lang} data-kind="session" data-config={config} data-endpoint={endpoint} data-messages={messages}>
  <WaitlistForm lang={lang} kind="session" email={email} />
  {
    /* Dev server only: the live site shows the form without the note. */
    import.meta.env.DEV && (
      <p class="preview-note" role="note" data-hide-on-done>
        <Icon name="alert" size={16} />
        {T.preview}
      </p>
    )
  }

  <div class="first-time" data-first-time data-hide-on-done>
    <a class="ft-link" href={pathFor('preConsult', lang)}>
      <span class="ft-icon"><Icon name="talk" size={26} /></span>
      <span class="ft-body">
        <b>{T.firstTitle}</b>
        <span>{T.firstText}</span>
        <span class="ft-cta">{T.firstCta} <Icon name="arrow" size={16} /></span>
      </span>
    </a>
    <button type="button" class="ft-close" data-first-time-close aria-label={T.close}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <ol class="stepper" data-hide-on-done>
    {
      T.steps.map((s, i) => (
        <li data-step-dot={i + 1} class:list={[{ 'is-current': i === 0 }]}>
          <button type="button" tabindex="-1">
            <span class="dot">{i + 1}</span>
            <span class="step-label">{s}</span>
          </button>
        </li>
      ))
    }
  </ol>

  <div class="wz-grid">
    <div class="wz-main">
      <section class="card" data-step="1" aria-labelledby="bk-s1">
        <h2 id="bk-s1">{T.s1}</h2>
        <p class="card-hint">{T.s1Hint}</p>
        <div class="types" role="radiogroup" aria-labelledby="bk-s1">
          {
            types.map((x, i) => (
              <label class:list={['type', { 'is-off': !x.on }]}>
                {x.on ? (
                  <input type="radio" name="type" value={x.id} data-sum-src="type" data-label={x.label} data-meta={x.meta} checked={i === firstOn} />
                ) : (
                  <input type="radio" name="type" value={x.id} disabled />
                )}
                <span class="type-body">
                  <span class="type-top">
                    <b>{x.label}</b>
                    {x.on ? <span class="badge badge-online">{x.id === 'face' ? T.faceBadge : T.online}</span> : <span class:list={['badge', x.state === 'full' ? 'badge-full' : 'badge-soon']}>{TYPE_BADGES[x.state === 'full' ? 'full' : 'off'][lang]}</span>}
                    {x.on && x.quota && <span class="badge badge-quota">{TYPE_BADGES.quota[lang]}</span>}
                  </span>
                  {x.on && <span class="type-meta"><Icon name="clock" size={15} />{x.meta}</span>}
                  <span class="type-text">{x.text} {x.anchor && <a class="type-more" href={`#${x.anchor}`}>{T.accessMore}</a>}</span>
                </span>
              </label>
            ))
          }
        </div>
      </section>

      <section class="card" data-step="2" aria-labelledby="bk-info" hidden>
        <h2 id="bk-info">{T.info}</h2>
        <p class="card-hint">{T.infoHint}</p>
        {
          types
            .filter((x) => x.on)
            .map((x) => (
              <article class="session-info" data-info-for={x.id} hidden>
                <header>
                  <h3>{x.label}</h3>
                  <p class="type-meta">
                    <Icon name={x.online ? 'laptop' : 'user'} size={15} />
                    {x.place} · {x.meta}
                  </p>
                </header>
                {x.info.map((b) => (typeof b === 'string' ? <p>{b}</p> : 'h' in b ? <h4>{b.h}</h4> : <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>))}
                {x.online && onlineInfo.length > 0 && (
                  <div class="session-online">
                    {onlineInfo.map((b) => (typeof b === 'string' ? <p>{b}</p> : 'h' in b ? <h4>{b.h}</h4> : <ul>{b.ul.map((li) => <li>{li}</li>)}</ul>))}
                  </div>
                )}
              </article>
            ))
        }
        <p class="session-ask">{T.infoAsk}</p>
        <label class="consent">
          <input type="checkbox" name="infoRead" value="1" required data-info-read />
          <span>{T.infoRead} <span class="req" aria-hidden="true"> *</span></span>
        </label>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="3" data-need="slot" aria-labelledby="bk-s2" hidden>
        <h2 id="bk-s2">{T.s2}</h2>
        <p class="card-hint">{T.s2Hint}</p>
        <div class="when">
          <div class="calendar">
            <div class="cal-head">
              <button type="button" class="cal-nav" data-cal-prev aria-label={T.prev}>
                <Icon name="chevron" size={18} class="flip" />
              </button>
              <b data-cal-title aria-live="polite"></b>
              <button type="button" class="cal-nav" data-cal-next aria-label={T.next}>
                <Icon name="chevron" size={18} />
              </button>
            </div>
            <div class="cal-week" aria-hidden="true">{T.week.map((d) => <span>{d}</span>)}</div>
            <div class="cal-days" data-cal-days></div>
            <ul class="cal-note" data-cal-note hidden></ul>
          </div>
          <div class="slots">
            <p class="slots-title" data-slots-title>{T.pickDay}</p>
            <div class="slot-list" data-slots role="radiogroup" aria-labelledby="bk-s2"></div>
            <p class="tz"><Icon name="globe" size={14} />{T.tz}</p>
          </div>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="4" data-details aria-labelledby="bk-s3" hidden>
        <h2 id="bk-s3">{T.s3}</h2>
        <p class="card-hint">{T.s3Hint}</p>
        <div class="fields">
          <label class="field">
            <span>{T.name} <span class="req" aria-hidden="true">*</span></span>
            <input type="text" name="name" autocomplete="name" required maxlength="100" data-sum-src="name" />
          </label>
          {/* Asked on the session form too (owner's review 2026-10-23, item 16), as on the intro call. */}
          <label class="field">
            <span>{T.country} <span class="req" aria-hidden="true">*</span></span>
            <select name="country" required data-country>
              <option value="">{T.countryPick}</option>
              {COUNTRIES.map((c) => <option value={c.id}>{c[lang]}</option>)}
            </select>
          </label>
          <label class="field">
            <span>{T.mail} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email" autocomplete="email" inputmode="email" required maxlength="254" data-sum-src="contact" data-email />
            <small class="email-hint" data-email-hint hidden></small>
          </label>
          <label class="field">
            <span>{F.mail2} <span class="req" aria-hidden="true">*</span></span>
            <input type="email" name="email2" autocomplete="off" inputmode="email" required maxlength="254" data-email-again />
            <small class="email-hint is-error" data-email-mismatch hidden></small>
          </label>
          <PhoneField lang={lang} name="phone" label={T.phone} sum="contact" wide />
          <label class="field field-wide">
            <span>{T.note}</span>
            <textarea name="note" rows="3" maxlength="500"></textarea>
            <small>{T.noteHint}</small>
          </label>
          {/* Shown (and required) once a note is written: the note may be about health (owner's note 2026-10-22). */}
          <label class="consent field-wide" data-note-consent hidden>
            <input type="checkbox" name="healthConsent" value="1" />
            <span>{T.noteConsent} <span class="req" aria-hidden="true"> *</span></span>
          </label>
          <label class="hp" aria-hidden="true">
            <span>Website</span>
            <input type="text" name="hp_field" tabindex="-1" autocomplete="off" />
          </label>
          <label class="consent field-wide">
            <input type="checkbox" name="consent" value="1" required />
            <span>
              {lang === 'tr' ? <><a href={notice}>{T.consentA}</a>{T.consentB}</> : <>{T.consentA}<a href={notice}>{T.consentB}</a></>}
              <span class="req" aria-hidden="true"> *</span>
            </span>
          </label>
        </div>
        <p class="step-error" data-step-error role="alert" tabindex="-1" hidden></p>
      </section>

      <section class="card" data-step="5" aria-labelledby="bk-s4" data-hide-on-done hidden>
        <h2 id="bk-s4">{T.s4}</h2>
        <p class="card-hint">{T.s4Hint}</p>
        <div class="summary-card">
          <div class="who">
            <RoundPortrait photo={profile.photo} alt="" size={52} />
            <span>
              <b>{profile.name}</b>
              {role && <small>{role}</small>}
            </span>
          </div>
          <dl>
            <div><dt><Icon name="chat" size={16} />{T.type}</dt><dd data-sum="type"></dd></div>
            <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
            <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
            <div><dt><Icon name="user" size={16} />{T.name}</dt><dd data-sum="name"></dd></div>
            <div><dt><Icon name="mail" size={16} />{T.you}</dt><dd data-sum="contact"></dd></div>
            <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
            <div class="total"><dt>{T.price}</dt><dd>{T.priceValue}</dd></div>
          </dl>
          <button type="button" class="submit" disabled aria-describedby="bk-soon" data-submit>
            <Icon name="send" size={18} />
            {T.submit}
          </button>
          <p class="step-error" data-submit-error role="alert" tabindex="-1" hidden></p>
          <p class="soon" id="bk-soon" data-soon>{T.soonMail} <a href={`mailto:${email}`}>{email}</a></p>
          <button type="button" class="edit-link" data-goto="4">{T.edit}</button>
          <ul class="assure">
            <li><Icon name="clock" size={15} />{T.reminders}</li>
            <li><Icon name="shield" size={15} />{T.secure}</li>
          </ul>
        </div>
      </section>

      <DoneCard lang={lang} kind="session" id="bk-done" />

      <div class="wz-nav" data-nav>
        <button type="button" class="wz-back" data-back hidden><Icon name="arrow" size={18} />{T.back}</button>
        <button type="button" class="wz-next" data-next><span data-next-label>{T.cont}</span><Icon name="arrow" size={18} /></button>
      </div>
    </div>

    <aside class="summary" aria-labelledby="bk-sum">
      <div class="summary-card">
        <div class="who">
          <RoundPortrait photo={profile.photo} alt="" size={52} />
          <span>
            <b>{profile.name}</b>
            {role && <small>{role}</small>}
          </span>
        </div>
        <h2 id="bk-sum">{T.summary}</h2>
        <dl>
          <div><dt><Icon name="chat" size={16} />{T.type}</dt><dd data-sum="type"></dd></div>
          <div><dt><Icon name="calendar" size={16} />{T.when}</dt><dd data-sum="day"></dd></div>
          <div><dt><Icon name="clock" size={16} />{T.time}</dt><dd data-sum="time"></dd></div>
          <div><dt><Icon name="laptop" size={16} />{T.place}</dt><dd>{T.placeValue}</dd></div>
          <div class="total"><dt>{T.price}</dt><dd>{T.priceValue}</dd></div>
        </dl>
        <ul class="assure">
          <li><Icon name="clock" size={15} />{T.reminders}</li>
          <li><Icon name="shield" size={15} />{T.secure}</li>
        </ul>
      </div>
    </aside>
  </div>
</div>

<script>
  import { mountBookingForm } from './booking-submit';

  // The way to the intro call can be closed; it comes back when the page is opened again. It shows
  // when coming from the start page ("Başlamaya hazırım") too (owner's review 2026-10-23, item 13).
  document.querySelectorAll<HTMLElement>('[data-first-time]').forEach((box) => {
    box.querySelector('[data-first-time-close]')?.addEventListener('click', () => box.remove());
  });

  // "Bilgilendirme": the text of the chosen type; a new choice asks for "okudum" again.
  for (const root of document.querySelectorAll<HTMLElement>('[data-booking]')) {
    const read = root.querySelector<HTMLInputElement>('[data-info-read]');
    const showInfo = () => {
      const type = root.querySelector<HTMLInputElement>('input[name="type"]:checked')?.value;
      root.querySelectorAll<HTMLElement>('[data-info-for]').forEach((a) => (a.hidden = a.dataset.infoFor !== type));
    };
    root.querySelectorAll<HTMLInputElement>('input[name="type"]').forEach((r) =>
      r.addEventListener('change', () => {
        if (read) read.checked = false;
        showInfo();
      }),
    );
    showInfo();
    mountBookingForm(root);
  }
</script>

