---
/** Home hero: title, name, handwritten slogan, intro, portrait, the one booking CTA and the hero links. */
import type { Lang } from '../lib/settings';
import { getLinks, getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import Portrait from './Portrait.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = getProfile();
const links = getLinks().filter((l) => l.inHero);
const external = (url: string) => /^https?:\/\//.test(url);
const label = (l: (typeof links)[number]) => (l.icon === 'email' ? t(lang, 'emailLabel') : l.label);
---

<section class="hero container">
  <div class="intro">
    <p class="role">{profile.title[lang]}</p>
    <h1 class="name">{profile.name}</h1>
    <p class="slogan hand">{profile.tagline[lang]}</p>
    <span class="rule" aria-hidden="true"></span>
    <p class="lead">{profile.intro[lang]}</p>
  </div>

  <div class="photo">
    <Portrait lang={lang} size={380} eager />
  </div>

  <div class="actions">
    <a class="btn cta-primary" href={pathFor('appointment', lang)}>
      <Icon name="calendar" size={20} />
      <span>{t(lang, 'bookSession')}</span>
      <Icon name="chevron" size={18} class="cta-chev" />
    </a>
    {
      links.length > 0 && (
        <ul class="hero-links" aria-label={t(lang, 'heroLinks')}>
          {links.map((l) => (
            <li>
              <a href={l.url} {...(external(l.url) ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}>
                <Icon name={l.icon} size={18} />
                <span>{label(l)}</span>
                {external(l.url) && <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 44%);
    grid-template-areas:
      'intro photo'
      'actions actions';
    gap: var(--space-5) var(--space-3);
    align-items: center;
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }

  .intro {
    grid-area: intro;
    min-width: 0;
  }

  .photo {
    grid-area: photo;
    display: flex;
    justify-content: flex-end;
    align-self: start;
  }

  .actions {
    grid-area: actions;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .role {
    margin: 0;
    color: var(--forest);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
  }

  .name {
    margin: 0 0 var(--space-3);
    color: var(--forest);
    font-size: clamp(1.75rem, 1rem + 4vw, 3.75rem);
    line-height: 1.05;
    text-wrap: balance;
  }

  .slogan {
    margin: 0;
    color: var(--forest);
    font-size: clamp(1.5rem, 1.2rem + 1.4vw, 2.25rem);
    line-height: 1.1;
  }

  .rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    margin: var(--space-3) 0;
    background: var(--forest);
  }

  .lead {
    margin: 0;
    max-width: 30rem;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .cta-primary {
    position: relative;
    width: 100%;
    min-height: 56px;
    border-radius: var(--radius-md);
    font-size: var(--text-base);
  }

  .cta-primary :global(.cta-chev) {
    position: absolute;
    right: var(--space-4);
  }

  .hero-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-links a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-md);
    background: var(--sage-soft);
    color: var(--forest);
    font-size: var(--text-sm);
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
  }

  @media (min-width: 480px) {
    .hero-links {
      grid-template-columns: none;
      grid-auto-columns: minmax(0, 1fr);
      grid-auto-flow: column;
    }
  }

  .hero-links a:hover {
    background: #d6dece;
  }

  @media (min-width: 768px) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 40%);
      grid-template-areas:
        'intro photo'
        'actions photo';
      gap: var(--space-5) var(--space-7);
      padding-top: var(--space-7);
      padding-bottom: var(--space-7);
    }

    .intro {
      align-self: end;
    }

    .actions {
      align-self: start;
      max-width: 34rem;
    }

    .photo {
      align-self: center;
    }

    .lead {
      font-size: var(--text-base);
    }
  }
</style>
