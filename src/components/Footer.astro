---
import type { Lang, Link } from '../lib/settings';
import { getLinks, getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Leaf from './Leaf.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = getProfile();
const links = getLinks().filter((l) => l.inFooter);
const year = new Date().getFullYear();

/** 24×24 line icons (stroke) for the social links. */
const ICONS: Record<Link['icon'], string> = {
  instagram: '<rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.6" fill="currentColor"/>',
  linkedin: '<rect x="3.5" y="3.5" width="17" height="17" rx="3"/><path d="M8 10.5V16M8 7.8v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.3-2.6s2.2.9 2.2 2.6V16"/>',
  medium: '<ellipse cx="7.5" cy="12" rx="4.5" ry="5"/><ellipse cx="16" cy="12" rx="2.2" ry="4.6"/><path d="M20.5 7.8v8.4"/>',
  substack: '<path d="M5 4.5h14M5 8.5h14M5 12.5h14v7l-7-3.8-7 3.8z"/>',
  email: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7l8 6 8-6"/>',
  youtube: '<rect x="2.5" y="5.5" width="19" height="13" rx="4"/><path d="M10.5 9.5v5l4-2.5z"/>',
  x: '<path d="M4.5 4.5l15 15M19.5 4.5l-15 15"/>',
};
const external = (url: string) => /^https?:\/\//.test(url);
---

<footer class="site-footer">
  <div class="container inner">
    <p class="slogan hand" lang={lang}>
      <Leaf size={22} class="slogan-leaf" />
      {t(lang, 'slogan')}
    </p>

    {
      links.length > 0 && (
        <ul class="social" aria-label={t(lang, 'socialLinks')}>
          {links.map((l) => (
            <li>
              <a
                href={l.url}
                aria-label={l.label}
                {...(external(l.url) ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
              >
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONS[l.icon]} />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="bottom">
      <nav aria-label={t(lang, 'legalNav')}>
        <ul class="legal">
          <li><a href={pathFor('privacyNotice', lang)}>{t(lang, 'navPrivacyNotice')}</a></li>
          <li><a href={pathFor('privacyPolicy', lang)}>{t(lang, 'navPrivacyPolicy')}</a></li>
        </ul>
      </nav>
      <p class="copy">© {year} {profile.name}</p>
      <a class="to-top" href="#top">
        {t(lang, 'backToTop')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
    text-align: center;
  }

  .slogan {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--forest);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .slogan :global(.slogan-leaf) {
    flex: none;
    color: var(--sage);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--forest);
  }

  .social a:hover {
    background: var(--sage-soft);
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal a,
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .legal a:hover,
  .to-top:hover {
    color: var(--forest);
    text-decoration: underline;
  }

  .copy {
    margin: 0;
  }

  @media (min-width: 1024px) {
    .bottom {
      flex-direction: row;
      justify-content: space-between;
    }

    .copy {
      order: -1;
    }
  }
</style>
