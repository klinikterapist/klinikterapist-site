---
import type { Lang } from '../lib/settings';
import { getLinks, getProfile } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Leaf from './Leaf.astro';
import Icon from './Icon.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const profile = getProfile();
const links = getLinks().filter((l) => l.inFooter);
const year = new Date().getFullYear();

const external = (url: string) => /^https?:\/\//.test(url);
---

<footer class="site-footer">
  <div class="container inner">
    <p class="slogan hand" lang={lang}>
      <Leaf size={22} class="slogan-leaf" />
      {t(lang, 'slogan')}
    </p>

    {
      links.length > 0 && (
        <ul class="social" aria-label={t(lang, 'socialLinks')}>
          {links.map((l) => (
            <li>
              <a
                href={l.url}
                aria-label={l.icon === 'email' ? t(lang, 'emailLabel') : l.label}
                {...(external(l.url) ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
              >
                <Icon name={l.icon} />
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <div class="bottom">
      <nav aria-label={t(lang, 'legalNav')}>
        <ul class="legal">
          <li><a href={pathFor('privacyNotice', lang)}>{t(lang, 'navPrivacyNotice')}</a></li>
          <li><a href={pathFor('privacyPolicy', lang)}>{t(lang, 'navPrivacyPolicy')}</a></li>
        </ul>
      </nav>
      <p class="copy">© {year} {profile.name}</p>
      <a class="to-top" href="#top">
        {t(lang, 'backToTop')}
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    padding-block: var(--space-6) var(--space-5);
    text-align: center;
  }

  .slogan {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--link);
    font-size: 1.75rem;
    line-height: 1.2;
  }

  .slogan :global(.slogan-leaf) {
    flex: none;
    color: var(--muted);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--link);
  }

  .social a:hover {
    background: var(--surface-2);
  }

  .bottom {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legal a,
  .to-top {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    color: var(--muted);
    text-decoration: none;
  }

  .legal a:hover,
  .to-top:hover {
    color: var(--link);
    text-decoration: underline;
  }

  .copy {
    margin: 0;
  }

  @media (min-width: 1024px) {
    .bottom {
      flex-direction: row;
      justify-content: space-between;
    }

    .copy {
      order: -1;
    }
  }
</style>
