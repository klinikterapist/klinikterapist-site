---
/**
 * Site footer. Every screen: the page end (copyright line, spec §5.5). Desktop only: the social
 * icons and the legal links with the cookie choice next to them (spec §5.7); on phones the accounts
 * live in the home page's "Sosyal medyada takip et" box and the cookie choice sits on the copyright line.
 */
import type { Lang } from '../lib/settings';
import { contactEmail, getLinks, getSeo } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import PageEnd from './ui/PageEnd.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
// The e-mail icon opens the address of the page's language (iletisim@ / hello@).
const links = getLinks()
  .filter((l) => l.inFooter)
  .map((l) => (l.icon === 'email' ? { ...l, url: `mailto:${contactEmail(lang)}` } : l));
const external = (url: string) => /^https?:\/\//.test(url);
// With Google Analytics on, the cookie choice can be changed from every page (Analytics.astro).
const hasAnalytics = Boolean(getSeo().gaId);
---

<footer class="site-footer">
  <div class="container desk">
    {
      links.length > 0 && (
        <ul class="social" aria-label={t(lang, 'socialLinks')}>
          {links.map((l) => (
            <li>
              <a
                href={l.url}
                aria-label={l.icon === 'email' ? t(lang, 'emailLabel') : l.label}
                {...(external(l.url) ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
              >
                <Icon name={l.icon} size={20} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <nav aria-label={t(lang, 'legalNav')}>
      <ul class="legal">
        <li><a href={pathFor('privacyNotice', lang)}>{t(lang, 'navPrivacyNotice')}</a></li>
        <li><a href={pathFor('privacyPolicy', lang)}>{t(lang, 'navPrivacyPolicy')}</a></li>
        {hasAnalytics && <li><button type="button" class="cookie-prefs" data-cookie-prefs>{t(lang, 'cookiePrefs')}</button></li>}
      </ul>
    </nav>
  </div>
  <div class="container">
    <PageEnd lang={lang} cookiePrefs={hasAnalytics} />
  </div>
</footer>

<style>
  .desk {
    display: none;
  }

  @media (min-width: 768px) {
    .site-footer {
      margin-top: var(--space-6);
      border-top: 1px solid var(--line);
    }

    .desk {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      padding-top: var(--space-3);
    }
  }

  .social,
  .legal {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--link);
  }

  .social a:hover {
    background: var(--surface);
  }

  .legal {
    gap: 0 var(--space-4);
  }

  .legal a,
  .cookie-prefs {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .cookie-prefs {
    padding: 0;
    border: 0;
    background: none;
    font-family: inherit;
    cursor: pointer;
  }

  .legal a:hover,
  .cookie-prefs:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
