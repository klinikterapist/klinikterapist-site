---
/**
 * Site footer. Every screen: the page end (112 line and copyright, spec §5.5). Desktop only: the
 * social icons and the legal links (spec §5.7); on phones the accounts live in the home page's
 * "Sosyal medyada takip et" box.
 */
import type { Lang } from '../lib/settings';
import { getLinks, getSeo } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import PageEnd from './ui/PageEnd.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const links = getLinks().filter((l) => l.inFooter);
const external = (url: string) => /^https?:\/\//.test(url);
// With Google Analytics on, the cookie choice can be changed from every page (Analytics.astro).
const hasAnalytics = Boolean(getSeo().gaId);
---

<footer class="site-footer">
  <div class="container desk">
    {
      links.length > 0 && (
        <ul class="social" aria-label={t(lang, 'socialLinks')}>
          {links.map((l) => (
            <li>
              <a
                href={l.url}
                aria-label={l.icon === 'email' ? t(lang, 'emailLabel') : l.label}
                {...(external(l.url) ? { target: '_blank', rel: 'noopener noreferrer me' } : {})}
              >
                <Icon name={l.icon} size={20} />
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <nav aria-label={t(lang, 'legalNav')}>
      <ul class="legal">
        <li><a href={pathFor('privacyNotice', lang)}>{t(lang, 'navPrivacyNotice')}</a></li>
        <li><a href={pathFor('privacyPolicy', lang)}>{t(lang, 'navPrivacyPolicy')}</a></li>
      </ul>
    </nav>
  </div>
  <div class="container">
    <PageEnd lang={lang} />
    {hasAnalytics && <button type="button" class="cookie-prefs" data-cookie-prefs>{t(lang, 'cookiePrefs')}</button>}
  </div>
</footer>

<style>
  .desk {
    display: none;
  }

  @media (min-width: 768px) {
    .site-footer {
      margin-top: var(--space-6);
      border-top: 1px solid var(--line);
    }

    .desk {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-2) var(--space-4);
      padding-top: var(--space-3);
    }
  }

  .social,
  .cookie-prefs {
    display: block;
    margin: 0 auto var(--space-4);
    padding: 8px;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--text-xs);
    text-decoration: underline;
    cursor: pointer;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    color: var(--link);
  }

  .social a:hover {
    background: var(--surface);
  }

  .legal {
    gap: 0 var(--space-4);
  }

  .legal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font-size: var(--text-xs);
    text-decoration: none;
  }

  .legal a:hover {
    color: var(--link);
    text-decoration: underline;
  }
</style>
