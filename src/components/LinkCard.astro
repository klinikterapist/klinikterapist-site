---
/** Soft rounded tile: icon, title, subtitle and a chevron. The whole tile is the link. */
import Icon from './Icon.astro';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  icon: string;
  /** External links open in a new tab. */
  external?: boolean;
  newTabLabel?: string;
}
const { href, title, subtitle, icon, external = false, newTabLabel } = Astro.props;
---

<a
  class="link-card card"
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <span class="icon-wrap"><Icon name={icon} /></span>
  <span class="text">
    <span class="title">{title}</span>
    {subtitle && <span class="subtitle">{subtitle}</span>}
    {external && newTabLabel && <span class="visually-hidden">{newTabLabel}</span>}
  </span>
  <Icon name="chevron" size={18} class="chev" />
</a>

<style>
  .link-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    min-height: 64px;
    padding: var(--space-3);
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .link-card:hover {
    border-color: var(--link);
    color: var(--text);
  }

  @media (prefers-reduced-motion: no-preference) {
    .link-card:hover {
      transform: translateY(-1px);
    }
  }

  .icon-wrap {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--link);
  }

  .text {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .subtitle {
    overflow-wrap: break-word;
    hyphens: auto;
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.35;
  }

  .link-card :global(.chev) {
    flex: none;
    color: var(--muted);
  }

  @media (max-width: 400px) {
    .link-card {
      gap: var(--space-2);
      padding: var(--space-3) var(--space-2);
    }

    .icon-wrap {
      width: 34px;
      height: 34px;
    }

    .link-card :global(.chev) {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .link-card {
      padding: var(--space-4);
    }

    .title {
      font-size: 1.125rem;
    }
  }
</style>
