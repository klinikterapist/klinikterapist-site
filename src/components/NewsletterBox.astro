---
/**
 * Newsletter call-out: links to the Substack page from links.json (no form, no third-party script).
 * `row` is the phone box ("Yeni yazılar e-postana gelsin"); `band` is the desktop band, inverted
 * like the home page's (navy by day, sunflower by night). Nothing renders without a Substack link.
 */
import type { Lang } from '../lib/settings';
import { getLinks } from '../lib/settings';
import { t } from '../i18n/ui';
import Icon from './Icon.astro';
import ListItem from './ui/ListItem.astro';

interface Props {
  lang: Lang;
  variant: 'row' | 'band';
}
const { lang, variant } = Astro.props;
const substack = getLinks().find((l) => l.icon === 'substack');
---

{
  substack &&
    (variant === 'row' ? (
      <ListItem
        class="newsletter"
        icon="mail"
        title={t(lang, 'blogNewsletterTitle')}
        subtitle={t(lang, 'newsletterItemHint')}
        href={substack.url}
      />
    ) : (
      <aside class="newsletter-band" aria-labelledby="newsletter-title">
        <Icon name="mail" size={26} />
        <div class="text">
          <b id="newsletter-title">{t(lang, 'blogNewsletterTitle')}</b>
          <small>{t(lang, 'blogNewsletterBand')}</small>
        </div>
        <a class="band-btn" href={substack.url} target="_blank" rel="noopener noreferrer">
          {t(lang, 'subscribe')}
          <span class="visually-hidden"> {t(lang, 'opensInNewTab')}</span>
        </a>
      </aside>
    ))
}

<style>
  .newsletter-band {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: 18px 22px;
    border-radius: 16px;
    background: var(--btn-bg);
    color: var(--btn-text);
  }

  .text {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .text b {
    font-size: 1rem;
  }

  .text small {
    font-size: var(--text-sm);
  }

  .band-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-5);
    border-radius: var(--radius-pill);
    background: var(--bg);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .band-btn:hover {
    background: var(--surface);
    color: var(--text);
  }
</style>
