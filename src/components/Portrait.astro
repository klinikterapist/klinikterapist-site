---
/** Portrait in an organic frame. A sage placeholder stands in until `profile.photo` is set. */
import type { Lang } from '../lib/settings';
import { getProfile } from '../lib/settings';
import Leaf from './Leaf.astro';

interface Props {
  lang: Lang;
  /** Rendered width in px (the frame scales down on small screens). */
  size?: number;
  eager?: boolean;
}
const { lang, size = 320, eager = false } = Astro.props;
const profile = getProfile();
---

<div class="portrait" style={`--portrait-size:${size}px`}>
  <span class="blob" aria-hidden="true"></span>
  {
    profile.photo ? (
      <img
        class="frame"
        src={profile.photo}
        alt={profile.photoAlt[lang]}
        width={size}
        height={Math.round(size * 1.1)}
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    ) : (
      <div class="frame placeholder" role="img" aria-label={profile.photoAlt[lang]}>
        <Leaf size={96} class="placeholder-leaf" />
      </div>
    )
  }
  <Leaf size={72} class="sprig" />
</div>

<style>
  .portrait {
    position: relative;
    width: min(var(--portrait-size), 100%);
    aspect-ratio: 1 / 1.1;
  }

  .blob {
    position: absolute;
    inset: 4% -4% -2% 8%;
    background: var(--sage-soft);
    border-radius: 62% 38% 54% 46% / 48% 58% 42% 52%;
  }

  .frame {
    position: absolute;
    inset: 0 6% 4% 0;
    width: 94%;
    height: 96%;
    object-fit: cover;
    border-radius: 48% 52% 44% 56% / 56% 46% 54% 44%;
  }

  .placeholder {
    display: grid;
    place-items: center;
    background:
      radial-gradient(120% 90% at 30% 20%, #eef1e8 0%, transparent 60%),
      linear-gradient(160deg, #c9d4c2 0%, var(--sage) 100%);
    color: var(--forest);
  }

  .placeholder :global(.placeholder-leaf) {
    width: 38%;
    height: auto;
    opacity: 0.75;
  }

  .portrait :global(.sprig) {
    position: absolute;
    right: -4%;
    bottom: 2%;
    width: 24%;
    height: auto;
    color: var(--sage);
  }
</style>
