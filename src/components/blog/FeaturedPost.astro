---
/**
 * The newest post, large, at the top of the blog list (spec §5.8).
 * - `phone`: one tappable box, wide cover, "YENİ YAZI", title, date · reading time (· read count);
 * - `desk`: the featured card, cover on the left, topic · "Yeni", title, description and date on the right.
 * Without a cover a sun-gradient block stands in (never an empty box or a broken image). Both looks
 * are in the page and CSS shows one; the covers are lazy so the hidden one is never downloaded.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../../lib/settings';
import { getCategories } from '../../lib/settings';
import type { PostEntry } from '../../lib/posts';
import { postPath } from '../../i18n/routes';
import { t } from '../../i18n/ui';
import { formatDate, isoDay } from '../../lib/date';
import { readCount, readsLabel } from '../../lib/read-counts';
import Icon from '../Icon.astro';

interface Props {
  post: PostEntry;
  lang: Lang;
  variant: 'phone' | 'desk';
}
const { post, lang, variant } = Astro.props;
const { data } = post;
const href = postPath(data.slug, lang);
const categoryLabel = getCategories().find((c) => c.id === data.category)?.label[lang].trim() ?? '';
const cover = data.cover as ImageMetadata | undefined;
const minutes = `${post.readingMinutes} ${t(lang, 'minRead')}`;
const reads = readsLabel(readCount(post.key), lang);
const desc = data.description.trim();
---

{
  variant === 'phone' ? (
    <a class="newest" href={href}>
      {cover ? (
        <Image
          src={cover}
          alt=""
          widths={[400, 800]}
          sizes="(min-width: 440px) 408px, calc(100vw - 56px)"
          loading="lazy"
          format="webp"
          class="newest-cover"
        />
      ) : (
        <span class="newest-cover placeholder" aria-hidden="true" />
      )}
      <span class="newest-text">
        <small class="label">{t(lang, 'newPost')}</small>
        <b class="newest-title">{data.title}</b>
        <small class="meta">
          <time datetime={isoDay(data.publishedAt)}>{formatDate(data.publishedAt, lang)}</time> · {minutes}
          {reads && (
            <span class="reads">
              {' · '}
              <Icon name="eye" size={13} />
              {reads}
            </span>
          )}
        </small>
      </span>
    </a>
  ) : (
    <article class="featured">
      {cover ? (
        <Image
          src={cover}
          alt={data.coverAlt ?? ''}
          widths={[480, 720, 960]}
          sizes="(min-width: 1200px) 600px, 52vw"
          loading="lazy"
          format="webp"
          class="featured-cover"
        />
      ) : (
        <div class="featured-cover placeholder" aria-hidden="true" />
      )}
      <div class="featured-text">
        <span class="tag">{[categoryLabel, t(lang, 'newLabel')].filter(Boolean).join(' · ')}</span>
        <h2>
          <a href={href}>{data.title}</a>
        </h2>
        {desc && <p class="desc">{desc}</p>}
        <small class="meta">
          <time datetime={isoDay(data.publishedAt)}>{formatDate(data.publishedAt, lang)}</time> · {minutes}
          {reads && (
            <span class="reads">
              {' · '}
              <Icon name="eye" size={14} />
              {reads}
            </span>
          )}
        </small>
      </div>
    </article>
  )
}

<style>
  .placeholder {
    display: block;
    background: linear-gradient(135deg, var(--sun-halo), var(--sun-disc));
  }

  .label,
  .tag {
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .meta {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .reads {
    white-space: nowrap;
  }

  .reads :global(svg) {
    display: inline;
    vertical-align: -2px;
  }

  /* Phone */
  .newest {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .newest :global(.newest-cover) {
    width: 100%;
    height: 150px;
    border-radius: 12px;
    object-fit: cover;
  }

  .newest-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 0 2px 2px;
  }

  .newest-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .newest:hover .newest-title {
    color: var(--link);
  }

  /* Desktop */
  .featured {
    position: relative;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 22px;
    align-items: center;
    padding: 16px;
    border-radius: 18px;
    background: var(--surface);
  }

  .featured :global(.featured-cover) {
    width: 100%;
    height: 240px;
    border-radius: 12px;
    object-fit: cover;
  }

  .featured-text {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  h2 {
    margin: 2px 0 4px;
    font-size: clamp(1.5rem, 1rem + 1.2vw, 1.875rem);
    line-height: 1.15;
  }

  h2 a {
    color: var(--text);
    text-decoration: none;
  }

  /* The whole card is clickable through the title link. */
  h2 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 18px;
  }

  h2 a:hover {
    color: var(--link);
  }

  .featured:has(a:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 3px;
  }

  h2 a:focus-visible {
    outline: none;
  }

  .desc {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  @media (max-width: 899px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
