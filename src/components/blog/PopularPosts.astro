---
/**
 * "Popüler yazılar" on the blog page (#popular, the target of the blog's Popular chip;
 * the tiles open the popular posts page). Renders nothing when there is no popular post (pickPopular: shown read counts, else featured).
 * `moreHref` adds "Tümünü gör" to the popular posts page.
 */
import type { Lang } from '../../lib/settings';
import type { PostEntry } from '../../lib/posts';
import { t } from '../../i18n/ui';
import PostCard from '../PostCard.astro';
import Icon from '../Icon.astro';

interface Props {
  lang: Lang;
  posts: PostEntry[];
  /** The popular posts page ("Tümünü gör"). */
  moreHref?: string;
}
const { lang, posts, moreHref } = Astro.props;
---

{
  posts.length > 0 && (
    <section id="popular" class="popular" aria-labelledby="popular-title" data-hide-on-filter>
      <div class="head">
        <h2 id="popular-title">{t(lang, 'popularPosts')}</h2>
        {moreHref && (
          <a class="more" href={moreHref}>
            {t(lang, 'seeAll')}
            <Icon name="arrow" size={16} />
          </a>
        )}
      </div>
      <ul>
        {posts.map((p) => (
          <li>
            <PostCard post={p} lang={lang} variant="row" />
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .popular {
    scroll-margin-top: var(--space-5);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin: 0 0 10px;
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  h2 {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    h2 {
      font-family: var(--font-serif);
      font-size: var(--text-xl);
      font-weight: 500;
      letter-spacing: -0.01em;
      text-transform: none;
      color: var(--text);
    }

    ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
