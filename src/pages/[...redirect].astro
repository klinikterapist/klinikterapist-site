---
/**
 * Old-address redirects from redirects.json. GitHub Pages has no server redirects, so each
 * `from` gets a tiny page that refreshes to `to`, is canonical to it and stays out of the index.
 */
import type { GetStaticPaths } from 'astro';
import { checkRedirectCollisions, getCategories, getRedirects, type Redirect } from '../lib/settings';
import { absoluteUrl } from '../lib/seo';
import { getPosts } from '../lib/posts';
import { categoryPath, postPath, staticPagePaths } from '../i18n/routes';

export const getStaticPaths = (async () => {
  const redirects = getRedirects();
  // A `from` that is a live page would be dropped by Astro with only a warning: fail instead.
  const posts = [...(await getPosts('tr')), ...(await getPosts('en'))];
  checkRedirectCollisions(redirects, [
    ...staticPagePaths(),
    ...getCategories().flatMap((c) => [categoryPath(c, 'tr'), categoryPath(c, 'en')]),
    ...posts.map((p) => postPath(p.data.slug, p.lang)),
  ]);
  return redirects.map((r) => ({
    // `/blog/eski-adres/` → `blog/eski-adres`
    params: { redirect: r.from.replace(/^\/+|\/+$/g, '') || undefined },
    props: { redirect: r },
  }));
}) satisfies GetStaticPaths;

const { redirect } = Astro.props as { redirect: Redirect };
const target = absoluteUrl(redirect.to);
const lang = redirect.to.startsWith('/en/') ? 'en' : 'tr';
const text = lang === 'en' ? 'This page has moved:' : 'Bu sayfa taşındı:';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${redirect.to}`} />
    <link rel="canonical" href={target} />
    <title>{lang === 'en' ? 'Redirecting…' : 'Yönlendiriliyor…'}</title>
  </head>
  <body>
    <p>{text} <a href={redirect.to}>{target}</a></p>
  </body>
</html>
