---
/**
 * The admin panel (spec §8). A client-only React app: no site header, never indexed,
 * and no other page loads its JavaScript.
 */
import '../../styles/tokens.css';
import '../../admin/ui/panel-tokens.css';
import '../../styles/prose.css';
import '../../admin/ui/admin.css';
import AdminRoot from '../../admin/ui/AdminRoot';
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#F4E9D4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1A2740" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Same logic as resolveTheme() in src/admin/ui/theme.ts, run before first paint.
      (function () {
        var stored = null;
        try { stored = localStorage.getItem('panel.theme'); } catch (e) {}
        var dark = false;
        try { dark = window.matchMedia('(prefers-color-scheme: dark)').matches; } catch (e) {}
        document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : dark ? 'dark' : 'light';
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Yönetim paneli · klinikterapist.com</title>
  </head>
  <body class="admin">
    <h1 class="k-visually-hidden">Yönetim paneli</h1>
    <noscript><p class="noscript">Yönetim paneli JavaScript gerektirir. Lütfen tarayıcınızda JavaScript'i açın.</p></noscript>
    <AdminRoot client:only="react" />
  </body>
</html>
