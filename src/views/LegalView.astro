---
/** Renders `<data>/legal/<name>.<lang>.md` in the new look, text unchanged. The text's own `#` heading is the page h1. */
import { getEntry, render } from 'astro:content';
import PageShell from '../layouts/PageShell.astro';
import type { Lang } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { t } from '../i18n/ui';

const DOCS = {
  aydinlatma: { key: 'privacyNotice', label: 'navPrivacyNotice', desc: 'privacyNoticeDesc' },
  gizlilik: { key: 'privacyPolicy', label: 'navPrivacyPolicy', desc: 'privacyPolicyDesc' },
} as const;

interface Props {
  lang: Lang;
  name: keyof typeof DOCS;
}
const { lang, name } = Astro.props;
const doc = DOCS[name];
const entry = await getEntry('legal', `${name}.${lang}`);
if (!entry) throw new Error(`Yasal metin eksik: legal/${name}.${lang}.md`);
const { Content, headings } = await render(entry);
const h1 = headings.find((h) => h.depth === 1)?.text;
const title = h1 ?? t(lang, doc.label);
const { meta, alternatePaths } = pageMeta(doc.key, lang, title, t(lang, doc.desc));
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <article class="container-text inner-page legal legal-page">
    {!h1 && <h1>{title}</h1>}
    <Content />
  </article>
</PageShell>

<style>
  .legal {
    font-size: var(--text-sm);
    line-height: 1.65;
  }

  .legal :global(h1) {
    margin: 4px 0 var(--space-4);
    font-size: 1.875rem;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.12;
    text-align: center;
  }

  .legal :global(h2) {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
  }

  .legal :global(h3) {
    margin-top: var(--space-5);
    font-size: var(--text-lg);
  }

  .legal :global(blockquote) {
    margin: var(--space-4) 0;
    padding: 12px 14px;
    border-left: 4px solid var(--quote-rule);
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    background: var(--surface);
  }

  .legal :global(blockquote p) {
    margin: 0;
  }

  .legal :global(ul),
  .legal :global(ol) {
    padding-left: var(--space-5);
  }

  .legal :global(table) {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
  }

  .legal :global(h2),
  .legal :global(h3) {
    font-variation-settings: 'SOFT' 100;
  }

  .legal :global(th),
  .legal :global(td) {
    padding: var(--space-2);
    border: 1px solid var(--line);
    text-align: left;
  }

  @media (min-width: 768px) {
    .legal {
      font-size: var(--text-base);
    }

    .legal :global(h1) {
      font-size: var(--text-2xl);
    }
  }
</style>
