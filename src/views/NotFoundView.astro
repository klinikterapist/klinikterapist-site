---
/** Bilingual 404: Turkish first (site default), English below, links to both home pages. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Leaf from '../components/Leaf.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../lib/settings';
import { buildMeta } from '../lib/seo';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const alternatePaths = { tr: pathFor('home', 'tr'), en: pathFor('home', 'en') };
const meta = buildMeta({
  lang,
  title: `${t('tr', 'notFoundTitle')} · ${t('en', 'notFoundTitle')}`,
  description: `${t(lang, 'notFoundText')} ${t(other, 'notFoundText')}`,
  path: '/404.html',
  alternates: alternatePaths,
});
---

<BaseLayout lang={lang} meta={meta} alternatePaths={alternatePaths} noindex>
  <div class="container-text not-found">
    <Leaf size={88} class="nf-leaf" />
    <p class="code" aria-hidden="true">404</p>
    <h1>{t(lang, 'notFoundTitle')}</h1>
    <p class="text">{t(lang, 'notFoundText')}</p>
    <a class="btn" href={pathFor('home', lang)}>
      <Icon name="home" size={18} />
      {t(lang, 'backHome')}
    </a>

    <div class="other" lang={other}>
      <p class="other-title">{t(other, 'notFoundTitle')}</p>
      <p class="text">{t(other, 'notFoundText')}</p>
      <a class="to-other" href={pathFor('home', other)}>
        {t(other, 'backHome')}
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: var(--space-7);
    text-align: center;
  }

  .not-found :global(.nf-leaf) {
    color: var(--sage);
  }

  .code {
    margin: 0;
    color: var(--forest);
    font-family: var(--font-hand);
    font-size: 3.5rem;
    line-height: 1;
  }

  h1 {
    margin: var(--space-2) 0 var(--space-3);
  }

  .text {
    max-width: 28rem;
    color: var(--muted);
  }

  .other {
    width: 100%;
    margin-top: var(--space-7);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .other-title {
    margin: 0 0 var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
  }

  .other .text {
    margin-inline: auto;
  }

  .to-other {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-height: 44px;
    font-weight: 500;
  }
</style>
