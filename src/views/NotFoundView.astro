---
/** Bilingual 404 in the new look: the sun, Turkish first (site default), English below, links to both home pages. */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import ListItem from '../components/ui/ListItem.astro';
import type { Lang } from '../lib/settings';
import { buildMeta } from '../lib/seo';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const alternatePaths = { tr: pathFor('home', 'tr'), en: pathFor('home', 'en') };
const meta = buildMeta({
  lang,
  title: `${t('tr', 'notFoundTitle')} · ${t('en', 'notFoundTitle')}`,
  description: `${t(lang, 'notFoundText')} ${t(other, 'notFoundText')}`,
  path: '/404.html',
  alternates: alternatePaths,
});
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths} noindex>
  <div class="container-text inner-page not-found">
    <PageHead title={t(lang, 'notFoundTitle')}>
      <RoundPortrait slot="media" photo={null} alt="" size={96} />
      <p class="ti code" aria-hidden="true">404</p>
      <p class="lead">{t(lang, 'notFoundText')}</p>
    </PageHead>

    <div class="page-stack">
      <ListItem icon="home" title={t(lang, 'backHome')} href={pathFor('home', lang)} />
    </div>

    <div class="other" lang={other}>
      <p class="other-title">{t(other, 'notFoundTitle')}</p>
      <p class="text">{t(other, 'notFoundText')}</p>
      <ListItem icon="home" title={t(other, 'backHome')} href={pathFor('home', other)} />
    </div>
  </div>
</PageShell>

<style>
  .other {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .other-title {
    margin: 0 0 var(--space-1);
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-variation-settings: 'SOFT' 100;
  }

  .text {
    margin: 0 0 var(--space-4);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .other :global(.list-item) {
    text-align: left;
  }
</style>
