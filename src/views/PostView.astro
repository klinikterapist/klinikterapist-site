---
/**
 * One blog post (spec §5.8): centred topic, title and subtitle; under a hairline the left-aligned byline
 * (sun, "name · title", "date · N dk okuma · reads"); the 16:9 cover (edge to edge on phones); the
 * Markdown body; then the Kaynakça accordion, the share button, the author box and two similar posts.
 */
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import PageShell from '../layouts/PageShell.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import AuthorBox from '../components/AuthorBox.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import SunMark from '../components/brand/SunMark.astro';
import ShareButton from '../components/post/ShareButton.astro';
import '../styles/prose.css';
import References from '../components/References.astro';
import { getCategories, getProfile } from '../lib/settings';
import { readCount, readsLabel } from '../lib/read-counts';
import type { PostEntry } from '../lib/posts';
import { getRelated, getTranslation } from '../lib/posts';
import { absoluteUrl, buildMeta } from '../lib/seo';
import { blogPostingLd, breadcrumbLd } from '../lib/jsonld';
import { formatDate, isoDay } from '../lib/date';
import { categoryPath, pathFor, postPath } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  post: PostEntry;
}
const { post } = Astro.props;
const { lang, data } = post;

const translation = await getTranslation(post);
const alternatePaths =
  lang === 'tr'
    ? { tr: postPath(data.slug, 'tr'), en: postPath(translation.data.slug, 'en') }
    : { tr: postPath(translation.data.slug, 'tr'), en: postPath(data.slug, 'en') };
const path = alternatePaths[lang];
const translationUrl = absoluteUrl(alternatePaths[translation.lang]);

const cover = data.cover as ImageMetadata | undefined;
// Share image: a JPEG rendition of the cover (widest support); the default from seo.json otherwise.
const shareImage = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;

const meta = buildMeta({
  lang,
  title: data.seoTitle ?? data.title,
  description: data.description,
  path,
  alternates: alternatePaths,
  image: shareImage,
  type: 'article',
});
meta.og['article:published_time'] = data.publishedAt.toISOString();
if (data.updatedAt) meta.og['article:modified_time'] = data.updatedAt.toISOString();

const category = getCategories().find((c) => c.id === data.category);
const crumbs = [
  { name: t(lang, 'navHome'), href: pathFor('home', lang) },
  { name: t(lang, 'navBlog'), href: pathFor('blog', lang) },
  ...(category ? [{ name: category.label[lang], href: categoryPath(category, lang) }] : []),
  { name: data.title, href: path },
];
const jsonLd = [
  blogPostingLd(post, translationUrl),
  breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: absoluteUrl(c.href) }))),
];

const related = await getRelated(post, 2);
const profile = getProfile();
const reads = readsLabel(readCount(post.key), lang);
const { Content } = await render(post as never);
const rss = lang === 'tr' ? '/rss.xml' : '/en/rss.xml';
---

<PageShell lang={lang} meta={meta} jsonLd={jsonLd} alternatePaths={alternatePaths} back={{ href: pathFor('blog', lang), label: t(lang, 'navBlog') }}>
  <link slot="head" rel="alternate" type="application/rss+xml" title={t(lang, 'rssTitle')} href={absoluteUrl(rss)} />

  <article class="post">
    <header class="container-text post-head">
      <Breadcrumb lang={lang} items={crumbs} />
      {category && <a class="category" href={categoryPath(category, lang)}>{category.label[lang]}</a>}
      <h1>{data.title}</h1>
      <p class="standfirst">{data.subtitle || data.description}</p>
      <div class="byline byline--left">
        <SunMark size={36} />
        <p>
          <span class="byline-name"><b>{profile.name}</b> · {profile.title[lang]}</span>
          <span class="byline-meta">
            <span class="visually-hidden">{t(lang, 'published')}: </span>
            <time datetime={isoDay(data.publishedAt)}>{formatDate(data.publishedAt, lang)}</time>
            <span aria-hidden="true">·</span>
            <span>{post.readingMinutes} {t(lang, 'minRead')}</span>
            {
              reads && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="reads">
                    <Icon name="eye" size={14} />
                    {reads}
                  </span>
                </>
              )
            }
          </span>
          {
            data.updatedAt && (
              <span class="updated">
                {t(lang, 'lastUpdated')}: <time datetime={isoDay(data.updatedAt)}>{formatDate(data.updatedAt, lang)}</time>
              </span>
            )
          }
        </p>
      </div>
    </header>

    {
      cover && (
        <figure class="cover-wrap">
          <Image
            src={cover}
            alt={data.coverAlt ?? ''}
            widths={[480, 800, 1200, 1600]}
            sizes="(min-width: 960px) 880px, 100vw"
            loading="eager"
            fetchpriority="high"
            class="cover"
          />
        </figure>
      )
    }

    <div class="container-text">
      <div class="prose">
        <Content />
      </div>
      <div class="post-end">
        <References references={data.references ?? []} body={post.body ?? ''} lang={lang} />
        <ShareButton lang={lang} title={data.title} url={absoluteUrl(path)} />
        <AuthorBox lang={lang} />
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="container-text related" aria-labelledby="related-title">
        <h2 id="related-title">{t(lang, 'similarPosts')}</h2>
        <ul class="posts">
          {related.map((p) => (
            <li>
              <PostCard post={p} lang={lang} variant="row" />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</PageShell>
<script>
  // Click-to-load: no request to YouTube until the reader asks for the video.
  for (const box of document.querySelectorAll<HTMLElement>('.prose .youtube[data-id]')) {
    const id = box.dataset.id ?? '';
    const link = box.querySelector('a');
    if (!/^[A-Za-z0-9_-]{11}$/.test(id) || !link) continue;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const frame = document.createElement('iframe');
      frame.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1`;
      frame.title = link.textContent ?? 'YouTube';
      frame.allow = 'autoplay; encrypted-media; picture-in-picture';
      frame.allowFullscreen = true;
      box.replaceChildren(frame);
    });
  }
</script>

<style>
  .post {
    padding-top: var(--space-4);
  }

  /* Topic, title and subtitle centred; the byline under them starts at the left. */
  .post-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .post-head :global(.breadcrumb) {
    align-self: stretch;
    text-align: left;
  }

  .category {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-top: var(--space-2);
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .category:hover {
    text-decoration: underline;
  }

  h1 {
    margin: var(--space-1) 0;
    font-size: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
    font-variation-settings: 'SOFT' 100;
  }

  .standfirst {
    margin: 0 0 var(--space-1);
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .byline {
    display: flex;
    align-items: center;
    gap: 10px;
    align-self: stretch;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
    line-height: 1.35;
  }

  .byline--left {
    justify-content: flex-start;
    text-align: left;
  }

  .byline :global(.sun-mark) {
    flex: none;
  }

  .byline p {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
  }

  .byline-meta,
  .updated {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
    color: var(--muted);
  }

  .reads {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .updated {
    font-style: italic;
  }

  .post-end {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-bottom: var(--space-5);
  }

  .related {
    padding-bottom: var(--space-6);
  }

  .related h2 {
    margin: 0 0 10px;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .posts {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 768px) {
    .post {
      padding-top: var(--space-6);
    }

    .standfirst {
      font-size: var(--text-lg);
    }

    .byline {
      margin-top: var(--space-5);
      font-size: var(--text-sm);
    }

    .posts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
