---
/** Appointment (spec §5.9): the same content in the new look. Phase 1: booking is coming soon; e-mail for now. */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import ListItem from '../components/ui/ListItem.astro';
import type { Lang } from '../lib/settings';
import { getContact } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const title = t(lang, 'bookSession');
const { meta, alternatePaths } = pageMeta('appointment', lang, title, t(lang, 'appointmentSoon'));
const { email } = getContact();
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container-text inner-page appointment">
    <PageHead title={title}>
      <RoundPortrait slot="media" photo={null} alt="" size={96} />
      <p class="lead">{t(lang, 'appointmentSoon')}</p>
    </PageHead>

    <div class="page-stack">
      <ListItem class="mail" icon="email" title={t(lang, 'sendEmail')} subtitle={email} href={`mailto:${email}`} />
      <ListItem icon="chat" title={t(lang, 'goToContact')} href={pathFor('contact', lang)} />
    </div>
  </div>
</PageShell>
