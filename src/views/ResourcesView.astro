---
/**
 * Resources (spec §5.9): heading and the owner's note (resources.json myNote); the featured resource
 * as a big card; "Türüne göre" tiles, one per type that has resources, each jumping to (and opening)
 * that type's accordion; then one accordion per type with its resources (the featured one included).
 */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import Accordion from '../components/ui/Accordion.astro';
import Icon from '../components/Icon.astro';
import ToneTile from '../components/ui/ToneTile.astro';
import { RESOURCE_TONES } from '../lib/tones';
import type { Lang, Resource } from '../lib/settings';
import { getResources } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { t, tCount, type UiKey } from '../i18n/ui';
import { isExternalUrl, newTabAttrs } from '../lib/safe-link';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const title = t(lang, 'navResources');
const { items, myNote } = getResources();
const note = myNote[lang].trim();
const { meta, alternatePaths } = pageMeta('resources', lang, title, note || t(lang, 'resourcesLead'));

const TYPES: Resource['type'][] = ['book', 'article', 'scale', 'video', 'podcast', 'guide'];
const featured = items.find((r) => r.featured);
const groups = TYPES.map((type) => ({ type, items: items.filter((r) => r.type === type) })).filter((g) => g.items.length > 0);
const upper = (s: string) => s.toLocaleUpperCase(lang === 'tr' ? 'tr-TR' : 'en-US');
const typeName = (type: Resource['type']) => t(lang, `type_${type}` as UiKey);
const typesName = (type: Resource['type']) => t(lang, `types_${type}` as UiKey);
const anchor = (type: Resource['type']) => `tur-${type}`;
// The "Türüne göre" block always has all six types; a type without resources is a muted tile, not a link.
const hasType = (type: Resource['type']) => groups.some((g) => g.type === type);
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container-text inner-page resources">
    <PageHead title={title} icon="book" tone="lavanta">
      <p class="lead">{note || t(lang, 'resourcesLead')}</p>
    </PageHead>

    <div class="page-stack">
      {
        featured && (
          <a class="featured-card" href={featured.url} {...newTabAttrs(featured.url)}>
            <span class="cov" aria-hidden="true">
              {featured.cover ? (
                <img src={featured.cover} alt="" width="120" height="160" loading="lazy" decoding="async" />
              ) : (
                <Icon name={featured.type} size={44} />
              )}
            </span>
            <span class="bt">
              <small class="label chip" style={`--chip-fg: var(--tone-${RESOURCE_TONES[featured.type]}); --chip-bg: var(--tone-${RESOURCE_TONES[featured.type]}-bg)`}>
                {upper(t(lang, 'featured'))} · {upper(typeName(featured.type))}
              </small>
              <b class="title">{featured.title}</b>
              <small class="sub">{[featured.author?.trim(), featured.note[lang].trim()].filter(Boolean).join(' · ')}</small>
              {isExternalUrl(featured.url) && <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>}
            </span>
          </a>
        )
      }

      {
        groups.length > 0 && (
          <nav class="by-type" aria-labelledby="by-type-title">
            <h2 id="by-type-title" class="section-label">
              {t(lang, 'byType')}
            </h2>
            <ul class="type-tiles">
              {TYPES.map((type) => (
                <li>
                  {hasType(type) ? (
                    <a class="tile" href={`#${anchor(type)}`}>
                      <ToneTile icon={type} tone={RESOURCE_TONES[type]} size={40} />
                      <b>{typesName(type)}</b>
                    </a>
                  ) : (
                    <span class="tile tile-empty">
                      <Icon name={type} size={22} />
                      <b>{typesName(type)}</b>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      {
        groups.map((g, i) => (
          <Accordion
            class="type-acc"
            id={anchor(g.type)}
            icon={g.type}
            tone={RESOURCE_TONES[g.type]}
            title={typesName(g.type)}
            subtitle={tCount(lang, 'resourcesOne', 'resourcesMany', g.items.length)}
            open={i === 0}
          >
            {g.items.map((r) => (
              <a class="res" href={r.url} {...newTabAttrs(r.url)}>
                <span class="res-text">
                  <span class="res-title">
                    {r.title}
                    {r.author && <span class="res-author"> · {r.author}</span>}
                  </span>
                  {r.note[lang].trim() && <small>{r.note[lang]}</small>}
                  {isExternalUrl(r.url) && <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>}
                </span>
                {isExternalUrl(r.url) && <Icon name="external" size={16} class="res-ext" />}
              </a>
            ))}
          </Accordion>
        ))
      }
    </div>
  </div>
</PageShell>

<script>
  // A type tile opens its accordion as well as jumping to it (also for a link that arrives with the hash).
  const openFor = (hash: string) => {
    const box = hash.startsWith('#tur-') ? document.getElementById(hash.slice(1)) : null;
    if (box instanceof HTMLDetailsElement) box.open = true;
  };
  for (const a of document.querySelectorAll<HTMLAnchorElement>('.type-tiles a')) {
    a.addEventListener('click', () => openFor(a.hash));
  }
  openFor(location.hash);
</script>

<style>
  .featured-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }

  .cov {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 120px;
    overflow: hidden;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--sun-halo), var(--sun-disc));
    color: var(--sun-face); /* dark on the sunflower gradient in both themes */
  }

  .cov img {
    height: 100%;
    width: auto;
  }

  .bt {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 4px 2px 2px;
  }

  .label {
    color: var(--link);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* The featured card's "ÖNE ÇIKAN · KİTAP" in the type's tone. */
  .label.chip {
    align-self: flex-start;
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    background: var(--chip-bg);
    color: var(--chip-fg);
  }

  .title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.25;
  }

  .sub {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .by-type {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .type-tiles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .type-tiles .tile {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    min-height: 44px;
    height: 100%;
    padding: 12px 6px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--text);
    font-size: 0.84375rem;
    text-align: center;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .type-tiles .tile > :global(.icon) {
    color: var(--link);
  }

  /* No resources of this type yet: shown for the full picture, quiet and not tappable. */
  .type-tiles .tile-empty {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--muted);
  }

  .type-tiles .tile-empty > :global(.icon) {
    color: var(--muted);
  }

  .type-tiles b {
    margin-top: 4px;
    font-weight: 600;
  }

  :global(.type-acc) {
    scroll-margin-top: var(--space-4);
  }

  .res {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 2px;
    border-top: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
  }

  .res-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .res-title {
    font-size: 0.84375rem;
    font-weight: 500;
  }

  .res-author {
    color: var(--muted);
    font-weight: 400;
  }

  .res small {
    color: var(--muted);
    font-size: var(--text-xs);
    line-height: 1.45;
  }

  .res :global(.res-ext) {
    flex: none;
    color: var(--muted);
  }

  .res:hover .res-title {
    text-decoration: underline;
  }
</style>
