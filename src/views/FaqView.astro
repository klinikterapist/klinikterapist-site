---
/**
 * FAQ page (spec §10): the answered questions as Accordions, each with its id as the anchor. The home
 * page links to `#ilk-gorusme` (open by default) and `#on-gorusme`; a tiny script opens the box the
 * address points at, so a linked answer is never closed.
 */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import Accordion from '../components/ui/Accordion.astro';
import ListItem from '../components/ui/ListItem.astro';
import type { Lang } from '../lib/settings';
import { getFaq } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { faqPageLd } from '../lib/jsonld';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';
import { toneAt } from '../lib/tones';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const title = t(lang, 'faqTitle');
const { meta, alternatePaths } = pageMeta('faq', lang, title, t(lang, 'faqDesc'));
const faq = getFaq(lang);
const ld = faqPageLd(lang);
---

<PageShell lang={lang} meta={meta} jsonLd={ld ? [ld] : undefined} alternatePaths={alternatePaths}>
  <div class="container-text inner-page faq-page">
    <PageHead title={title} icon="help" tone="deniz">
      <p class="lead">{t(lang, 'faqDesc')}</p>
    </PageHead>

    {
      faq.length > 0 ? (
        <div class="page-stack">
          {faq.map((f, i) => (
            <Accordion title={f.q} id={f.id} icon={f.icon || 'help'} tone={toneAt(i)} open={f.id === 'ilk-gorusme'}>
              <p class="answer">{f.a}</p>
            </Accordion>
          ))}
        </div>
      ) : (
        <div class="page-stack">
          <p class="empty">{t(lang, 'faqEmpty')}</p>
          <ListItem icon="chat" tone="deniz" title={t(lang, 'goToContact')} href={pathFor('contact', lang)} />
        </div>
      )
    }
  </div>
</PageShell>

<script is:inline>
  (function () {
    function openTarget() {
      var id = decodeURIComponent(location.hash.slice(1));
      var el = id && document.getElementById(id);
      if (el && el.tagName === 'DETAILS') el.open = true;
    }
    openTarget();
    addEventListener('hashchange', openTarget);
  })();
</script>

<style>
  .answer,
  .empty {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .empty {
    text-align: center;
  }
</style>
