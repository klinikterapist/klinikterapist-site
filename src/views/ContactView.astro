---
/**
 * Contact (spec §5.9, owner's review 2026-10-18): photo (or the sun), "İletişim", the intro; the contact
 * form (with a note sending appointment questions to the Randevu page); then "E-posta gönder", the
 * "Online görüşme" / "Dönüş süresi" pair, the social accordion, the membership, and the emergency note
 * in a dashed box drawn with theme tokens (readable by day and by night).
 */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import ListItem from '../components/ui/ListItem.astro';
import TilePair from '../components/ui/TilePair.astro';
import SocialAccordion from '../components/ui/SocialAccordion.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import type { Lang } from '../lib/settings';
import { getContact, getProfile } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const contact = getContact();
const profile = getProfile();
const title = t(lang, 'navContact');
const intro = contact.intro[lang].trim();
const { meta, alternatePaths } = pageMeta('contact', lang, title, intro);

/** "Dönüş süresi: 24–48 saat." under the title "Dönüş süresi" reads "24–48 saat.". */
function withoutLabel(text: string, label: string): string {
  const locale = lang === 'tr' ? 'tr-TR' : 'en-US';
  if (!text.toLocaleLowerCase(locale).startsWith(label.toLocaleLowerCase(locale))) return text;
  const rest = text.slice(label.length);
  return /^\s*:/.test(rest) ? rest.replace(/^\s*:\s*/, '') : text;
}

type Tile = { title: string; subtitle: string; icon: string };
const facts: Tile[] = [
  { title: t(lang, 'onlineSessions'), subtitle: contact.workStyle[lang].trim(), icon: 'laptop' },
  { title: t(lang, 'responseTitle'), subtitle: withoutLabel(contact.responseTime[lang].trim(), t(lang, 'responseTitle')), icon: 'clock' },
].filter((f) => f.subtitle);
const factPair: [Tile] | [Tile, Tile] | null = facts.length === 2 ? [facts[0], facts[1]] : facts.length === 1 ? [facts[0]] : null;

const memberships = (profile.memberships ?? [])
  .map((m) => ({ org: m.org[lang].trim(), number: m.number?.trim() ?? '' }))
  .filter((m) => m.org);
const emergency = contact.emergencyNote[lang].trim();
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container-text inner-page contact">
    <PageHead title={title}>
      <RoundPortrait slot="media" photo={profile.photo} alt={profile.photoAlt[lang]} size={96} eager />
      {intro && <p class="lead">{intro}</p>}
    </PageHead>

    <div class="page-stack">
      <ContactForm lang={lang} email={contact.email} />

      <ListItem icon="email" tone="lacivert" title={t(lang, 'sendEmail')} subtitle={contact.email} href={`mailto:${contact.email}`} />

      {
        factPair && (
          <div class="facts">
            <TilePair tiles={factPair} />
          </div>
        )
      }

      <SocialAccordion lang={lang} />

      {
        memberships.map((m) => (
          <ListItem
            class="membership"
            icon="shield"
            tone="adacayi"
            title={t(lang, 'memberOf').replace('{org}', m.org)}
            subtitle={m.number ? t(lang, 'memberNo').replace('{n}', m.number) : undefined}
          />
        ))
      }

      {
        emergency && (
          <aside class="emergency-box" aria-label={t(lang, 'emergency')}>
            <Icon name="alert" size={20} />
            <p>{emergency}</p>
          </aside>
        )
      }
    </div>
  </div>
</PageShell>

<style>
  .emergency-box {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 12px 14px;
    border: 1px dashed var(--line);
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .emergency-box :global(.icon) {
    flex: none;
    margin-top: 1px;
    color: var(--text);
  }

  .emergency-box p {
    margin: 0;
  }
</style>
