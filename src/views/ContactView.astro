---
/**
 * Contact (owner's choice B, 2026-10-23): a short head (photo, "İletişim", the intro), the form that
 * starts with the topic cards (with the note sending appointment questions to the Randevu page), one
 * row of ways to reach me (e-mail, response time, social accounts) and the emergency note. The page
 * does one job; the "Online görüşme" box, the social accordion and the membership line are gone (the
 * membership stays on Hakkımda and in the search data). Same layout on the phone, in one column.
 */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import type { Lang } from '../lib/settings';
import { contactEmail, getContact, getLinks, getProfile } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const contact = getContact();
const email = contactEmail(lang);
const profile = getProfile();
const title = t(lang, 'navContact');
const intro = contact.intro[lang].trim();
const { meta, alternatePaths } = pageMeta('contact', lang, title, intro);

// "Dönüş süresi: 24–48 saat." as written in the panel, so the chip says what the time is.
const response = contact.responseTime[lang].trim();
const socials = getLinks().filter((l) => l.icon !== 'email');
const emergency = contact.emergencyNote[lang].trim();
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container-text inner-page contact">
    <PageHead title={title}>
      <RoundPortrait slot="media" photo={profile.photo} alt={profile.photoAlt[lang]} size={96} eager />
      {intro && <p class="lead">{intro}</p>}
    </PageHead>

    <div class="page-stack">
      <ContactForm lang={lang} email={email} />

      <ul class="reach" aria-label={t(lang, 'otherWays')}>
        <li>
          <a href={`mailto:${email}`}><Icon name="email" size={18} />{email}</a>
        </li>
        {
          response && (
            <li>
              <span><Icon name="clock" size={18} />{response}</span>
            </li>
          )
        }
        {
          socials.map((l) => (
            <li>
              <a href={l.url} target="_blank" rel="noopener noreferrer me" aria-label={l.label} title={l.label} class="soc">
                <Icon name={l.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>

      {
        emergency && (
          <aside class="emergency-box" aria-label={t(lang, 'emergency')}>
            <Icon name="alert" size={18} />
            <p>{emergency}</p>
          </aside>
        )
      }
    </div>
  </div>
</PageShell>

<style>
  .reach {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .reach a,
  .reach span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .reach a:hover {
    background: var(--surface-2);
    color: var(--text);
  }

  .reach .soc {
    justify-content: center;
    width: 44px;
    padding: 0;
  }

  .reach :global(.icon) {
    flex: none;
    color: var(--link);
  }

  .emergency-box {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 12px;
    border-left: 3px solid #d9534f;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--muted);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .emergency-box :global(.icon) {
    flex: none;
    margin-top: 1px;
    color: #d9534f;
  }

  .emergency-box p {
    margin: 0;
  }
</style>
