---
import BaseLayout from '../layouts/BaseLayout.astro';
import Portrait from '../components/Portrait.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import Leaf from '../components/Leaf.astro';
import type { Lang } from '../lib/settings';
import { getAbout, getProfile } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { renderMarkdown } from '../lib/markdown';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const about = getAbout();
const profile = getProfile();
const { meta, alternatePaths } = pageMeta('about', lang, about.heading[lang], about.lead[lang]);
---

<BaseLayout lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container about">
    <header class="page-head">
      <div class="head-text">
        <h1>{about.heading[lang]}</h1>
        <p class="lead">{about.lead[lang]}</p>
        <span class="rule" aria-hidden="true"></span>
      </div>
      <div class="head-photo">
        <Portrait lang={lang} size={300} eager />
        <p class="badge hand">{profile.tagline[lang]}</p>
      </div>
    </header>

    {
      about.areas.length > 0 && (
        <section class="areas card" aria-labelledby="areas-title">
          <h2 id="areas-title" class="visually-hidden">{t(lang, 'areasOfWork')}</h2>
          <ul>
            {about.areas.map((a) => (
              <li>
                <Icon name={a.icon} size={26} />
                <span>{a.label[lang]}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="who" aria-labelledby="who-title">
      <div class="who-text">
        <h2 id="who-title">{t(lang, 'whoAmI')}</h2>
        <div class="md" set:html={renderMarkdown(about.whoAmI[lang])} />
      </div>
      <figure class="quote card">
        <Icon name="quote" size={28} class="quote-mark" />
        <blockquote><p>{about.quote[lang]}</p></blockquote>
        <span class="rule" aria-hidden="true"></span>
      </figure>
    </section>

    <section class="why" aria-labelledby="why-title">
      <div class="why-text">
        <h2 id="why-title">
          <Icon name="leaf" size={22} />
          {t(lang, 'whyThisWork')}
        </h2>
        <div class="md" set:html={renderMarkdown(about.whyThisWork[lang])} />
      </div>
      <Leaf size={120} class="why-leaf" />
    </section>

    {
      about.timeline.length > 0 && (
        <section class="edu" aria-labelledby="edu-title">
          <h2 id="edu-title">
            <Icon name="grad" size={24} />
            {t(lang, 'education')}
          </h2>
          <Timeline lang={lang} items={about.timeline} />
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .about {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-4);
  }

  .page-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 46%);
    gap: var(--space-4);
    align-items: center;
  }

  .page-head h1 {
    margin-bottom: var(--space-3);
    font-size: clamp(1.875rem, 1.2rem + 3vw, 3.25rem);
  }

  .lead {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .rule {
    display: block;
    width: 2.5rem;
    height: 1px;
    margin-top: var(--space-4);
    background: var(--btn-bg);
  }

  .head-photo {
    position: relative;
    display: flex;
    justify-content: flex-end;
  }

  .badge {
    position: absolute;
    right: 0;
    bottom: -0.5rem;
    max-width: 8.5rem;
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md) var(--radius-md) var(--radius-md) var(--radius-sm);
    background: var(--btn-bg);
    color: var(--btn-text);
    font-size: 1.125rem;
    line-height: 1.1;
  }

  .areas ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin: 0;
    padding: var(--space-2);
    list-style: none;
  }

  .areas li {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-2);
    color: var(--text);
    font-size: var(--text-xs);
    font-weight: 500;
    line-height: 1.35;
    text-align: center;
  }

  .areas li :global(.icon) {
    color: var(--link);
  }

  .who {
    display: grid;
    gap: var(--space-4);
  }

  /* Markdown output (about.json whoAmI / whyThisWork): paragraphs, lists, links. */
  .md :global(p),
  .md :global(ul),
  .md :global(ol) {
    margin: 0 0 var(--space-3);
  }

  .md > :global(:last-child) {
    margin-bottom: 0;
  }

  .quote {
    margin: 0;
    padding: var(--space-5);
    background: var(--surface-2);
    border-color: transparent;
    box-shadow: none;
  }

  .quote :global(.quote-mark) {
    color: var(--link);
  }

  .quote blockquote {
    margin: var(--space-2) 0 0;
  }

  .quote p {
    margin: 0;
    color: var(--link);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    line-height: 1.4;
  }

  .why {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }

  .why h2,
  .edu h2 {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xl);
  }

  .why h2 :global(.icon),
  .edu h2 :global(.icon) {
    flex: none;
    color: var(--link);
  }

  .why .md {
    font-size: var(--text-sm);
  }

  .why :global(.why-leaf) {
    flex: none;
    display: none;
    color: var(--link);
    opacity: 0.55;
  }

  @media (min-width: 640px) {
    .areas ul {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .areas li + li {
      border-left: 1px solid var(--line);
    }

    .who {
      grid-template-columns: minmax(0, 1fr) minmax(0, 34%);
      align-items: start;
    }

    .why :global(.why-leaf) {
      display: block;
    }

    .lead {
      font-size: var(--text-base);
    }
  }

  @media (min-width: 1024px) {
    .about {
      gap: var(--space-7);
      padding-top: var(--space-6);
    }

    .page-head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 38%);
      gap: var(--space-7);
    }

    .badge {
      right: 4%;
      font-size: 1.375rem;
    }

    .why .md {
      font-size: var(--text-base);
    }

    .why,
    .edu {
      max-width: 56rem;
    }
  }
</style>
