---
/**
 * About (spec §5.9): "Hakkımda" first, centred at the top of the page (owner's review 2026-10-19), then
 * the photo (or the sun), name and title, membership, the lead sentence;
 * accordions "Ben kimim?" (open), "Bu işi neden yapıyorum?", the work areas as tile pairs,
 * "Eğitim ve deneyim" (timeline) and a row to the contact page. Empty texts render nothing.
 * Desktop (from 768 px): a biography / CV page (owner's review 2026-10-18, second round). A sticky side
 * column holds a large framed portrait, the heading, name and title, memberships, the lead and "Randevu
 * Al"; beside it `.about-cv` lays every section out open, CV style (a label on the left, the content on
 * the right): who I am with the quote, why I do this work, the work areas as a tile grid, and education
 * and experience as a timeline, and the certificates ("Sertifikalarım") as cards. Phones keep the single centred column with its accordions
 * (`.about-main`); CSS shows one of the two.
 */
import PageShell from '../layouts/PageShell.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import Accordion from '../components/ui/Accordion.astro';
import TilePair from '../components/ui/TilePair.astro';
import ListItem from '../components/ui/ListItem.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import SunMark from '../components/brand/SunMark.astro';
import Wordmark from '../components/brand/Wordmark.astro';
import type { Lang } from '../lib/settings';
import { getAbout, getProfile } from '../lib/settings';
import { EMPTY_IMAGE, portraitImage } from '../lib/portrait-image';
import { pageMeta } from '../lib/seo';
import { profilePageLd } from '../lib/jsonld';
import { renderMarkdown } from '../lib/markdown';
import { pathFor } from '../i18n/routes';
import { bookPath } from '../lib/booking-entry';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const about = getAbout();
const profile = getProfile();
const { meta, alternatePaths } = pageMeta('about', lang, about.heading[lang], about.lead[lang]);

// Owner's review 2026-10-19: the title on its own line under the name.
const role = profile.title[lang].trim();
const memberships = (profile.memberships ?? []).map((m) => m.org[lang].trim()).filter(Boolean);
const lead = about.lead[lang].trim();
const who = about.whoAmI[lang].trim();
const why = about.whyThisWork[lang].trim();
const quote = about.quote[lang].trim();
const brand = about.brand[lang].trim();

type Tile = { title: string; icon: string };
const areas = about.areas.map((a) => ({ title: a.label[lang].trim(), icon: a.icon })).filter((a) => a.title);
const areaPairs: ([Tile] | [Tile, Tile])[] = [];
for (let i = 0; i < areas.length; i += 2) {
  areaPairs.push(areas[i + 1] ? [areas[i], areas[i + 1]] : [areas[i]]);
}
// The desktop CV portrait, about 320 px wide. Phones never fetch it (the <source> matches from 768 px
// and the <img> itself is an empty inline GIF); they keep the small round photo.
const cvPhoto = profile.photo ? await portraitImage(profile.photo, [320, 640]) : null;
const certificates = about.certificates
  .map((c) => ({ title: c.title[lang].trim(), issuer: c.issuer.trim(), year: c.year.trim(), url: c.url?.trim() ?? '' }))
  .filter((c) => c.title);
const certMeta = (c: (typeof certificates)[number]) => [c.issuer, c.year].filter(Boolean).join(' · ');
const jsonLd = [profilePageLd(lang, areas.map((a) => a.title))];
---

<PageShell lang={lang} meta={meta} jsonLd={jsonLd} alternatePaths={alternatePaths}>
  <div class="container-text inner-page about">
    <header class="about-top">
      <h1>{about.heading[lang]}</h1>
    </header>

    <div class="about-side">
      <div class="side-head">
        <div class="media">
          <RoundPortrait class={cvPhoto ? 'phone-only' : undefined} photo={profile.photo} alt={profile.photoAlt[lang]} size={96} eager />
          {
            cvPhoto && (
              <picture class="cv-photo">
                <source media="(min-width: 768px)" srcset={cvPhoto.srcset ?? cvPhoto.src} sizes="320px" />
                <img src={EMPTY_IMAGE} width={cvPhoto.width} height={cvPhoto.height} alt={profile.photoAlt[lang]} loading="eager" decoding="async" />
              </picture>
            )
          }
        </div>
        <p class="who-line">
          <span class="who-name">{profile.name}</span>
          {role && <span class="who-role">{role}</span>}
        </p>
        {
          memberships.map((org) => (
            <p class="tpd">
              <Icon name="shield" size={14} />
              {t(lang, 'memberOf').replace('{org}', org)}
            </p>
          ))
        }
        {lead && <p class="lead">{lead}</p>}
      </div>
      <a class="big-cta side-cta" href={bookPath(lang)}>
        <Icon name="calendar" size={18} />
        {t(lang, 'bookSession')}
      </a>
    </div>

    <div class="page-stack about-main">
      {
        (who || quote) && (
          <Accordion class="who" title={t(lang, 'whoAmI')} open>
            {who && <div class="md" set:html={renderMarkdown(who)} />}
            {quote && (
              <blockquote class="quote">
                <p>{quote}</p>
              </blockquote>
            )}
          </Accordion>
        )
      }

      {
        why && (
          <Accordion class="why" title={t(lang, 'whyThisWork')}>
            <div class="md" set:html={renderMarkdown(why)} />
          </Accordion>
        )
      }

      {
        brand && (
          <Accordion class="brand" title={t(lang, 'brandTitle')}>
            <div class="brand-logo" aria-hidden="true">
              <SunMark size={64} />
              <Wordmark height={30} decorative />
            </div>
            <div class="md" set:html={renderMarkdown(brand)} />
          </Accordion>
        )
      }

      {
        areaPairs.length > 0 && (
          <section class="areas" aria-labelledby="areas-title">
            <h2 id="areas-title" class="section-label">
              {t(lang, 'areasOfWork')}
            </h2>
            {areaPairs.map((pair) => (
              <TilePair tiles={pair} />
            ))}
          </section>
        )
      }

      {
        about.timeline.length > 0 && (
          <Accordion class="edu" title={t(lang, 'education')} subtitle={t(lang, 'timelineHint')}>
            <Timeline lang={lang} items={about.timeline} />
          </Accordion>
        )
      }

      {
        certificates.length > 0 && (
          <Accordion class="certs" title={t(lang, 'certificates')} subtitle={t(lang, 'certificatesHint')}>
            <ul class="cert-list">
              {certificates.map((c) => (
                <li class="cert">
                  <span class="cert-ic">
                    <Icon name="award" size={18} />
                  </span>
                  <span class="cert-text">
                    <b>{c.title}</b>
                    {certMeta(c) && <small>{certMeta(c)}</small>}
                    {c.url && (
                      <a href={c.url} target="_blank" rel="noopener noreferrer">
                        {t(lang, 'viewCertificate')}
                        <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>
                      </a>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </Accordion>
        )
      }

      <ListItem icon="chat" title={t(lang, 'contactMe')} subtitle={t(lang, 'contactMeHint')} href={pathFor('contact', lang)} />
    </div>

    <div class="about-cv">
      {
        (who || quote) && (
          <section class="cv-row" aria-labelledby="cv-who">
            <h2 id="cv-who" class="cv-label">{t(lang, 'whoAmI')}</h2>
            <div class="cv-body">
              {who && <div class="md md--cv" set:html={renderMarkdown(who)} />}
              {quote && (
                <blockquote class="quote quote--cv">
                  <p>{quote}</p>
                </blockquote>
              )}
            </div>
          </section>
        )
      }

      {
        why && (
          <section class="cv-row" aria-labelledby="cv-why">
            <h2 id="cv-why" class="cv-label">{t(lang, 'whyThisWork')}</h2>
            <div class="cv-body md md--cv" set:html={renderMarkdown(why)} />
          </section>
        )
      }

      {
        brand && (
          <section class="cv-row" aria-labelledby="cv-brand">
            <h2 id="cv-brand" class="cv-label">{t(lang, 'brandTitle')}</h2>
            <div class="cv-body">
              <div class="brand-logo brand-logo--cv" aria-hidden="true">
                <SunMark size={84} />
                <Wordmark height={40} decorative />
              </div>
              <div class="md md--cv" set:html={renderMarkdown(brand)} />
            </div>
          </section>
        )
      }

      {
        areas.length > 0 && (
          <section class="cv-row" aria-labelledby="cv-areas">
            <h2 id="cv-areas" class="cv-label">{t(lang, 'areasOfWork')}</h2>
            <ul class="cv-body cv-areas">
              {areas.map((a) => (
                <li>
                  <Icon name={a.icon} size={20} />
                  <span>{a.title}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        about.timeline.length > 0 && (
          <section class="cv-row" aria-labelledby="cv-edu">
            <h2 id="cv-edu" class="cv-label">{t(lang, 'education')}</h2>
            <div class="cv-body">
              <Timeline lang={lang} items={about.timeline} />
            </div>
          </section>
        )
      }

      {
        certificates.length > 0 && (
          <section class="cv-row" aria-labelledby="cv-certs">
            <h2 id="cv-certs" class="cv-label">{t(lang, 'certificates')}</h2>
            <ul class="cv-body cert-list cert-list--cv">
              {certificates.map((c) => (
                <li class="cert">
                  <span class="cert-ic">
                    <Icon name="award" size={20} />
                  </span>
                  <span class="cert-text">
                    <b>{c.title}</b>
                    {certMeta(c) && <small>{certMeta(c)}</small>}
                    {c.url && (
                      <a href={c.url} target="_blank" rel="noopener noreferrer">
                        {t(lang, 'viewCertificate')}
                        <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>
                      </a>
                    )}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="cv-row cv-row--end">
        <span class="cv-label" aria-hidden="true"></span>
        <ListItem class="cv-body" icon="chat" title={t(lang, 'contactMe')} subtitle={t(lang, 'contactMeHint')} href={pathFor('contact', lang)} />
      </div>
    </div>
  </div>
</PageShell>

<style>
  /* Phones: the side column is the centred head; its button stays hidden (the sticky bar books).
     The desktop CV and its framed portrait stay hidden too. */
  .side-cta,
  .about-cv,
  .cv-photo {
    display: none;
  }

  /* The page title, centred at the very top on every screen. */
  .about-top {
    text-align: center;
  }

  .about-top h1 {
    margin: 4px 0 var(--space-4);
    font-size: 1.875rem;
    font-variation-settings: 'SOFT' 100;
    line-height: 1.12;
  }

  /* Phones: photo, name and title, membership and the lead, centred under the title. */
  .side-head {
    text-align: center;
  }

  .side-head .media {
    display: flex;
    justify-content: center;
    margin-bottom: 8px;
  }

  .who-line {
    display: grid;
    gap: 2px;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .who-role {
    color: var(--link);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* The logo above the brand story: the sun beside the wordmark, in the text colour. */
  .brand-logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    color: var(--text);
  }

  .brand-logo :global(.wordmark) {
    width: auto;
  }

  .tpd {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin: 8px 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .side-head .lead {
    margin: 14px 6px 4px;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .cert-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cert {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .cert-ic {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sun-halo) 25%, transparent);
    color: var(--link);
  }

  .cert-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .cert-text small {
    color: var(--muted);
    font-size: var(--text-xs);
  }

  .cert-text a {
    font-size: var(--text-xs);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .about-top {
      grid-column: 1 / -1;
    }

    .about-top h1 {
      margin: 0 0 var(--space-3);
      font-size: var(--text-2xl);
    }

    .about {
      display: grid;
      grid-template-columns: minmax(220px, 320px) minmax(0, 46rem);
      justify-content: center;
      align-items: start;
      gap: clamp(2rem, 5vw, 4.5rem);
      max-width: calc(var(--max-wide) + 2 * var(--gutter));
    }

    /* Sticky only where the whole side column fits in the window; on short screens it scrolls. */
    @media (min-height: 700px) {
      .about-side {
        position: sticky;
        top: var(--space-5);
      }
    }

    .side-head {
      text-align: left;
    }

    .side-head .media {
      display: block;
      margin-bottom: var(--space-5);
    }

    .who-line {
      color: var(--text);
      font-family: var(--font-serif);
      font-size: var(--text-lg);
    }

    .side-head .lead {
      margin: var(--space-4) 0 0;
      color: var(--muted);
      font-size: var(--text-sm);
    }

    .tpd {
      display: flex;
    }

    .side-cta {
      display: flex;
      margin-top: var(--space-5);
    }

    /* The phone column and its small round photo give way to the CV and the framed portrait. */
    .about-main,
    .about-side :global(.phone-only) {
      display: none;
    }

    .cv-photo {
      display: block;
    }

    .cv-photo img {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-lg);
      background: var(--surface);
      box-shadow: var(--shadow-soft);
      object-fit: cover;
      object-position: center 20%;
    }

    .about-cv {
      display: flex;
      flex-direction: column;
    }

    /* One CV row: the label on the left, the content on the right, a hairline between rows. */
    .cv-row {
      display: grid;
      grid-template-columns: minmax(8rem, 11rem) minmax(0, 1fr);
      gap: var(--space-5);
      padding-block: var(--space-6);
      border-top: 1px solid var(--line);
    }

    .cv-row:first-child {
      padding-top: var(--space-2);
      border-top: 0;
    }

    .cv-row--end {
      padding-top: 0;
      border-top: 0;
    }

    .cv-label {
      margin: 0;
      color: var(--link);
      font-family: var(--font-sans);
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.06em;
      line-height: 1.8;
      text-transform: uppercase;
    }

    .md--cv {
      color: var(--text);
      font-size: var(--text-base);
      line-height: 1.7;
    }

    .quote--cv {
      margin-top: var(--space-5);
      background: var(--surface);
    }

    .cv-areas {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      gap: var(--space-3);
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .cv-areas li {
      display: flex;
      align-items: center;
      gap: var(--space-3);
      min-height: 56px;
      padding: var(--space-3) var(--space-4);
      border-radius: var(--radius-md);
      background: var(--surface);
      font-size: var(--text-sm);
      font-weight: 600;
    }

    .cert-list--cv {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
    }

    .cert-list--cv .cert {
      padding: var(--space-4);
      border-radius: var(--radius-md);
      background: var(--surface);
    }

    .cv-areas li :global(svg) {
      flex: none;
      color: var(--link);
    }
  }

  .areas {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Markdown output (about.json whoAmI / whyThisWork): paragraphs, lists, links. */
  .md {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .md :global(p),
  .md :global(ul),
  .md :global(ol) {
    margin: 0 0 var(--space-3);
  }

  .md > :global(:last-child) {
    margin-bottom: 0;
  }

  .quote {
    margin: var(--space-3) 0 0;
    padding: 12px 14px;
    border-left: 4px solid var(--quote-rule);
    border-radius: 0 12px 12px 0;
    background: var(--bg);
  }

  .quote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-style: italic;
    line-height: 1.45;
  }
</style>
