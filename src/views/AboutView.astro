---
/**
 * About, design B "Tanışma kartı ve sekmeler" (owner's choice 2026-10-22): an intro card (round portrait, the greeting,
 * name, title and memberships, the lead sentence, short facts, "Randevu Al"), then three tabs so only one part shows at a
 * time: "Hikayem" (the story, its first three paragraphs until "read on", beside a training summary), "Nasıl çalışırım"
 * (work areas, topics, approaches; why I do this work; the brand story) and "Eğitim ve kariyer" (the hours counters and
 * note, the career line, the education cards). A closing band books or opens the contact page.
 * Without JavaScript the tab row stays hidden and every panel shows, one after the other. Empty texts render nothing.
 */
import PageShell from '../layouts/PageShell.astro';
import { bookHref } from '../lib/booking-intake';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import Timeline from '../components/Timeline.astro';
import CareerTimeline from '../components/CareerTimeline.astro';
import EducationLedger from '../components/EducationLedger.astro';
import Icon from '../components/Icon.astro';
import SunMark from '../components/brand/SunMark.astro';
import Wordmark from '../components/brand/Wordmark.astro';
import type { Lang } from '../lib/settings';
import { getAbout, getProfile } from '../lib/settings';
import { educationTotals, formatNumber } from '../lib/education';
import { pageMeta } from '../lib/seo';
import { profilePageLd } from '../lib/jsonld';
import { renderMarkdown } from '../lib/markdown';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const about = getAbout();
const profile = getProfile();
const { meta, alternatePaths } = pageMeta('about', lang, about.heading[lang], about.lead[lang]);

const role = profile.title[lang].trim();
const memberships = (profile.memberships ?? []).map((m) => m.org[lang].trim()).filter(Boolean);
const lead = about.lead[lang].trim();
const who = about.whoAmI[lang].trim();
const why = about.whyThisWork[lang].trim();
const quote = about.quote[lang].trim();
const brand = about.brand[lang].trim();

// The greeting: plain text with *…* in italics (the name).
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const hello = escape(about.hello[lang].trim() || about.heading[lang]).replace(/\*([^*]+)\*/g, '<em>$1</em>');

const education = about.education && about.education.groups.length > 0 ? about.education : null;
const totals = educationTotals(education ?? undefined);
const facts = about.facts
  .map((f) => ({
    value: f.value[lang].trim().replace('{hours}', `${formatNumber(totals.theory, lang)}+`),
    label: f.label[lang].trim(),
  }))
  .filter((f) => f.value && !(f.value.startsWith('0+') && !education));

const areas = about.areas.map((a) => ({ title: a.label[lang].trim(), icon: a.icon, desc: a.desc?.[lang].trim() ?? '' })).filter((a) => a.title);
const topics = about.topics.map((x) => x[lang].trim()).filter(Boolean);
// "Nasıl Çalışırım" as coloured cards (owner's choice A, 2026-10-23): each card takes the next of the
// six tones; an approach shows its short name ("BDT", "ACT") in its tile, or a leaf when it has none.
const TONES = ['lavanta', 'adacayi', 'kiremit', 'deniz', 'gunes', 'lacivert'] as const;
const toneAt = (i: number) => TONES[i % TONES.length];
const approaches = about.approaches
  .map((x) => x[lang].trim())
  .filter(Boolean)
  .map((text) => {
    const m = text.match(/^(.*?)\s*\(([^)]+)\)\s*$/);
    const inner = m?.[2].trim() ?? text;
    const abbr = /^[A-ZÇĞİÖŞÜ]{2,5}$/.test(inner) ? inner : '';
    // "Bilinçli Farkındalık (Mindfulness)": the word in brackets becomes the small line.
    return { title: m ? m[1] : text, sub: m && !abbr ? inner : '', abbr };
  });
const career = about.career;
const certificates = about.certificates
  .map((c) => ({ title: c.title[lang].trim(), issuer: c.issuer.trim(), year: c.year.trim(), url: c.url?.trim() ?? '' }))
  .filter((c) => c.title);

const hasHow = areas.length > 0 || topics.length > 0 || approaches.length > 0 || !!why || !!brand;
const hasEdu = !!education || career.length > 0 || about.timeline.length > 0 || certificates.length > 0;
const tabs = [
  { id: 'story', label: t(lang, 'tabStory'), show: !!(who || quote) },
  { id: 'how', label: t(lang, 'tabHow'), show: hasHow },
  { id: 'education', label: t(lang, 'tabEducation'), show: hasEdu },
].filter((x) => x.show);
const summary = t(lang, 'trainingSummary').replace('{p}', formatNumber(totals.practice, lang) + '+');
const jsonLd = [profilePageLd(lang, areas.map((a) => a.title))];
---

<PageShell lang={lang} meta={meta} jsonLd={jsonLd} alternatePaths={alternatePaths}>
  <div class="container inner-page about">
    <section class="about-intro" aria-labelledby="about-hello">
      <div class="intro-photo">
        <span class="intro-sun" aria-hidden="true"><SunMark size={64} /></span>
        <RoundPortrait photo={profile.photo} alt={profile.photoAlt[lang]} size={184} desktopSize={300} eager />
      </div>
      <div class="intro-text">
        <p class="kicker">{about.heading[lang]}</p>
        <h1 id="about-hello" class="hello" set:html={hello} />
        <p class="who-line">
          <span class="who-name">{profile.name}</span>
          {role && <span class="who-role">{role}</span>}
          {memberships.map((org) => <span class="tpd">{t(lang, 'memberOf').replace('{org}', org)}</span>)}
        </p>
        {lead && <p class="lead">{lead}</p>}
        {
          facts.length > 0 && (
            <ul class="facts">
              {facts.map((f) => (
                <li>
                  <b>{f.value}</b> {f.label}
                </li>
              ))}
            </ul>
          )
        }
        <div class="intro-actions">
          <a class="big-cta intro-cta" href={bookHref(lang)}>
            <Icon name="calendar" size={18} />
            {t(lang, 'bookSession')}
          </a>
          <span class="intro-wordmark"><Wordmark height={28} decorative /></span>
        </div>
      </div>
    </section>

    {
      tabs.length > 1 && (
        <div class="about-tabs" hidden>
          <div class="tab-row" role="tablist" aria-label={t(lang, 'aboutTabs')}>
            {tabs.map((tab, i) => (
              <button
                type="button"
                class="tab"
                role="tab"
                id={`tab-${tab.id}`}
                aria-controls={`panel-${tab.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-tab={tab.id}
              >
                {tab.label}
              </button>
            ))}
          </div>
        </div>
      )
    }

    {
      (who || quote) && (
        <section class="about-panel" id="panel-story" role="tabpanel" aria-labelledby="tab-story" data-panel="story">
          <h2 class="visually-hidden">{t(lang, 'whoAmI')}</h2>
          <div class="story-grid">
            <div class="story">
              {who && <div class="md md--story" set:html={renderMarkdown(who)} />}
              {quote && (
                <blockquote class="quote">
                  <p>{quote}</p>
                </blockquote>
              )}
              <button type="button" class="read-more" hidden>
                {t(lang, 'readStory')}
              </button>
            </div>
            {(education || areas.length > 0 || topics.length > 0) && (
              <aside class="story-side">
                {education && (
                  <div class="side-card">
                    <p class="side-label">{t(lang, 'trainingShort')}</p>
                    <p class="side-big">
                      {formatNumber(totals.theory, lang)}+ {t(lang, 'hoursUnit')}
                    </p>
                    <p class="side-text">{summary}</p>
                    <a class="side-link" href="#panel-education" data-go="education">
                      {t(lang, 'tabEducation')}
                      <Icon name="arrow" size={16} />
                    </a>
                  </div>
                )}
                {areas.length > 0 && (
                  <div class="side-card">
                    <p class="side-label">{t(lang, 'areasOfWork')}</p>
                    <ul class="side-list">
                      {areas.map((a) => (
                        <li>
                          <Icon name={a.icon} size={16} />
                          {a.title}
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                {topics.length > 0 && (
                  <div class="side-card">
                    <p class="side-label">{t(lang, 'topics')}</p>
                    <ul class="chips chips--side">
                      {topics.map((x) => (
                        <li>{x}</li>
                      ))}
                    </ul>
                    <a class="side-link" href="#panel-how" data-go="how">
                      {t(lang, 'tabHow')}
                      <Icon name="arrow" size={16} />
                    </a>
                  </div>
                )}
              </aside>
            )}
          </div>
        </section>
      )
    }

    {
      hasHow && (
        <section class="about-panel" id="panel-how" role="tabpanel" aria-labelledby="tab-how" data-panel="how">
          <h2 class="panel-title">{t(lang, 'tabHow')}</h2>
          {(areas.length > 0 || topics.length > 0 || approaches.length > 0) && (
            <div class="how-groups">
              {areas.length > 0 && (
                <div>
                  <h3 class="how-title">{t(lang, 'areasOfWork')}</h3>
                  <ul class="area-cards">
                    {areas.map((a, i) => (
                      <li class={`tone-${toneAt(i)}`}>
                        <span class="how-tile" aria-hidden="true"><Icon name={a.icon} size={22} /></span>
                        <b>{a.title}</b>
                        {a.desc && <small>{a.desc}</small>}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {approaches.length > 0 && (
                <div>
                  <h3 class="how-title">{t(lang, 'approaches')}</h3>
                  <ul class="appr-cards">
                    {approaches.map((x, i) => (
                      <li class={`tone-${toneAt(i)}`}>
                        <span class="appr-abbr" aria-hidden="true">{x.abbr || <Icon name="leaf" size={24} />}</span>
                        <span class="appr-text">
                          <b>{x.title}</b>
                          {x.abbr ? x.abbr !== x.title && <small>{x.abbr}</small> : x.sub && <small>{x.sub}</small>}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {topics.length > 0 && (
                <div>
                  <h3 class="how-title">{t(lang, 'topics')}</h3>
                  <ul class="chips topic-chips">
                    {topics.map((x, i) => (
                      <li class={`tone-${toneAt(i)}`}>{x}</li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          )}
          {(why || brand) && (
            <div class="why-brand">
              {why && (
                <div>
                  <h3 class="sub-title">{t(lang, 'whyThisWork')}</h3>
                  <div class="md" set:html={renderMarkdown(why)} />
                </div>
              )}
              {brand && (
                <div>
                  <div class="brand-logo" aria-hidden="true">
                    <SunMark size={44} />
                    <Wordmark height={24} decorative />
                  </div>
                  <h3 class="sub-title">{t(lang, 'brandTitle')}</h3>
                  <div class="md" set:html={renderMarkdown(brand)} />
                </div>
              )}
            </div>
          )}
        </section>
      )
    }

    {
      hasEdu && (
        <section class="about-panel" id="panel-education" role="tabpanel" aria-labelledby="tab-education" data-panel="education">
          <h2 class="panel-title">{t(lang, 'tabEducation')}</h2>
          {education && <EducationLedger lang={lang} education={education} part="summary" />}
          <div class="edu-grid">
            {(career.length > 0 || about.timeline.length > 0) && (
              <div>
                <h3 class="sub-title">{t(lang, career.length > 0 ? 'career' : 'education')}</h3>
                {career.length > 0 ? <CareerTimeline lang={lang} items={career} /> : <Timeline lang={lang} items={about.timeline} />}
              </div>
            )}
            {education ? (
              <div>
                <h3 class="sub-title">{t(lang, 'educationCerts')}</h3>
                <EducationLedger lang={lang} education={education} part="groups" />
              </div>
            ) : (
              certificates.length > 0 && (
                <div>
                  <h3 class="sub-title">{t(lang, 'certificates')}</h3>
                  <ul class="cert-list">
                    {certificates.map((c) => (
                      <li>
                        <b>{c.title}</b>
                        <small>{[c.issuer, c.year].filter(Boolean).join(' · ')}</small>
                        {c.url && (
                          <a href={c.url} target="_blank" rel="noopener noreferrer">
                            {t(lang, 'viewCertificate')}
                            <span class="visually-hidden">{t(lang, 'opensInNewTab')}</span>
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              )
            )}
          </div>
        </section>
      )
    }

    <section class="about-cta">
      <p class="cta-title">{t(lang, 'aboutCta')}</p>
      <div class="cta-actions">
        <a class="cta-book" href={bookHref(lang)}>
          <Icon name="calendar" size={18} />
          {t(lang, 'bookSession')}
        </a>
        <a class="cta-contact" href={pathFor('contact', lang)}>{t(lang, 'contactMe')}</a>
      </div>
    </section>
  </div>
</PageShell>

<script>
  // Tabs: only one panel shows at a time; arrow keys move between tabs; #panel-… links open their tab.
  const root = document.querySelector<HTMLElement>('.about');
  const bar = root?.querySelector<HTMLElement>('.about-tabs');
  if (root && bar) {
    const tabs = [...bar.querySelectorAll<HTMLButtonElement>('.tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.about-panel')];
    const show = (id: string, focus = false, scroll = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((p) => (p.hidden = p.dataset.panel !== id));
      if (scroll) bar.scrollIntoView({ block: 'start' });
    };
    bar.hidden = false;
    const fromHash = location.hash.replace('#panel-', '');
    show(tabs.some((x) => x.dataset.tab === fromHash) ? fromHash : (tabs[0]?.dataset.tab ?? ''));
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab.dataset.tab ?? ''));
      tab.addEventListener('keydown', (e) => {
        const step = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!step) return;
        e.preventDefault();
        show(tabs[(i + step + tabs.length) % tabs.length].dataset.tab ?? '', true);
      });
    });
    root.querySelectorAll<HTMLElement>('[data-go]').forEach((link) =>
      link.addEventListener('click', (e) => {
        e.preventDefault();
        show(link.dataset.go ?? '', false, true);
      }),
    );
  }

  // The story: the first three paragraphs, then "read on" (without JavaScript the whole story shows).
  const story = document.querySelector<HTMLElement>('.about .story');
  const more = story?.querySelector<HTMLButtonElement>('.read-more');
  if (story && more && story.querySelectorAll('.md--story > *').length > 3) {
    story.classList.add('clamped');
    more.hidden = false;
    more.addEventListener('click', () => {
      story.classList.remove('clamped');
      more.hidden = true;
    });
  }
</script>

<style>
  /* Intro card: centred on phones; photo beside the text from 768 px. */
  .about-intro {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-6);
    text-align: center;
  }

  .intro-photo {
    position: relative;
  }

  /* The brand sun behind the photo, peeking out at its top right corner. */
  .intro-sun {
    position: absolute;
    z-index: 0;
    top: -22px;
    right: -26px;
    display: flex;
  }

  .intro-sun :global(.sun-mark) {
    width: 84px;
    height: 84px;
  }

  .intro-photo :global(.portrait) {
    position: relative;
    z-index: 1;
    border: 5px solid var(--bg);
    box-shadow: var(--shadow-soft);
  }

  .kicker {
    margin: 0;
    color: var(--tone-gunes);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hello {
    margin: 4px 0 var(--space-3);
    font-size: clamp(2.125rem, 1.5rem + 2.6vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.05;
  }

  .hello :global(em) {
    color: var(--tone-gunes);
    font-weight: 400;
  }

  .who-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2px 10px;
    margin: 0 0 var(--space-3);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .who-name {
    color: var(--text);
    font-weight: 700;
  }

  .who-role {
    color: var(--link);
    font-weight: 600;
  }

  .lead {
    max-width: 36rem;
    margin: 0 auto var(--space-4);
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    line-height: 1.5;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    background: var(--surface);
    font-size: var(--text-sm);
  }

  .facts b {
    color: var(--link);
    font-family: var(--font-serif);
  }

  /* Phones book from the sticky bar; the card's own button shows from 768 px. The wordmark sits beside it. */
  .intro-cta {
    display: none;
  }

  .intro-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-3) var(--space-5);
    margin-top: var(--space-4);
  }

  .intro-wordmark {
    display: flex;
    color: var(--text);
  }

  .intro-wordmark :global(.wordmark) {
    width: auto;
  }

  /* Tabs: a sticky row under the intro card. */
  .about-tabs {
    position: sticky;
    top: 0;
    z-index: 5;
    margin: 0 calc(-1 * var(--gutter));
    padding: 0 var(--gutter);
    border-bottom: 1px solid var(--line);
    background: color-mix(in srgb, var(--bg) 94%, transparent);
    backdrop-filter: blur(6px);
  }

  .tab-row {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab {
    flex: none;
    min-height: 48px;
    padding: 0 14px;
    border: 0;
    border-bottom: 3px solid transparent;
    background: none;
    color: var(--muted);
    font: inherit;
    font-size: var(--text-sm);
    white-space: nowrap;
    cursor: pointer;
  }

  .tab[aria-selected='true'] {
    border-bottom-color: var(--sun-disc);
    color: var(--text);
    font-weight: 700;
  }

  .tab:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: -2px;
  }

  .about-panel {
    padding: var(--space-6) 0;
  }

  .about-panel + .about-panel {
    border-top: 1px solid var(--line);
  }

  .panel-title {
    margin: 0 0 var(--space-5);
    font-size: 1.75rem;
    line-height: 1.15;
  }

  .sub-title {
    margin: 0 0 var(--space-3);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
  }

  /* Story */
  .story-grid {
    display: grid;
    gap: var(--space-6);
  }

  .md {
    color: var(--muted);
    font-size: var(--text-base);
    line-height: 1.7;
  }

  .md :global(p) {
    margin: 0 0 var(--space-4);
  }

  .md > :global(:last-child) {
    margin-bottom: 0;
  }

  .md--story {
    color: var(--text);
  }

  .md--story > :global(p:first-child::first-letter) {
    float: left;
    padding: 6px 8px 0 0;
    color: var(--link);
    font-family: var(--font-serif);
    font-size: 3.6rem;
    font-weight: 600;
    line-height: 0.85;
  }

  .md--story > :global(p:last-child) {
    font-family: var(--font-serif);
    font-size: 1.375rem;
  }

  .story.clamped .md--story > :global(:nth-child(n + 4)) {
    display: none;
  }

  .read-more {
    margin-top: var(--space-2);
    padding: 8px 18px;
    border: 1.5px solid var(--link);
    border-radius: var(--radius-btn);
    background: none;
    color: var(--link);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    cursor: pointer;
  }

  .quote {
    margin: var(--space-5) 0 0;
    padding-left: var(--space-4);
    border-left: 3px solid var(--sun-disc);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
  }

  .side-card {
    padding: var(--space-4) var(--space-5);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .side-label {
    margin: 0 0 4px;
    color: var(--muted);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .side-big {
    margin: 0;
    color: var(--link);
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.15;
  }

  .side-text {
    margin: 4px 0 var(--space-2);
    font-size: var(--text-sm);
  }

  /* Owner's review 2026-10-23, item 8: the way to the next tab sits on a line of its own at the foot
     of the card, as a small button, not glued to the text above it. */
  .side-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: var(--space-3);
    padding: 10px 14px;
    border-radius: var(--radius-md);
    background: var(--bg);
    color: var(--text);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .side-link :global(svg) {
    flex: none;
    color: var(--link);
    transition: transform 0.15s ease;
  }

  .side-link:hover {
    color: var(--text);
    background: color-mix(in srgb, var(--sun-halo) 22%, var(--bg));
  }

  .side-link:hover :global(svg) {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .side-link :global(svg) {
      transition: none;
    }
  }

  .story-side {
    display: grid;
    gap: var(--space-3);
  }

  .side-list {
    display: grid;
    gap: 6px;
    margin: var(--space-2) 0 0;
