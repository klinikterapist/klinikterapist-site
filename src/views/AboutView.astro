---
/**
 * About (spec §5.9): photo (or the sun), "Hakkımda", name and title, membership, the lead sentence;
 * accordions "Ben kimim?" (open), "Bu işi neden yapıyorum?", the work areas as tile pairs,
 * "Eğitim ve deneyim" (timeline) and a row to the contact page. Empty texts render nothing.
 * Desktop (from 768 px, owner's review 2026-10-18): two columns. A sticky side column holds the larger
 * portrait, name and title, memberships, the lead and "Randevu Al"; the other column holds the biography
 * and the remaining sections at a reading width. Phones keep the single centred column.
 */
import PageShell from '../layouts/PageShell.astro';
import PageHead from '../components/ui/PageHead.astro';
import RoundPortrait from '../components/ui/RoundPortrait.astro';
import Accordion from '../components/ui/Accordion.astro';
import TilePair from '../components/ui/TilePair.astro';
import ListItem from '../components/ui/ListItem.astro';
import Timeline from '../components/Timeline.astro';
import Icon from '../components/Icon.astro';
import type { Lang } from '../lib/settings';
import { getAbout, getProfile } from '../lib/settings';
import { pageMeta } from '../lib/seo';
import { renderMarkdown } from '../lib/markdown';
import { pathFor } from '../i18n/routes';
import { t } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const about = getAbout();
const profile = getProfile();
const { meta, alternatePaths } = pageMeta('about', lang, about.heading[lang], about.lead[lang]);

const whoLine = [profile.name, profile.title[lang].trim()].filter(Boolean).join(' · ');
const memberships = (profile.memberships ?? []).map((m) => m.org[lang].trim()).filter(Boolean);
const lead = about.lead[lang].trim();
const who = about.whoAmI[lang].trim();
const why = about.whyThisWork[lang].trim();
const quote = about.quote[lang].trim();

type Tile = { title: string; icon: string };
const areas = about.areas.map((a) => ({ title: a.label[lang].trim(), icon: a.icon })).filter((a) => a.title);
const areaPairs: ([Tile] | [Tile, Tile])[] = [];
for (let i = 0; i < areas.length; i += 2) {
  areaPairs.push(areas[i + 1] ? [areas[i], areas[i + 1]] : [areas[i]]);
}
---

<PageShell lang={lang} meta={meta} alternatePaths={alternatePaths}>
  <div class="container-text inner-page about">
    <div class="about-side">
      <PageHead title={about.heading[lang]}>
        <RoundPortrait slot="media" photo={profile.photo} alt={profile.photoAlt[lang]} size={96} desktopSize={200} eager />
        <p class="who-line">{whoLine}</p>
        {
          memberships.map((org) => (
            <p class="tpd">
              <Icon name="shield" size={14} />
              {t(lang, 'memberOf').replace('{org}', org)}
            </p>
          ))
        }
        {lead && <p class="lead">{lead}</p>}
      </PageHead>
      <a class="big-cta side-cta" href={pathFor('appointment', lang)}>
        <Icon name="calendar" size={18} />
        {t(lang, 'bookSession')}
      </a>
    </div>

    <div class="page-stack about-main">
      {
        (who || quote) && (
          <Accordion class="who" title={t(lang, 'whoAmI')} open>
            {who && <div class="md" set:html={renderMarkdown(who)} />}
            {quote && (
              <blockquote class="quote">
                <p>{quote}</p>
              </blockquote>
            )}
          </Accordion>
        )
      }

      {
        why && (
          <Accordion class="why" title={t(lang, 'whyThisWork')}>
            <div class="md" set:html={renderMarkdown(why)} />
          </Accordion>
        )
      }

      {
        areaPairs.length > 0 && (
          <section class="areas" aria-labelledby="areas-title">
            <h2 id="areas-title" class="section-label">
              {t(lang, 'areasOfWork')}
            </h2>
            {areaPairs.map((pair) => (
              <TilePair tiles={pair} />
            ))}
          </section>
        )
      }

      {
        about.timeline.length > 0 && (
          <Accordion class="edu" title={t(lang, 'education')} subtitle={t(lang, 'timelineHint')}>
            <Timeline lang={lang} items={about.timeline} />
          </Accordion>
        )
      }

      <ListItem icon="chat" title={t(lang, 'contactMe')} subtitle={t(lang, 'contactMeHint')} href={pathFor('contact', lang)} />
    </div>
  </div>
</PageShell>

<style>
  /* Phones: the side column is the centred head; its button stays hidden (the sticky bar books). */
  .side-cta {
    display: none;
  }

  @media (min-width: 768px) {
    .about {
      display: grid;
      grid-template-columns: minmax(200px, 280px) minmax(0, 40rem);
      justify-content: center;
      align-items: start;
      gap: clamp(2rem, 5vw, 4.5rem);
      max-width: calc(var(--max-wide) + 2 * var(--gutter));
    }

    /* Sticky only where the whole side column fits in the window; on short screens it scrolls. */
    @media (min-height: 700px) {
      .about-side {
        position: sticky;
        top: var(--space-5);
      }
    }

    .about-side :global(.page-head) {
      text-align: left;
    }

    .about-side :global(.page-head .media) {
      justify-content: flex-start;
      margin-bottom: var(--space-4);
    }

    .about-side :global(.page-head .lead) {
      margin: var(--space-4) 0 0;
      color: var(--muted);
      font-size: var(--text-sm);
    }

    .about-side :global(.page-head .tpd) {
      display: flex;
    }

    .side-cta {
      display: flex;
      margin-top: var(--space-5);
    }

    .about-main {
      margin-top: 0;
    }
  }

  .areas {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* Markdown output (about.json whoAmI / whyThisWork): paragraphs, lists, links. */
  .md {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.55;
  }

  .md :global(p),
  .md :global(ul),
  .md :global(ol) {
    margin: 0 0 var(--space-3);
  }

  .md > :global(:last-child) {
    margin-bottom: 0;
  }

  .quote {
    margin: var(--space-3) 0 0;
    padding: 12px 14px;
    border-left: 4px solid var(--quote-rule);
    border-radius: 0 12px 12px 0;
    background: var(--bg);
  }

  .quote p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-style: italic;
    line-height: 1.45;
  }
</style>
