---
import '../styles/global.css';
import type { Lang } from '../lib/settings';
import type { Meta } from '../lib/seo';
import { t } from '../i18n/ui';
import ThemeScript from '../components/ThemeScript.astro';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Counter from '../components/Counter.astro';
import { COUNTER_ENABLED } from '../lib/site';
import { getSeo, injectionFits } from '../lib/settings';
import { pathFor } from '../i18n/routes';
import Analytics from '../components/Analytics.astro';
import FontPreload from '../components/FontPreload.astro';

interface Props {
  lang: Lang;
  meta: Meta;
  jsonLd?: object[];
  alternatePaths: { tr: string; en: string };
  /** Keep the page out of search results (404). */
  noindex?: boolean;
  /**
   * A page whose visit says something about someone's health (the client's own page, the booking
   * and intro-call pages; owner's decision 2026-10-20): no Google Analytics, so Google never learns
   * that this browser looked for or is in therapy. The site's own cookieless counter stays where the
   * page is indexed.
   */
  noAnalytics?: boolean;
}
const { lang, meta, jsonLd, alternatePaths, noindex: pageNoindex = false, noAnalytics = false } = Astro.props;
// Gizlilik ve Analitik (owner's review 2026-10-21): search engines, the counter and added code.
const seo = getSeo();
const path = Astro.url.pathname;
const hiddenPage = (seo.noindexPages ?? []).some((k) => pathFor(k, lang) === path);
const noindex = pageNoindex || !!seo.noindex || hiddenPage;
const counterOn = COUNTER_ENABLED && seo.counter !== false;
const code = (where: 'head' | 'body') => (seo.inject ?? []).filter((c) => c.enabled && c.where === where && c.code.trim() && injectionFits(c.pages, path));
---

<!doctype html>
<html lang={lang}>
  <head>
    <ThemeScript />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FBF3E4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F2E4A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="Klinik Terapist" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <FontPreload />
    <Seo meta={meta} jsonLd={jsonLd} />
    <slot name="head" />
    {code('head').map((c) => <Fragment set:html={c.code} />)}
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
    <Header lang={lang} alternatePaths={alternatePaths} />
    <slot name="top" />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    {counterOn && !pageNoindex && <Counter />}
    {!noAnalytics && <Analytics lang={lang} />}
    {code('body').map((c) => <Fragment set:html={c.code} />)}
  </body>
</html>
