---
import '../styles/global.css';
import type { Lang } from '../lib/settings';
import type { Meta } from '../lib/seo';
import { t } from '../i18n/ui';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  lang: Lang;
  meta: Meta;
  jsonLd?: object[];
  alternatePaths: { tr: string; en: string };
  /** Keep the page out of search results (404). */
  noindex?: boolean;
}
const { lang, meta, jsonLd, alternatePaths, noindex = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FBF3E4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1F2E4A" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    <Seo meta={meta} jsonLd={jsonLd} />
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{t(lang, 'skipToContent')}</a>
    <Header lang={lang} alternatePaths={alternatePaths} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
